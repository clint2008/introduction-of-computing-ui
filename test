<!-- ==================================================
     IT HELP DESK JAVASCRIPT
================================================== -->

<script>


// ==========================================
// SEND MESSAGE
// ==========================================

function sendMessage() {

    const input =
        document.getElementById("userInput");

    const chatBox =
        document.getElementById("chatBox");


    const message =
        input.value.trim();


    // Do nothing if empty

    if (message === "") {

        return;

    }


    // Show user's message

    chatBox.innerHTML += `

        <div class="chat-user">

            <strong>You:</strong>

            <br>

            ${message}

        </div>

    `;


    // Get AI response

    const answer =
        getAIResponse(message);


    // Show AI response

    chatBox.innerHTML += `

        <div class="chat-ai">

            <strong>
                <i class="bi bi-robot"></i>
                IT Assistant:
            </strong>

            <br><br>

            ${answer}

        </div>

    `;


    // Clear input

    input.value = "";


    // Scroll to newest message

    chatBox.scrollTop =
        chatBox.scrollHeight;

}



// ==========================================
// AI RESPONSE
// ==========================================

function getAIResponse(message) {

    const text =
        message.toLowerCase();



    // ======================================
    // INTERNET
    // ======================================

    if (
        text.includes("internet") ||
        text.includes("wifi") ||
        text.includes("wi-fi") ||
        text.includes("connection") ||
        text.includes("online")
    ) {

        return `

        <p>
            It looks like you may have an
            internet connection problem.
        </p>

        <p>
            Try these steps:
        </p>

        <ol>

            <li>
                Check if Wi-Fi is turned on.
            </li>

            <li>
                Disconnect and reconnect
                to the Wi-Fi.
            </li>

            <li>
                Check if another device
                can connect.
            </li>

            <li>
                Restart the router if
                you have access to it.
            </li>

            <li>
                Try opening another website.
            </li>

        </ol>

        <p>
            If the problem continues,
            contact IT support.
        </p>

        `;

    }



    // ======================================
    // COMPUTER
    // ======================================

    if (
        text.includes("computer") ||
        text.includes("laptop") ||
        text.includes("slow") ||
        text.includes("freeze") ||
        text.includes("freezing")
    ) {

        return `

        <p>
            Your computer may be experiencing
            a performance problem.
        </p>

        <p>
            Try these steps:
        </p>

        <ol>

            <li>
                Close programs you are not using.
            </li>

            <li>
                Restart your computer.
            </li>

            <li>
                Check available storage space.
            </li>

            <li>
                Check for system updates.
            </li>

            <li>
                Try opening the program again.
            </li>

        </ol>

        `;

    }



    // ======================================
    // PRINTER
    // ======================================

    if (
        text.includes("printer") ||
        text.includes("print") ||
        text.includes("printing")
    ) {

        return `

        <p>
            It looks like you have a printer problem.
        </p>

        <p>
            Try these steps:
        </p>

        <ol>

            <li>
                Make sure the printer is turned on.
            </li>

            <li>
                Check if there is paper.
            </li>

            <li>
                Check the printer connection.
            </li>

            <li>
                Make sure the correct printer
                is selected.
            </li>

            <li>
                Try printing again.
            </li>

        </ol>

        `;

    }



    // ======================================
    // SOFTWARE
    // ======================================

    if (
        text.includes("software") ||
        text.includes("application") ||
        text.includes("app") ||
        text.includes("program") ||
        text.includes("error") ||
        text.includes("not opening")
    ) {

        return `

        <p>
            It looks like you may have a
            software or application problem.
        </p>

        <p>
            Try these steps:
        </p>

        <ol>

            <li>
                Close and reopen the application.
            </li>

            <li>
                Restart your computer.
            </li>

            <li>
                Check if the application
                has an update.
            </li>

            <li>
                Check your internet connection
                if the application requires internet.
            </li>

        </ol>

        `;

    }



    // ======================================
    // PASSWORD / LOGIN
    // ======================================

    if (
        text.includes("password") ||
        text.includes("login") ||
        text.includes("log in") ||
        text.includes("account")
    ) {

        return `

        <p>
            If you are having a login problem,
            try these steps:
        </p>

        <ol>

            <li>
                Check that your username
                is correct.
            </li>

            <li>
                Check that your password
                is entered correctly.
            </li>

            <li>
                Check your internet connection.
            </li>

        </ol>

        <p>
            If you still cannot access your
            account, contact your authorized
            IT support.
        </p>

        `;

    }



    // ======================================
    // GREETING
    // ======================================

    if (
        text.includes("hello") ||
        text.includes("hi") ||
        text.includes("hey")
    ) {

        return `

        Hello! I'm your IT Help Desk Assistant.

        <br><br>

        I can help with common problems
        involving:

        <ul>

            <li>Internet</li>
            <li>Computer</li>
            <li>Software</li>
            <li>Printer</li>
            <li>Login problems</li>

        </ul>

        Please describe your problem.

        `;

    }



    // ======================================
    // DEFAULT RESPONSE
    // ======================================

    return `

        <p>
            I want to help with your technical problem.
        </p>

        <p>
            Currently, I can provide basic guidance
            for:
        </p>

        <ul>

            <li>
                Internet connection problems
            </li>

            <li>
                Computer performance problems
            </li>

            <li>
                Software errors
            </li>

            <li>
                Printer problems
            </li>

            <li>
                Basic login problems
            </li>

        </ul>

        <p>
            Please describe your technical
            problem in more detail.
        </p>

    `;

}



// ==========================================
// QUICK PROBLEM BUTTONS
// ==========================================

function askProblem(problem) {

    const input =
        document.getElementById("userInput");


    if (problem === "internet") {

        input.value =
            "My internet is not working.";

    }

    else if (problem === "computer") {

        input.value =
            "My computer is very slow.";

    }

    else if (problem === "software") {

        input.value =
            "My software is showing an error.";

    }

    else if (problem === "printer") {

        input.value =
            "My printer is not printing.";

    }


    // Scroll to chat

    document
        .getElementById("help")
        .scrollIntoView({
            behavior: "smooth"
        });


    input.focus();

}



// ==========================================
// PRESS ENTER TO SEND
// ==========================================

document
    .getElementById("userInput")
    .addEventListener("keypress", function(event) {

        if (event.key === "Enter") {

            sendMessage();

        }

    });



// ==========================================
// CONTACT FORM
// ==========================================

document
    .getElementById("contactForm")
    .addEventListener("submit", function(event) {

        event.preventDefault();

        alert(
            "Your IT support concern has been submitted."
        );

        this.reset();

    });


</script>


