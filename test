/* =====================================================
   LANGUAGE DETECTION
===================================================== */

function detectLanguage(text) {

    const lower =
        text.toLowerCase();

    const bisayaWords = [
        "unsa",
        "ngano",
        "pila",
        "asa",
        "ako",
        "ikaw",
        "dili",
        "wala",
        "naa",
        "pwede",
        "tabang",
        "salamat",
        "gusto",
        "kanang",
        "unsaon",
        "sige",
        "man",
        "lagi",
        "japon"
    ];

    const tagalogWords = [
        "ano",
        "bakit",
        "saan",
        "paano",
        "magkano",
        "ako",
        "ikaw",
        "hindi",
        "wala",
        "may",
        "pwede",
        "tulong",
        "salamat",
        "gusto",
        "paano",
        "kailangan",
        "naman"
    ];

    let bisayaScore = 0;
    let tagalogScore = 0;

    bisayaWords.forEach(word => {

        if (lower.includes(word)) {

            bisayaScore++;

        }

    });

    tagalogWords.forEach(word => {

        if (lower.includes(word)) {

            tagalogScore++;

        }

    });

    if (
        bisayaScore > 0 &&
        tagalogScore > 0
    ) {

        return "mixed";

    }

    if (bisayaScore > tagalogScore) {

        return "bisaya";

    }

    if (tagalogScore > bisayaScore) {

        return "tagalog";

    }

    return "english";

}


/* =====================================================
   QUESTION TYPE
===================================================== */

function detectQuestionType(text) {

    const lower =
        text.toLowerCase();

    if (
        /^(hi|hello|hey|good morning|good afternoon|good evening|yo|kumusta|kamusta|hi there)/i.test(lower)
    ) {

        return "greeting";

    }

    if (
        lower.includes("thank") ||
        lower.includes("salamat")
    ) {

        return "thanks";

    }

    if (
        lower.includes("what is") ||
        lower.includes("what are") ||
        lower.includes("define") ||
        lower.includes("meaning of") ||
        lower.includes("unsa ang") ||
        lower.includes("unsa na") ||
        lower.includes("ano ang")
    ) {

        return "definition";

    }

    if (
        lower.includes("how to") ||
        lower.includes("how do i") ||
        lower.includes("paano") ||
        lower.includes("unsaon")
    ) {

        return "howto";

    }

    if (
        lower.includes("help") ||
        lower.includes("problem") ||
        lower.includes("error") ||
        lower.includes("not working") ||
        lower.includes("dili") ||
        lower.includes("wala")
    ) {

        return "troubleshooting";

    }

    return "general";

}


/* =====================================================
   IT TOPIC DETECTION
===================================================== */

function detectITTopic(text) {

    const lower =
        text.toLowerCase();

    /* Wi-Fi */

    if (
        lower.includes("wifi") ||
        lower.includes("wi-fi") ||
        lower.includes("internet") ||
        lower.includes("connection") ||
        lower.includes("connect")
    ) {

        return "wifi";

    }

    /* Slow Computer */

    if (
        lower.includes("slow computer") ||
        lower.includes("computer slow") ||
        lower.includes("pc slow") ||
        lower.includes("laptop slow") ||
        lower.includes("lagging") ||
        lower.includes("hang")
    ) {

        return "slowcomputer";

    }

    /* Printer */

    if (
        lower.includes("printer") ||
        lower.includes("printing") ||
        lower.includes("print")
    ) {

        return "printer";

    }

    /* Password / Account */

    if (
        lower.includes("password") ||
        lower.includes("account") ||
        lower.includes("login") ||
        lower.includes("log in")
    ) {

        return "account";

    }

    /* IP Address */

    if (
        lower.includes("ip address") ||
        lower.includes("ipv4") ||
        lower.includes("ipv6")
    ) {

        return "ip";

    }

    /* Storage */

    if (
        lower.includes("storage") ||
        lower.includes("disk space") ||
        lower.includes("hard drive") ||
        lower.includes("ssd")
    ) {

        return "storage";

    }

    /* Software */

    if (
        lower.includes("software") ||
        lower.includes("application") ||
        lower.includes("app") ||
        lower.includes("program")
    ) {

        return "software";

    }

    /* Hardware */

    if (
        lower.includes("keyboard") ||
        lower.includes("mouse") ||
        lower.includes("monitor") ||
        lower.includes("screen") ||
        lower.includes("ram") ||
        lower.includes("hardware")
    ) {

        return "hardware";

    }

    /* Network */

    if (
        lower.includes("network") ||
        lower.includes("router") ||
        lower.includes("ethernet")
    ) {

        return "network";

    }

    /* Virus / Malware */

    if (
        lower.includes("virus") ||
        lower.includes("malware") ||
        lower.includes("hacked")
    ) {

        return "security";

    }

    return "unknown";

}


/* =====================================================
   CASUAL / SERIOUS DETECTION
===================================================== */

function isSeriousQuestion(text) {

    const lower =
        text.toLowerCase();

    const seriousWords = [
        "error",
        "problem",
        "research",
        "assignment",
        "project",
        "system",
        "computer",
        "network",
        "software",
        "printer",
        "wifi",
        "password",
        "account",
        "ip address",
        "malware",
        "security"
    ];

    return seriousWords.some(word =>
        lower.includes(word)
    );

}


/* =====================================================
   MAIN RESPONSE ENGINE
===================================================== */

function generateResponse(text) {

    const language =
        detectLanguage(text);

    const questionType =
        detectQuestionType(text);

    const topic =
        detectITTopic(text);

    /*
       1. Greeting
    */

    if (questionType === "greeting") {

        return greetingResponse(language);

    }


    /*
       2. Thank you
    */

    if (questionType === "thanks") {

        return thanksResponse(language);

    }


    /*
       3. IT topic detected
    */

    if (topic !== "unknown") {

        return itResponse(
            language,
            topic,
            questionType,
            text
        );

    }


    /*
       4. General conversation
    */

    if (!isSeriousQuestion(text)) {

        return generalConversation(
            language,
            text
        );

    }


    /*
       5. Unknown technical question
    */

    return clarificationResponse(language);

}


