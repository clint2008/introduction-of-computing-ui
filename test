<script>

/* =====================================================
   SEND MESSAGE
===================================================== */

function sendMessage() {

    let input = document.getElementById("userInput");

    let message = input.value.trim();

    if (message === "") {

        alert("Please type something first.");

        return;

    }


    addMessage(
        message,
        "user"
    );


    input.value = "";


    setTimeout(function () {

        let response =
            getSmartAIResponse(message);

        addMessage(
            response,
            "ai"
        );

    }, 500);

}


/* =====================================================
   ADD MESSAGE TO CHAT
===================================================== */

function addMessage(message, sender) {

    let chatBox =
        document.getElementById("chatBox");

    let messageDiv =
        document.createElement("div");

    messageDiv.classList.add("message");


    if (sender === "user") {

        messageDiv.classList.add("user-message");

        messageDiv.innerHTML = `
            <strong>You:</strong><br>
            ${message}
        `;

    }

    else {

        messageDiv.classList.add("ai-message");

        messageDiv.innerHTML = `
            <span class="ai-name">
                IT Buddy 🤖
            </span>

            <br>

            ${message}
        `;

    }


    chatBox.appendChild(messageDiv);

    chatBox.scrollTop =
        chatBox.scrollHeight;

}


/* =====================================================
   SMART AI RESPONSE
===================================================== */

function getSmartAIResponse(message) {

    let text =
        message.toLowerCase();


    /*
     * STEP 1:
     * Detect the user's communication style.
     */

    let style =
        detectConversationStyle(text);


    /*
     * STEP 2:
     * Detect the IT problem.
     */

    let problem =
        detectProblem(text);


    /*
     * STEP 3:
     * Generate the appropriate response.
     */

    return generateResponse(
        style,
        problem,
        text
    );

}


/* =====================================================
   DETECT CONVERSATION STYLE
===================================================== */

function detectConversationStyle(text) {

    /*
     * Professional words
     */

    let professionalWords = [
        "please",
        "kindly",
        "request",
        "assistance",
        "professional",
        "university",
        "school",
        "system administrator",
        "administrator",
        "technical support",
        "incident",
        "report",
        "academic",
        "submission",
        "deadline"
    ];


    /*
     * Serious / urgent words
     */

    let seriousWords = [
        "urgent",
        "emergency",
        "important",
        "deadline",
        "cannot access",
        "locked out",
        "security",
        "hacked",
        "data loss",
        "stolen",
        "critical"
    ];


    /*
     * Casual words
     */

    let casualWords = [
        "hey",
        "hi",
        "hello",
        "yo",
        "lol",
        "haha",
        "bro",
        "dude",
        "pls",
        "please help",
        "😭",
        "😂",
        "😅"
    ];


    for (let word of seriousWords) {

        if (text.includes(word)) {

            return "serious";

        }

    }


    for (let word of professionalWords) {

        if (text.includes(word)) {

            return "professional";

        }

    }


    for (let word of casualWords) {

        if (text.includes(word)) {

            return "casual";

        }

    }


    /*
     * Default style
     */

    return "normal";

}


/* =====================================================
   DETECT IT PROBLEM
===================================================== */

function detectProblem(text) {

    if (
        text.includes("wifi") ||
        text.includes("wi-fi") ||
        text.includes("internet") ||
        text.includes("network")
    ) {

        return "internet";

    }


    if (
        text.includes("printer") ||
        text.includes("printing") ||
        text.includes("print")
    ) {

        return "printer";

    }


    if (
        text.includes("computer") ||
        text.includes("laptop") ||
        text.includes("slow") ||
        text.includes("freeze") ||
        text.includes("freezing")
    ) {

        return "computer";

    }


    if (
        text.includes("software") ||
        text.includes("application") ||
        text.includes("app") ||
        text.includes("program") ||
        text.includes("error")
    ) {

        return "software";

    }


    if (
        text.includes("password") ||
        text.includes("login") ||
        text.includes("account") ||
        text.includes("username")
    ) {

        return "account";

    }


    if (
        text.includes("hello") ||
        text.includes("hi") ||
        text.includes("hey") ||
        text.includes("yo")
    ) {

        return "greeting";

    }


    return "unknown";

}


/* =====================================================
   GENERATE RESPONSE
===================================================== */

function generateResponse(
    style,
    problem,
    text
) {


    /* ==============================================
       GREETING
    ============================================== */

    if (problem === "greeting") {

        if (style === "casual") {

            return `
            Hey! 👋😂

            IT Buddy is online and ready to help.

            What's causing trouble today?
            Hopefully not your computer deciding
            to work only when it feels like it. 😭
            `;

        }


        return `
        Hello! Welcome to the AI IT Help Desk.

        Please describe your technical concern,
        and I will provide troubleshooting guidance.
        `;

    }


    /* ==============================================
       INTERNET
    ============================================== */

    if (problem === "internet") {

        if (style === "serious" ||
            style === "professional") {

            return `
            <strong>Internet Connectivity Issue</strong>
            <br><br>

            Please perform the following checks:

            <ol>
                <li>
                    Verify that your device is connected
                    to the correct Wi-Fi network.
                </li>

                <li>
                    Check whether other websites or
                    online services are accessible.
                </li>

                <li>
                    Disconnect and reconnect to the network.
                </li>

                <li>
                    Restart your device if necessary.
                </li>
            </ol>

            If the issue affects multiple users,
            please report it to the IT Support team
            for further investigation.
            `;

        }


        return `
        Your Wi-Fi seems to be having a little
        identity crisis. 😂📶

        Let's fix it:

        <ol>
            <li>Check if Wi-Fi is turned on.</li>
            <li>Reconnect to the correct network.</li>
            <li>Try opening another website.</li>
            <li>Restart your device if needed.</li>
        </ol>

        If it still refuses to cooperate,
        we can send it to IT Support. 😄
        `;

    }


    /* ==============================================
       COMPUTER
    ============================================== */

    if (problem === "computer") {

        if (style === "serious" ||
            style === "professional") {

            return `
            <strong>Computer Performance Issue</strong>
            <br><br>

            Please try the following troubleshooting steps:

            <ol>
                <li>
                    Close unnecessary applications.
                </li>

                <li>
                    Restart the computer.
                </li>

                <li>
                    Check available storage space.
                </li>

                <li>
                    Check for available operating
                    system updates.
                </li>
            </ol>

            If the issue persists, please submit
            an IT Support request with details about
            the symptoms you are experiencing.
            `;

        }


        return `
        Your computer is moving slower than
        a Monday morning. 😂💻

        Let's give it a little help:

        <ol>
            <li>Close apps you aren't using.</li>
            <li>Restart your computer.</li>
            <li>Check your storage space.</li>
            <li>Install available updates.</li>
        </ol>

        If it's still slow, we can call
        the IT Support team.
        `;

    }


    /* ==============================================
       PRINTER
    ============================================== */

    if (problem === "printer") {

        if (style === "serious" ||
            style === "professional") {

            return `
            <strong>Printer Troubleshooting</strong>
            <br><br>

            Please verify the following:

            <ol>
                <li>
                    Confirm that the printer is powered on.
                </li>

                <li>
                    Check the paper supply.
                </li>

                <li>
                    Verify the printer connection.
                </li>

                <li>
                    Confirm that the correct printer
                    is selected on your device.
                </li>
            </ol>

            If the printer remains unavailable,
            please contact IT Support.
            `;

        }


        return `
        Ah, the printer has chosen violence again. 😂🖨️

        Don't worry. Let's check the basics:

        <ol>
            <li>Is the printer turned on?</li>
            <li>Does it have paper?</li>
            <li>Is it connected?</li>
            <li>Did you select the correct printer?</li>
        </ol>

        If it still refuses to print,
        IT Support may need to investigate.
        `;

    }


    /* ==============================================
       SOFTWARE
    ============================================== */

    if (problem === "software") {

        if (style === "serious" ||
            style === "professional") {

            return `
            <strong>Software/Application Issue</strong>
            <br><br>

            Please try the following:

            <ol>
                <li>
                    Close the affected application.
                </li>

                <li>
                    Reopen the application.
                </li>

                <li>
                    Restart the computer.
                </li>

                <li>
                    Check whether an application
                    update is available.
                </li>
            </ol>

            If the error continues,
            please provide the exact error message
            when submitting an IT Support request.
            `;

        }


        return `
        Looks like the software decided
        to cause some drama. 😂

        Try this:

        <ol>
            <li>Close the application.</li>
            <li>Open it again.</li>
            <li>Restart your computer.</li>
            <li>Check for updates.</li>
        </ol>

        If you still see the error,
        send me a screenshot and I'll help
        you identify the problem.
        `;

    }


    /* ==============================================
       ACCOUNT
    ============================================== */

    if (problem === "account") {

        if (style === "serious" ||
            style === "professional") {

            return `
            <strong>Account / Login Issue</strong>
            <br><br>

            Please verify that:

            <ol>
                <li>
                    Your username is correct.
                </li>

                <li>
                    Your password is entered correctly.
                </li>

                <li>
                    Caps Lock is not enabled accidentally.
                </li>
            </ol>

            Do not share your password with anyone,
            including IT Support.

            If you cannot access your account,
            contact the appropriate IT Support team
            for account recovery assistance.
            `;

        }


        return `
        Looks like your account is refusing
        to let you in. 😅🔐

        Try checking:

        <ol>
            <li>Your username.</li>
            <li>Your password.</li>
            <li>Whether Caps Lock is on.</li>
        </ol>

        Don't send your password here.

        If you still can't log in,
        contact IT Support.
        `;

    }


    /* ==============================================
       UNKNOWN QUESTION
    ============================================== */

    if (style === "serious" ||
        style === "professional") {

        return `
        Thank you for providing the information.

        I need more details to identify the
        technical issue accurately.

        Please provide:

        <ol>
            <li>The device you are using.</li>
            <li>The application or service involved.</li>
            <li>The exact error message, if available.</li>
            <li>What happened before the problem occurred.</li>
        </ol>

        You may also upload a screenshot
        of the error.
        `;

    }


    if (style === "casual") {

        return `
        Hmm... you've got me curious. 🤔

        Tell me a little more about what's happening.

        For example:

        <br><br>

        "My laptop turns on but the screen is black."

        <br><br>

        Or upload a screenshot using
        the 📸 button.
        `;

    }


    return `
    I can help with common IT problems such as:

    <ul>
        <li>🌐 Internet and Wi-Fi</li>
        <li>💻 Computer problems</li>
        <li>🖨️ Printer problems</li>
        <li>🧩 Software errors</li>
        <li>🔐 Account and login problems</li>
    </ul>

    Please describe what is happening,
    or upload a screenshot of the problem.
    `;

}


/* =====================================================
   QUICK HELP BUTTON
===================================================== */

function askProblem(problem) {

    let input =
        document.getElementById("userInput");


    document.getElementById("assistant")
        .scrollIntoView({
            behavior: "smooth"
        });


    if (problem === "internet") {

        input.value =
            "My Wi-Fi is not working.";

    }

    else if (problem === "computer") {

        input.value =
            "My computer is very slow.";

    }

    else if (problem === "printer") {

        input.value =
            "My printer is not printing.";

    }

    else if (problem === "software") {

        input.value =
            "I am getting a software error.";

    }


    sendMessage();

}


/* =====================================================
   ENTER KEY
===================================================== */

function handleEnter(event) {

    if (event.key === "Enter") {

        sendMessage();

    }

}


/* =====================================================
   IMAGE PREVIEW
===================================================== */

function previewImage(event) {

    let file =
        event.target.files[0];


    let preview =
        document.getElementById("imagePreview");


    if (!file) {

        return;

    }


    if (!file.type.startsWith("image/")) {

        alert("Please select an image.");

        return;

    }


    let reader =
        new FileReader();


    reader.onload =
        function(e) {

            preview.innerHTML = `

                <div class="alert alert-secondary">

                    <strong>
                        📸 Selected Picture
                    </strong>

                    <br><br>

                    <img
                        src="${e.target.result}"
                        class="uploaded-image">

                    <br>

                    <button
                        type="button"
                        class="btn btn-sm btn-danger mt-2"
                        onclick="removeImage()">

                        <i class="bi bi-trash"></i>
                        Remove

                    </button>

                </div>

            `;

        };


    reader.readAsDataURL(file);

}


/* =====================================================
   REMOVE IMAGE
===================================================== */

function removeImage() {

    document.getElementById("imageInput").value = "";

    document.getElementById("imagePreview").innerHTML = "";

}


/* =====================================================
   CONTACT IT SUPPORT
===================================================== */

document.getElementById("supportForm")
.addEventListener("submit", function(event) {

    event.preventDefault();


    let name =
        document.getElementById("studentName").value;


    let problem =
        document.getElementById("problemType").value;


    let ticketNumber =
        "IT-" +
        Math.floor(
            1000 + Math.random() * 9000
        );


    document.getElementById("supportResult")
        .innerHTML = `

        <div class="alert alert-success">

            <h5>
                <i class="bi bi-check-circle"></i>
                Support Request Submitted
            </h5>

            <p>
                Thank you, ${name}.
            </p>

            <strong>
                Ticket ID: ${ticketNumber}
            </strong>

            <br>

            Problem:
            ${problem}

            <br><br>

            <strong>
                Status:
            </strong>

            <span class="badge bg-warning text-dark">
                Pending
            </span>

        </div>

    `;


    document.getElementById("supportForm")
        .reset();

});

</script>

