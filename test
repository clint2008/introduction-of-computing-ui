========================================================= */

function generateResponse(text) {

    const language =
        detectLanguage(text);


    /* IT DETECTION FIRST */

    const itTopic =
        detectITTopic(text);

    if (itTopic) {

        return itResponse(
            itTopic,
            language,
            text
        );

    }


    /* PERSONAL / CASUAL */

    const personal =
        conversationalResponse(
            text,
            language
        );

    if (personal) {

        return personal;

    }


    /* QUESTION TYPE */

    const questionType =
        detectQuestionType(text);


    if (
        questionType === "greeting"
    ) {

        return greetingResponse(
            language
        );

    }


    if (
        questionType === "thanks"
    ) {

        return thanksResponse(
            language
        );

    }


    if (
        questionType === "definition"
    ) {

        if (
            language === "bisaya"
        ) {

            return `Sure. I can explain that in simple terms. 😄

Tell me the exact word or topic you're asking about.`;

        }


        if (
            language === "tagalog"
        ) {

            return `Sure. Maipapaliwanag ko iyon sa simple at madaling paraan. 😄

Sabihin mo lang ang exact word o topic.`;

        }


        return `Sure. I can explain that in simple terms. 😄

Tell me the exact word or topic you're asking about.`;

    }


    if (
        questionType === "howto"
    ) {

        if (
            language === "bisaya"
        ) {

            return `Sure. I can guide you step by step. 😄

Tell me exactly what you're trying to do.`;

        }


        if (
            language === "tagalog"
        ) {

            return `Sure. Puwede kitang gabayan step by step. 😄

Sabihin mo lang kung ano mismo ang gusto mong gawin.`;

        }


        return `Sure. I can guide you step by step. 😄

Tell me exactly what you're trying to do.`;

    }


    return clarificationResponse(
        text,
        language
    );

}


/* =========================================================
   VOICE INPUT
========================================================= */

function startVoiceInput() {

    const SpeechRecognition =
        window.SpeechRecognition ||
        window.webkitSpeechRecognition;


    if (!SpeechRecognition) {

        alert(
            "Voice input is not supported by this browser."
        );

        return;

    }


    const recognition =
        new SpeechRecognition();


    recognition.lang =
        "en-US";

    recognition.interimResults =
        false;

    recognition.maxAlternatives =
        1;


    recognition.start();


    recognition.onresult =
        function(event) {

            const text =
                event.results[0][0]
                .transcript;

            document.getElementById(
                "messageInput"
            ).value = text;

        };


    recognition.onerror =
        function() {

            alert(
                "Voice recognition could not understand the audio."
            );

        };

}


/* =========================================================
   IMAGE PREVIEW
========================================================= */

function previewImage(event) {

    const file =
        event.target.files[0];

    if (!file) {
        return;
    }


    const reader =
        new FileReader();


    reader.onload =
        function(e) {

            document.getElementById(
                "previewImg"
            ).src =
                e.target.result;

            document.getElementById(
                "imagePreview"
            ).style.display =
                "block";

        };


    reader.readAsDataURL(file);

}


/* =========================================================
   REMOVE IMAGE
========================================================= */

function removeImage() {

    document.getElementById(
        "imageInput"
    ).value = "";

    document.getElementById(
        "imagePreview"
    ).style.display =
        "none";

}


/* =========================================================
   IMAGE ANALYSIS
========================================================= */

function analyzeImage() {

    const input =
        document.getElementById(
            "imageInput"
        );

    if (
        !input.files ||
        input.files.length === 0
    ) {

        alert(
            "Please upload an image first."
        );

        return;

    }


    const file =
        input.files[0];


    addMessage(
        `🖼️ Image uploaded: ${file.name}`,
        "user"
    );


    showTyping();


    setTimeout(() => {

        removeTyping();


        addMessage(

`🖼️ Image Analysis

I received your image successfully. 👀

This school prototype can demonstrate:

• Image upload
• Image preview
• Image analysis workflow
• AI response interface

However, the current offline/browser prototype does not contain a real vision AI model.

For true visual understanding, the system would need to connect to a vision-capable AI model or backend.

You can still describe what is shown in the image and I can help based on your description.`,

        "bot");


    }, 800);

}

