/* =====================================================
   VOICE INPUT
===================================================== */

function startVoiceInput() {

    const SpeechRecognition =
        window.SpeechRecognition ||
        window.webkitSpeechRecognition;

    if (!SpeechRecognition) {

        alert(
            "Voice search is not supported by this browser."
        );

        return;

    }

    const recognition =
        new SpeechRecognition();

    recognition.lang =
        "en-US";

    recognition.interimResults =
        false;

    recognition.start();

    recognition.onresult =
        function(event) {

            const result =
                event.results[0][0].transcript;

            document.getElementById(
                "messageInput"
            ).value = result;

        };

    recognition.onerror =
        function() {

            alert(
                "Voice input could not be completed."
            );

        };

}


/* =====================================================
   IMAGE PREVIEW
===================================================== */

function previewImage(event) {

    const file =
        event.target.files[0];

    if (!file) return;

    const preview =
        document.getElementById("imagePreview");

    const reader =
        new FileReader();

    reader.onload =
        function(e) {

            preview.src =
                e.target.result;

            preview.style.display =
                "block";

            document.getElementById(
                "analyzeImageBtn"
            ).style.display =
                "inline-block";

        };

    reader.readAsDataURL(file);

}


/* =====================================================
   IMAGE ANALYSIS DEMO
===================================================== */

function analyzeImage() {

    const preview =
        document.getElementById("imagePreview");

    if (!preview.src) {

        alert("Please upload an image first.");

        return;

    }

    addMessage(
        "I uploaded an image. Can you analyze it?",
        "user"
    );

    showTyping();

    setTimeout(() => {

        removeTyping();

        const language =
            detectLanguage(
                document.getElementById("messageInput").value
            );

        let response;

        if (language === "bisaya") {

            response = `
