<script>

/* =========================================================
   THEME
========================================================= */

function toggleTheme() {

    document.body.classList.toggle("dark");

    if (document.body.classList.contains("dark")) {

        localStorage.setItem("theme", "dark");

    } else {

        localStorage.setItem("theme", "light");

    }

}


if (localStorage.getItem("theme") === "dark") {

    document.body.classList.add("dark");

}


/* =========================================================
   SEND MESSAGE
========================================================= */

function sendMessage() {

    const input =
        document.getElementById("userInput");

    const text =
        input.value.trim();

    if (text === "") {
        return;
    }

    addMessage(text, "user");

    input.value = "";

    showTyping();

    setTimeout(function () {

        removeTyping();

        const response =
            generateResponse(text);

        addMessage(response, "bot");

    }, 700);

}


/* =========================================================
   ENTER KEY
========================================================= */

function handleEnter(event) {

    if (event.key === "Enter") {

        sendMessage();

    }

}


/* =========================================================
   QUICK MESSAGE
========================================================= */

function quickMessage(text) {

    document.getElementById("userInput").value = text;

    sendMessage();

}


/* =========================================================
   ADD MESSAGE
========================================================= */

function addMessage(text, type) {

    const body =
        document.getElementById("chatBody");

    const message =
        document.createElement("div");

    message.className =
        "message " + type;

    const bubble =
        document.createElement("div");

    bubble.className =
        "bubble";


    if (type === "bot") {

        bubble.innerHTML =
            `<strong>IT Buddy 🤖</strong><br>` +
            formatText(text) +
            `<div class="reactions">

                <button
                    onclick="react('👍')">
                    👍
                </button>

                <button
                    onclick="react('❤️')">
                    ❤️
                </button>

                <button
                    onclick="react('😂')">
                    😂
                </button>

                <button
                    onclick="react('😕')">
                    😕
                </button>

                <button
                    onclick="react('👎')">
                    👎
                </button>

            </div>`;

    } else {

        bubble.textContent =
            text;

    }


    message.appendChild(bubble);

    body.appendChild(message);

    body.scrollTop =
        body.scrollHeight;

}


/* =========================================================
   REACTION
========================================================= */

function react(reaction) {

    alert("You reacted " + reaction);

}


/* =========================================================
   FORMAT TEXT
========================================================= */

function formatText(text) {

    return text
        .replace(/\n/g, "<br>")
        .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");

}


/* =========================================================
   TYPING INDICATOR
========================================================= */

function showTyping() {

    const body =
        document.getElementById("chatBody");

    const typing =
        document.createElement("div");

    typing.id =
        "typingIndicator";

    typing.className =
        "typing";

    typing.innerHTML =
        "IT Buddy is typing... 🤖";

    body.appendChild(typing);

    body.scrollTop =
        body.scrollHeight;

}


function removeTyping() {

    const typing =
        document.getElementById("typingIndicator");

    if (typing) {

        typing.remove();

    }

}


/* =========================================================
   DETECT EMOTION
========================================================= */

function detectEmotion(text) {

    const lower =
        text.toLowerCase();


    if (
        lower.includes("happy") ||
        lower.includes("glad") ||
        lower.includes("excited") ||
        lower.includes("great")
    ) {

        return "happy";

    }


    if (
        lower.includes("sad") ||
        lower.includes("lonely") ||
        lower.includes("down")
    ) {

        return "sad";

    }


    if (
        lower.includes("tired") ||
        lower.includes("exhausted")
    ) {

        return "tired";

    }


    if (
        lower.includes("nervous") ||
        lower.includes("worried")
    ) {

        return "nervous";

    }


    if (
        lower.includes("stressed") ||
        lower.includes("stress")
    ) {

        return "stressed";

    }


    if (
        lower.includes("angry") ||
        lower.includes("mad")
    ) {

        return "angry";

    }


    if (
        lower.includes("bored")
    ) {

        return "bored";

    }


    if (
        lower.includes("confused") ||
        lower.includes("don't understand")
    ) {

        return "confused";

    }


    if (
        lower.includes("thank") ||
        lower.includes("thanks")
    ) {

        return "grateful";

    }


    return null;

}


/* =========================================================
   DETECT IT TOPIC
========================================================= */

function detectITTopic(text) {

    const lower =
        text.toLowerCase();


    if (
        lower.includes("wifi") ||
        lower.includes("wi-fi") ||
        lower.includes("internet") ||
        lower.includes("connection") ||
        lower.includes("network")
    ) {

        return "internet";

    }


    if (
        lower.includes("computer") ||
        lower.includes("laptop") ||
        lower.includes("pc") ||
        lower.includes("slow") ||
        lower.includes("freeze")
    ) {

        return "computer";

    }


    if (
        lower.includes("printer") ||
        lower.includes("print")
    ) {

        return "printer";

    }


    if (
        lower.includes("software") ||
        lower.includes("application") ||
        lower.includes("app") ||
        lower.includes("program")
    ) {

        return "software";

    }


    if (
        lower.includes("password") ||
        lower.includes("account") ||
        lower.includes("login") ||
        lower.includes("log in")
    ) {

        return "account";

    }


    return null;

}


/* =========================================================
   GENERAL CONVERSATION
========================================================= */

function generalConversation(text) {

    const lower =
        text.toLowerCase();


    if (
        lower.includes("hello") ||
        lower.includes("hi") ||
        lower.includes("hey")
    ) {

        return "Hey! 👋 I'm IT Buddy. How are you doing today?";

    }


    if (
        lower.includes("how are you")
    ) {

        return "I'm ready to chat and help with your IT problems. 🤖 What’s on your mind?";

    }


    if (
        lower.includes("thank")
    ) {

        return "You're welcome! 😊 I'm always happy to help.";

    }


    if (
        lower.includes("joke")
    ) {

        return "Why did the computer go to the doctor? Because it had a virus! 😂";

    }


    if (
        lower.includes("school") ||
        lower.includes("study") ||
        lower.includes("class")
    ) {

        return "School can definitely be tiring. 📚 If you have an IT problem related to your studies, you can tell me what happened.";

    }


    if (
        lower.includes("tired") ||
        lower.includes("exhausted")
    ) {

        return "Sounds like you've had a long day. 😌 Take a short break if you can. If you still need help with something technical, I'm here.";

    }


    if (
        lower.includes("sad") ||
        lower.includes("lonely")
    ) {

        return "I'm sorry you're having a difficult moment. You can tell me what's bothering you if you want to talk.";

    }


    if (
        lower.includes("stressed") ||
        lower.includes("stress")
    ) {

        return "That sounds stressful. 😕 Let's take it one thing at a time. If the stress is because of a school or IT problem, tell me what you're dealing with.";

    }


    if (
        lower.includes("happy") ||
        lower.includes("excited") ||
        lower.includes("great")
    ) {

        return "That's great to hear! 😄 Tell me what happened.";

    }


    if (
        lower.includes("bored")
    ) {

        return "Bored already? 😄 We can talk, or I can give you a quick IT-related challenge.";

    }


    if (
        lower.includes("nervous") ||
        lower.includes("worried")
    ) {

        return "It's understandable to feel nervous sometimes. Take things one step at a time. What are you worried about?";

    }


    if (
        lower.includes("confused") ||
        lower.includes("don't understand")
    ) {

        return "No worries. Let's make it simpler. Tell me which part is confusing you.";

    }


    return "I'm listening. 😊 You can tell me about your day, ask a question, or switch to an IT problem whenever you need help.";

}


/* =========================================================
   IT RESPONSE
========================================================= */

function itResponse(topic, text) {

    if (topic === "internet") {

        return `Ah, switching to IT mode. 📶

Let's troubleshoot your internet connection.

1. Check if Wi-Fi is turned on.
2. Disconnect and reconnect to the network.
3. Check whether other devices can connect.
4. Restart your device.
5. If possible, restart the router.

If it still doesn't work, tell me what you're seeing, such as "connected but no internet" or "Wi-Fi doesn't appear."`;

    }


    if (topic === "computer") {

        return `Let's check your computer. 💻

Try these basic steps:

1. Close programs you don't need.
2. Restart the computer.
3. Check your available storage.
4. Check if many programs are running.
5. Make sure your system is updated.

If it's still slow, tell me when the problem happens—for example, during startup, browsing, gaming, or opening programs.`;

    }


    if (topic === "printer") {

        return `Let's troubleshoot the printer. 🖨️

Try these steps:

1. Check that the printer is powered on.
2. Check the paper.
3. Check the cable or Wi-Fi connection.
4. Make sure the correct printer is selected.
5. Try printing again after restarting the printer.

If you get an error message, send me the exact message.`;

    }


    if (topic === "software") {

        return `Let's troubleshoot the software problem. 💻

First, try:

1. Close the program.
2. Open it again.
3. Restart your computer.
4. Check for updates.
5. If the problem continues, tell me the name of the software and what happens when you open it.`;

    }


    if (topic === "account") {

        return `Let's check the account problem. 🔐

If you can't log in:

1. Check that your username is correct.
2. Check that Caps Lock isn't causing a problem.
3. Make sure you are using the correct account.
4. If available, use the official password recovery option.

For security, don't send me your actual password.`;

    }


    return "I can help troubleshoot that. Tell me what device you're using and what exactly happens when the problem occurs.";

}


