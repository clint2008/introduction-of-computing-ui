<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AI IT Buddy | Student IT Help Desk</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
:root {
    --bg: #f4f7fb;
    --card: #ffffff;
    --text: #172033;
    --muted: #6b7280;
    --primary: #2563eb;
    --secondary: #e8eefc;
    --border: #dbe2ea;
    --chat-user: #2563eb;
    --chat-bot: #ffffff;
}

body.dark {
    --bg: #0f172a;
    --card: #172033;
    --text: #f8fafc;
    --muted: #aab3c5;
    --primary: #60a5fa;
    --secondary: #263449;
    --border: #334155;
    --chat-user: #2563eb;
    --chat-bot: #1e293b;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: Arial, sans-serif;
    transition: 0.3s;
}

/* =========================
   LOGIN
========================= */

#authPage {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.auth-card {
    width: 100%;
    max-width: 420px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 10px 35px rgba(0,0,0,0.08);
}

.logo {
    text-align: center;
    font-size: 42px;
    margin-bottom: 10px;
}

.auth-card h2 {
    text-align: center;
    font-weight: bold;
}

.auth-card p {
    text-align: center;
    color: var(--muted);
}

.form-control {
    background: var(--card);
    color: var(--text);
    border-color: var(--border);
}

.form-control:focus {
    background: var(--card);
    color: var(--text);
}

.auth-card button {
    width: 100%;
}

.auth-switch {
    text-align: center;
    margin-top: 18px;
}

.auth-switch a {
    color: var(--primary);
    cursor: pointer;
}

/* =========================
   DASHBOARD
========================= */

#dashboard {
    display: none;
}

.navbar {
    background: var(--card);
    border-bottom: 1px solid var(--border);
}

.navbar-brand {
    color: var(--text) !important;
    font-weight: bold;
}

.menu-btn {
    border: none;
    background: transparent;
    color: var(--text);
    font-size: 25px;
}

/* =========================
   SIDEBAR
========================= */

.sidebar {
    position: fixed;
    top: 0;
    left: -300px;
    width: 280px;
    height: 100vh;
    background: var(--card);
    border-right: 1px solid var(--border);
    z-index: 2000;
    padding: 25px 18px;
    transition: 0.3s;
    overflow-y: auto;
}

.sidebar.active {
    left: 0;
}

.sidebar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
}

.sidebar-header h4 {
    margin: 0;
}

.close-sidebar {
    border: none;
    background: transparent;
    color: var(--text);
    font-size: 25px;
}

.menu-item {
    width: 100%;
    border: none;
    background: transparent;
    color: var(--text);
    padding: 13px 12px;
    border-radius: 10px;
    text-align: left;
    margin-bottom: 6px;
    transition: 0.2s;
}

.menu-item:hover {
    background: var(--secondary);
}

.menu-item span {
    margin-right: 10px;
}

.overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.45);
    z-index: 1500;
}

.overlay.active {
    display: block;
}

/* =========================
   MAIN
========================= */

main {
    max-width: 1200px;
    margin: auto;
    padding: 35px 20px;
}

.hero {
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white;
    border-radius: 22px;
    padding: 45px 30px;
    margin-bottom: 30px;
}

.hero h1 {
    font-weight: bold;
}

.hero p {
    max-width: 700px;
}

/* =========================
   CARDS
========================= */

.card-custom {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 22px;
    height: 100%;
}

.card-custom h5 {
    font-weight: bold;
}

.muted {
    color: var(--muted);
}

/* =========================
   CHAT
========================= */

.chat-container {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
}

.chat-header {
    padding: 18px;
    border-bottom: 1px solid var(--border);
}

.chat-header h4 {
    margin: 0;
}

.chat-box {
    height: 500px;
    overflow-y: auto;
    padding: 20px;
}

.message {
    display: flex;
    margin-bottom: 16px;
}

.message.user {
    justify-content: flex-end;
}

.bubble {
    max-width: 80%;
    padding: 12px 15px;
    border-radius: 15px;
    line-height: 1.5;
}

.message.bot .bubble {
    background: var(--chat-bot);
    border: 1px solid var(--border);
}

.message.user .bubble {
    background: var(--chat-user);
    color: white;
}

.chat-input-area {
    padding: 15px;
    border-top: 1px solid var(--border);
}

.chat-input {
    display: flex;
    gap: 8px;
}

.chat-input input {
    flex: 1;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text);
    border-radius: 12px;
    padding: 12px;
    outline: none;
}

.chat-button {
    border: none;
    background: var(--primary);
    color: white;
    border-radius: 12px;
    padding: 10px 15px;
}

.icon-button {
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text);
    border-radius: 10px;
    padding: 10px 13px;
}

/* =========================
   QUICK QUESTIONS
========================= */

.quick-question {
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text);
    border-radius: 20px;
    padding: 7px 12px;
    margin: 3px;
    cursor: pointer;
}

.quick-question:hover {
    background: var(--secondary);
}

/* =========================
   REACTIONS
========================= */

.reactions {
    margin-top: 10px;
}

.reactions button {
    border: 1px solid rgba(128,128,128,0.3);
    background: transparent;
    color: var(--text);
    border-radius: 20px;
    padding: 3px 8px;
    margin-right: 4px;
    cursor: pointer;
    transition: 0.15s;
}

.reactions button:hover {
    transform: scale(1.12);
    background: rgba(128,128,128,0.15);
}

.reaction-message {
    font-size: 12px;
    margin-top: 5px;
    color: var(--muted);
}

/* =========================
   IMAGE
========================= */

.image-preview {
    max-width: 220px;
    max-height: 220px;
    display: none;
    margin-top: 10px;
    border-radius: 12px;
    border: 1px solid var(--border);
}

/* =========================
   TYPING
========================= */

.typing {
    color: var(--muted);
    font-style: italic;
    padding: 10px;
}

/* =========================
   HISTORY
========================= */

.history-item {
    padding: 12px;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
}

.history-item:hover {
    background: var(--secondary);
}

/* =========================
   PROFILE
========================= */

.profile-box {
    text-align: center;
}

.profile-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: auto;
    font-size: 30px;
    font-weight: bold;
}

/* =========================
   FOOTER
========================= */

footer {
    text-align: center;
    padding: 30px;
    color: var(--muted);
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width: 600px) {
    .hero {
        padding: 30px 20px;
    }

    .bubble {
        max-width: 90%;
    }

    .chat-box {
        height: 430px;
    }
}
</style>
</head>

<body>

<!-- =====================================================
     AUTH PAGE
===================================================== -->

<div id="authPage">

    <div class="auth-card">

        <div class="logo">🤖</div>

        <h2>AI IT Buddy</h2>

        <p>Student-Friendly IT Help Desk</p>

        <!-- LOGIN -->

        <div id="loginForm">

            <div class="mb-3">
                <label>Email</label>
                <input type="email" id="loginEmail" class="form-control">
            </div>

            <div class="mb-3">
                <label>Password</label>
                <input type="password" id="loginPassword" class="form-control">
            </div>

            <button class="btn btn-primary" onclick="login()">
                Login
            </button>

            <div class="auth-switch">
                No account yet?
                <a onclick="showRegister()">Create Account</a>
            </div>

        </div>

        <!-- REGISTER -->

        <div id="registerForm" style="display:none;">

            <div class="mb-3">
                <label>Full Name</label>
                <input type="text" id="registerName" class="form-control">
            </div>

            <div class="mb-3">
                <label>Email</label>
                <input type="email" id="registerEmail" class="form-control">
            </div>

            <div class="mb-3">
                <label>Password</label>
                <input type="password" id="registerPassword" class="form-control">
            </div>

            <button class="btn btn-primary" onclick="createAccount()">
                Create Account
            </button>

            <div class="auth-switch">
                Already have an account?
                <a onclick="showLogin()">Login</a>
            </div>

        </div>

    </div>

</div>


<!-- =====================================================
     DASHBOARD
===================================================== -->

<div id="dashboard">

    <!-- SIDEBAR -->

    <div class="sidebar" id="sidebar">

        <div class="sidebar-header">
            <h4>🤖 IT Buddy</h4>

            <button class="close-sidebar"
                    onclick="toggleSidebar()">
                ×
            </button>
        </div>

        <button class="menu-item"
                onclick="searchChat()">
            <span>🔎</span>
            Search
        </button>

        <button class="menu-item"
                onclick="newChat()">
            <span>➕</span>
            New Chat
        </button>

        <button class="menu-item"
                onclick="showHistory()">
            <span>🕘</span>
            Search History
        </button>

        <button class="menu-item"
                onclick="toggleTheme()">
            <span id="themeIcon">🌙</span>
            <span id="themeText">Dark Mode</span>
        </button>

        <button class="menu-item"
                onclick="showProfile()">
            <span>👤</span>
            Profile / Settings
        </button>

        <button class="menu-item"
                onclick="logout()">
            <span>🚪</span>
            Logout
        </button>

    </div>

    <div class="overlay" id="overlay"
         onclick="toggleSidebar()"></div>


    <!-- NAVBAR -->

    <nav class="navbar px-3">

        <button class="menu-btn"
                onclick="toggleSidebar()">
            ☰
        </button>

        <span class="navbar-brand ms-3">
            🤖 AI IT Buddy
        </span>

        <span class="ms-auto muted"
              id="welcomeName">
        </span>

    </nav>


    <!-- MAIN -->

    <main>

        <!-- HERO -->

        <section class="hero">

            <h1>
                Hello, I'm IT Buddy 🤖
            </h1>

            <p>
                Your student-friendly IT Help Desk assistant.
                Ask me about technical problems, school IT concepts,
                or even simple everyday questions.
            </p>

            <button class="btn btn-light"
                    onclick="document.getElementById('chatSection').scrollIntoView()">
                Start Chatting
            </button>

        </section>


        <!-- FEATURES -->

        <div class="row g-4 mb-4">

            <div class="col-md-4">

                <div class="card-custom">

                    <h5>🛠️ IT Support</h5>

                    <p class="muted">
                        Get guidance for Wi-Fi, computers,
                        printers, software, accounts, and other
                        common IT problems.
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card-custom">

                    <h5>💬 Natural Conversation</h5>

                    <p class="muted">
                        Ask questions using normal English,
                        Tagalog, Bisaya, or mixed language.
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card-custom">

                    <h5>📷 Image Support</h5>

                    <p class="muted">
                        Upload a screenshot or image related
                        to your IT problem for analysis support.
                    </p>

                </div>

            </div>

        </div>


        <!-- CHAT -->

        <section id="chatSection">

            <div class="chat-container">

                <div class="chat-header">

                    <h4>
                        💬 AI Assistant
                    </h4>

                    <small class="muted">
                        Ask your question below
                    </small>

                </div>


                <div class="chat-box"
                     id="chatBox">

                    <div class="message bot">

                        <div class="bubble">

                            <strong>IT Buddy 🤖</strong><br>

                            Hi! I'm your AI IT Buddy.
                            You can ask me about Wi-Fi,
                            computers, printers, software,
                            school IT questions, or just talk to me.

                            <div class="reactions">

                                <button onclick="react('👍')">👍</button>
                                <button onclick="react('❤️')">❤️</button>
                                <button onclick="react('😂')">😂</button>
                                <button onclick="react('😕')">😕</button>
                                <button onclick="react('👎')">👎</button>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- QUICK QUESTIONS -->

                <div class="p-3">

                    <small class="muted">
                        Quick Questions
                    </small>

                    <div class="mt-2">

                        <button class="quick-question"
                                onclick="quickMessage('My Wi-Fi is not working')">
                            📶 Wi-Fi
                        </button>

                        <button class="quick-question"
                                onclick="quickMessage('My computer is very slow')">
                            🐌 Slow Computer
                        </button>

                        <button class="quick-question"
                                onclick="quickMessage('My printer is not printing')">
                            🖨️ Printer
                        </button>

                        <button class="quick-question"
                                onclick="quickMessage('What is an IP address?')">
                            🌐 IP Address
                        </button>

                    </div>

                </div>


                <!-- IMAGE PREVIEW -->

                <div class="px-3">

                    <img id="imagePreview"
                         class="image-preview">

                    <button id="analyzeImageBtn"
                            class="btn btn-sm btn-primary mt-2"
                            style="display:none;"
                            onclick="analyzeImage()">
                        🔍 Analyze Image
                    </button>

                </div>


                <!-- INPUT -->

                <div class="chat-input-area">

                    <div class="chat-input">

                        <input type="text"
                               id="messageInput"
                               placeholder="Type your question..."
                               onkeydown="handleEnter(event)">

                        <button class="icon-button"
                                onclick="startVoiceInput()"
                                title="Voice Search">
                            🎤
                        </button>

                        <label class="icon-button"
                               title="Upload Image">
                            📷

                            <input type="file"
                                   id="imageInput"
                                   accept="image/*"
                                   style="display:none;"
                                   onchange="previewImage(event)">
                        </label>

                        <button class="chat-button"
                                onclick="sendMessage()">
                            Send
                        </button>

                    </div>

                </div>

            </div>

        </section>


        <!-- TROUBLESHOOTING -->

        <section class="mt-5">

            <h3>
                🛠️ Troubleshooting Guide
            </h3>

            <div class="accordion" id="troubleshooting">

                <div class="accordion-item">

                    <h2 class="accordion-header">

                        <button class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#wifi">
                            Wi-Fi / Internet
                        </button>

                    </h2>

                    <div id="wifi"
                         class="accordion-collapse collapse">

                        <div class="accordion-body">

                            Check if Wi-Fi is enabled,
                            reconnect to the network,
                            restart the router if allowed,
                            and test another device.

                        </div>

                    </div>

                </div>


                <div class="accordion-item">

                    <h2 class="accordion-header">

                        <button class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#slow">
                            Slow Computer
                        </button>

                    </h2>

                    <div id="slow"
                         class="accordion-collapse collapse">

                        <div class="accordion-body">

                            Close unnecessary applications,
                            restart the computer,
                            check available storage,
                            and look for programs using
                            too many resources.

                        </div>

                    </div>

                </div>


                <div class="accordion-item">

                    <h2 class="accordion-header">

                        <button class="accordion-button collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#printer">
                            Printer Problem
                        </button>

                    </h2>

                    <div id="printer"
                         class="accordion-collapse collapse">

                        <div class="accordion-body">

                            Check the printer connection,
                            paper, ink or toner, printer selection,
                            and print queue.

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- CONTACT IT -->

        <section class="mt-5">

            <div class="card-custom">

                <h3>
                    📩 Contact IT Support
                </h3>

                <p class="muted">
                    If the troubleshooting steps do not solve
                    your problem, you can submit a support request.
                </p>

                <input id="supportName"
                       class="form-control mb-2"
                       placeholder="Your name">

                <input id="supportProblem"
                       class="form-control mb-2"
                       placeholder="Describe your IT problem">

                <button class="btn btn-primary"
                        onclick="submitSupportRequest()">
                    Submit Support Request
                </button>

                <div id="ticketResult"
                     class="mt-3">
                </div>

            </div>

        </section>

    </main>


    <footer>

        AI IT Buddy © 2026 |
        Student-Friendly IT Help Desk Prototype

    </footer>

</div>


<!-- =====================================================
     PROFILE MODAL
===================================================== -->

<div class="modal fade"
     id="profileModal"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content"
             style="background:var(--card); color:var(--text);">

            <div class="modal-header">

                <h5 class="modal-title">
                    👤 Profile / Settings
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div class="profile-box">

                    <div class="profile-avatar">
                        👤
                    </div>

                    <h4 id="profileName"
                        class="mt-3">
                    </h4>

                    <p id="profileEmail"
                       class="muted">
                    </p>

                    <p>
                        <strong>Role:</strong>
                        Student
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =====================================================
     JAVASCRIPT
===================================================== -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>

/* =====================================================
   ACCOUNT SYSTEM
===================================================== */

function createAccount() {

    const name =
        document.getElementById("registerName").value.trim();

    const email =
        document.getElementById("registerEmail").value.trim();

    const password =
        document.getElementById("registerPassword").value;

    if (!name || !email || !password) {

        alert("Please complete all fields.");

        return;
    }

    const account = {
        name: name,
        email: email,
        password: password
    };

    localStorage.setItem(
        "itBuddyAccount",
        JSON.stringify(account)
    );

    alert("Account created successfully!");

    showLogin();
}


function login() {

    const email =
        document.getElementById("loginEmail").value.trim();

    const password =
        document.getElementById("loginPassword").value;

    const saved =
        JSON.parse(localStorage.getItem("itBuddyAccount"));

    if (!saved) {

        alert("No account found. Please create an account first.");

        return;
    }

    if (
        email === saved.email &&
        password === saved.password
    ) {

        localStorage.setItem(
            "itBuddyLoggedIn",
            "true"
        );

        showDashboard();

    } else {

        alert("Incorrect email or password.");

    }
}


function showLogin() {

    document.getElementById("loginForm").style.display = "block";

    document.getElementById("registerForm").style.display = "none";
}


function showRegister() {

    document.getElementById("loginForm").style.display = "none";

    document.getElementById("registerForm").style.display = "block";
}


function showDashboard() {

    const account =
        JSON.parse(localStorage.getItem("itBuddyAccount"));

    document.getElementById("authPage").style.display = "none";

    document.getElementById("dashboard").style.display = "block";

    if (account) {

        document.getElementById("welcomeName").textContent =
            "Hi, " + account.name;

        document.getElementById("profileName").textContent =
            account.name;

        document.getElementById("profileEmail").textContent =
            account.email;

    }
}


function logout() {

    localStorage.removeItem("itBuddyLoggedIn");

    location.reload();

}


/* =====================================================
   STARTUP
===================================================== */

window.onload = function() {

    const loggedIn =
        localStorage.getItem("itBuddyLoggedIn");

    if (loggedIn === "true") {

        showDashboard();

    }

    loadTheme();

};


/* =====================================================
   SIDEBAR
===================================================== */

function toggleSidebar() {

    document
        .getElementById("sidebar")
        .classList.toggle("active");

    document
        .getElementById("overlay")
        .classList.toggle("active");

}


/* =====================================================
   DARK / LIGHT MODE
===================================================== */

function toggleTheme() {

    document.body.classList.toggle("dark");

    const dark =
        document.body.classList.contains("dark");

    localStorage.setItem(
        "itBuddyTheme",
        dark ? "dark" : "light"
    );

    updateThemeText();

}


function loadTheme() {

    const theme =
        localStorage.getItem("itBuddyTheme");

    if (theme === "dark") {

        document.body.classList.add("dark");

    }

    updateThemeText();

}


function updateThemeText() {

    const dark =
        document.body.classList.contains("dark");

    const icon =
        document.getElementById("themeIcon");

    const text =
        document.getElementById("themeText");

    if (icon && text) {

        if (dark) {

            icon.textContent = "☀️";
            text.textContent = "Light Mode";

        } else {

            icon.textContent = "🌙";
            text.textContent = "Dark Mode";

        }

    }

}


/* =====================================================
   NEW CHAT
===================================================== */

function newChat() {

    document.getElementById("chatBox").innerHTML = `

        <div class="message bot">

            <div class="bubble">

                <strong>IT Buddy 🤖</strong><br>

                New chat started! 👋<br><br>

                What can I help you with today?

            </div>

        </div>

    `;

    document.getElementById("messageInput").value = "";

    toggleSidebar();

}


/* =====================================================
   SEARCH
===================================================== */

function searchChat() {

    const keyword =
        prompt("Search your chat history:");

    if (!keyword) return;

    const history =
        JSON.parse(localStorage.getItem("itBuddyHistory")) || [];

    const results =
        history.filter(item =>
            item.message
