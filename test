<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AI IT Buddy</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<style>
:root {
    --bg: #f4f7fb;
    --card: #ffffff;
    --text: #20242a;
    --muted: #6c757d;
    --primary: #0d6efd;
    --border: #e1e5ea;
    --bot: #eef4ff;
}

body.dark {
    --bg: #12151a;
    --card: #1d2229;
    --text: #f1f3f5;
    --muted: #adb5bd;
    --border: #343a40;
    --bot: #252d38;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: Arial, sans-serif;
    transition: 0.25s;
}

/* =========================
   LOGIN
========================= */

#loginPage {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.login-card {
    width: 100%;
    max-width: 420px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 10px 35px rgba(0,0,0,0.08);
}

.logo {
    font-size: 45px;
    text-align: center;
}

.login-card h2 {
    text-align: center;
    margin-bottom: 8px;
}

.login-card p {
    text-align: center;
    color: var(--muted);
}

.form-control {
    background: var(--card);
    color: var(--text);
    border-color: var(--border);
}

.form-control:focus {
    background: var(--card);
    color: var(--text);
}

/* =========================
   APP
========================= */

#app {
    display: none;
}

/* =========================
   SIDEBAR
========================= */

.sidebar {
    position: fixed;
    left: -280px;
    top: 0;
    width: 280px;
    height: 100vh;
    background: var(--card);
    border-right: 1px solid var(--border);
    z-index: 2000;
    transition: left 0.25s ease;
    padding: 20px;
    display: flex;
    flex-direction: column;
}

.sidebar.open {
    left: 0;
}

.sidebar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
}

.sidebar-header h4 {
    margin: 0;
}

.close-sidebar {
    border: 0;
    background: transparent;
    color: var(--text);
    font-size: 24px;
    cursor: pointer;
}

.menu-btn {
    width: 100%;
    padding: 11px 13px;
    margin-bottom: 7px;
    border: 0;
    background: transparent;
    color: var(--text);
    text-align: left;
    border-radius: 10px;
    cursor: pointer;
    font-size: 15px;
}

.menu-btn:hover {
    background: rgba(128,128,128,0.15);
}

.menu-btn.active {
    background: rgba(13,110,253,0.12);
}

.sidebar-divider {
    border-top: 1px solid var(--border);
    margin: 15px 0;
}

.profile-box {
    margin-top: auto;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 12px;
}

.profile-name {
    font-weight: bold;
}

.profile-email {
    font-size: 12px;
    color: var(--muted);
}

/* Overlay */

.sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.35);
    z-index: 1500;
}

.sidebar-overlay.show {
    display: block;
}

/* =========================
   NAVBAR
========================= */

.navbar-custom {
    background: var(--card);
    border-bottom: 1px solid var(--border);
    padding: 12px 18px;
}

.nav-left {
    display: flex;
    align-items: center;
    gap: 12px;
}

.hamburger {
    border: 0;
    background: transparent;
    color: var(--text);
    font-size: 24px;
    cursor: pointer;
}

.brand {
    font-weight: bold;
    color: var(--text);
    font-size: 18px;
}

.nav-right {
    margin-left: auto;
}

.theme-btn {
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    border-radius: 20px;
    padding: 6px 12px;
    cursor: pointer;
}

/* =========================
   MAIN
========================= */

.main {
    max-width: 1100px;
    margin: auto;
    padding: 35px 20px;
}

.hero {
    text-align: center;
    padding: 30px 15px;
}

.hero h1 {
    font-weight: bold;
}

.hero p {
    color: var(--muted);
}

/* =========================
   CARDS
========================= */

.card-custom {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 20px;
    height: 100%;
}

.card-custom h5 {
    margin-bottom: 10px;
}

/* =========================
   CHAT
========================= */

.chat-container {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
}

.chat-header {
    padding: 15px 20px;
    border-bottom: 1px solid var(--border);
}

.chat-header h5 {
    margin: 0;
}

.chat-header small {
    color: var(--muted);
}

.chat-box {
    height: 430px;
    overflow-y: auto;
    padding: 20px;
}

.message {
    display: flex;
    margin-bottom: 15px;
}

.message.user {
    justify-content: flex-end;
}

.bubble {
    max-width: 80%;
    padding: 11px 14px;
    border-radius: 15px;
    line-height: 1.5;
}

.message.bot .bubble {
    background: var(--bot);
    color: var(--text);
    border-bottom-left-radius: 4px;
}

.message.user .bubble {
    background: var(--primary);
    color: white;
    border-bottom-right-radius: 4px;
}

.input-area {
    padding: 15px;
    border-top: 1px solid var(--border);
}

.input-row {
    display: flex;
    gap: 8px;
}

.input-row input {
    flex: 1;
}

.voice-btn,
.send-btn {
    border: 0;
    border-radius: 10px;
    padding: 0 15px;
    cursor: pointer;
}

.voice-btn {
    background: #6f42c1;
    color: white;
}

.send-btn {
    background: var(--primary);
    color: white;
}

/* =========================
   REACTIONS
========================= */

.reactions {
    margin-top: 10px;
}

.reactions button {
    border: 1px solid rgba(128,128,128,0.3);
    background: transparent;
    color: var(--text);
    border-radius: 20px;
    padding: 3px 8px;
    margin-right: 4px;
    cursor: pointer;
}

.reactions button:hover {
    transform: scale(1.1);
    background: rgba(128,128,128,0.15);
}

.reaction-message {
    font-size: 12px;
    color: var(--muted);
    margin-top: 5px;
}

/* =========================
   HISTORY
========================= */

.history-list {
    max-height: 500px;
    overflow-y: auto;
}

.history-item {
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    margin-bottom: 8px;
    cursor: pointer;
}

.history-item:hover {
    background: rgba(128,128,128,0.12);
}

.history-title {
    font-weight: bold;
}

.history-date {
    font-size: 11px;
    color: var(--muted);
}

/* =========================
   SETTINGS
========================= */

.settings-card {
    max-width: 700px;
    margin: auto;
}

.profile-icon {
    width: 75px;
    height: 75px;
    background: var(--primary);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    margin: 0 auto 15px;
}

/* =========================
   TYPING
========================= */

.typing {
    color: var(--muted);
    font-size: 13px;
    padding: 5px;
}

/* =========================
   FOOTER
========================= */

footer {
    text-align: center;
    padding: 30px;
    color: var(--muted);
}
</style>
</head>

<body>

<!-- =========================
     LOGIN PAGE
========================= -->

<div id="loginPage">

    <div class="login-card">

        <div class="logo">🤖</div>

        <h2>AI IT Buddy</h2>

        <p>Your Student IT Help Desk</p>

        <div id="loginForm">

            <div class="mb-3">
                <label>Email</label>
                <input
                    type="email"
                    id="loginEmail"
                    class="form-control"
                    placeholder="Enter your email">
            </div>

            <div class="mb-3">
                <label>Password</label>
                <input
                    type="password"
                    id="loginPassword"
                    class="form-control"
                    placeholder="Enter your password">
            </div>

            <button class="btn btn-primary w-100" onclick="login()">
                Login
            </button>

            <div class="text-center mt-3">
                <button
                    class="btn btn-link"
                    onclick="showCreateAccount()">
                    Create Account
                </button>
            </div>

        </div>

        <div id="createAccountForm" style="display:none;">

            <div class="mb-3">
                <label>Name</label>
                <input
                    type="text"
                    id="registerName"
                    class="form-control"
                    placeholder="Enter your name">
            </div>

            <div class="mb-3">
                <label>Email</label>
                <input
                    type="email"
                    id="registerEmail"
                    class="form-control"
                    placeholder="Enter your email">
            </div>

            <div class="mb-3">
                <label>Password</label>
                <input
                    type="password"
                    id="registerPassword"
                    class="form-control"
                    placeholder="Create a password">
            </div>

            <button
                class="btn btn-primary w-100"
                onclick="createAccount()">
                Create Account
            </button>

            <div class="text-center mt-3">
                <button
                    class="btn btn-link"
                    onclick="showLogin()">
                    Back to Login
                </button>
            </div>

        </div>

    </div>
</div>


<!-- =========================
     MAIN APP
========================= -->

<div id="app">

<!-- SIDEBAR -->

<div class="sidebar-overlay" id="sidebarOverlay"
     onclick="closeSidebar()"></div>

<aside class="sidebar" id="sidebar">

    <div class="sidebar-header">

        <h4>🤖 AI IT Buddy</h4>

        <button
            class="close-sidebar"
            onclick="closeSidebar()">
            ×
        </button>

    </div>


    <button class="menu-btn" onclick="showSearch()">
        🔍 Search
    </button>

    <button class="menu-btn" onclick="newChat()">
        ➕ New Chat
    </button>

    <button class="menu-btn" onclick="showHistory()">
        🕘 History
    </button>


    <div class="sidebar-divider"></div>


    <button class="menu-btn" onclick="toggleTheme()">
        🌙 / ☀️ Dark / Light Mode
    </button>

    <button class="menu-btn" onclick="showSettings()">
        ⚙️ Settings
    </button>

    <button class="menu-btn" onclick="logout()">
        🚪 Log Out
    </button>


    <div class="profile-box">

        <div class="profile-name" id="sidebarName">
            Student
        </div>

        <div class="profile-email" id="sidebarEmail">
            student@email.com
        </div>

    </div>

</aside>


<!-- NAVBAR -->

<nav class="navbar-custom">

    <div class="nav-left">

        <button
            class="hamburger"
            onclick="openSidebar()">
            ☰
        </button>

        <span class="brand">
            AI IT Buddy
        </span>

    </div>

    <div class="nav-right">

        <button
            class="theme-btn"
            onclick="toggleTheme()">
            🌙 / ☀️
        </button>

    </div>

</nav>


<!-- MAIN CONTENT -->

<main class="main">

<!-- HOME -->

<section id="homePage">

    <div class="hero">

        <h1>
            Welcome to AI IT Buddy 🤖
        </h1>

        <p id="welcomeText">
            Your student-friendly IT Help Desk
        </p>

    </div>


    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="card-custom">

                <h5>💬 AI Assistant</h5>

                <p>
                    Ask questions about common computer
                    and technology problems.
                </p>

                <button
                    class="btn btn-primary"
                    onclick="openAssistant()">
                    Open Assistant
                </button>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card-custom">

                <h5>🛠️ Troubleshooting</h5>

                <p>
                    Find quick solutions for common
                    IT problems.
                </p>

                <button
                    class="btn btn-outline-primary"
                    onclick="showTroubleshooting()">
                    View Guides
                </button>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card-custom">

                <h5>🎫 Contact IT</h5>

                <p>
                    Submit a support request when
                    you need additional help.
                </p>

                <button
                    class="btn btn-outline-primary"
                    onclick="showContact()">
                    Contact IT
                </button>

            </div>

        </div>

    </div>

</section>


<!-- ASSISTANT -->

<section id="assistantPage" style="display:none;">

    <div class="chat-container">

        <div class="chat-header">

            <h5>🤖 AI IT Buddy</h5>

            <small>
                Ask me about your IT problems
            </small>

        </div>


        <div id="chatBox" class="chat-box">

            <div class="message bot">

                <div class="bubble">

                    <strong>IT Buddy 🤖</strong><br>

                    Hello! I'm your AI IT Buddy.
                    You can type your question or use
                    the 🎤 microphone.

                    <div class="reactions">

                        <button onclick="react('👍')">👍</button>
                        <button onclick="react('❤️')">❤️</button>
                        <button onclick="react('😂')">😂</button>
                        <button onclick="react('😕')">😕</button>
                        <button onclick="react('👎')">👎</button>

                    </div>

                </div>

            </div>

        </div>


        <div class="input-area">

            <div class="input-row">

                <input
                    type="text"
                    id="userInput"
                    class="form-control"
                    placeholder="Type your IT question..."
                    onkeydown="handleEnter(event)">

                <button
                    class="voice-btn"
                    onclick="startVoiceSearch()"
                    title="Voice Search">
                    🎤
                </button>

                <button
                    class="send-btn"
                    onclick="sendMessage()">
                    Send
                </button>

            </div>

            <small class="text-muted">
                You can type or use your microphone.
            </small>

        </div>

    </div>


    <div class="mt-3">

        <button
            class="btn btn-sm btn-outline-primary"
            onclick="quickMessage('My Wi-Fi is not working')">
            📶 Wi-Fi
        </button>

        <button
            class="btn btn-sm btn-outline-primary"
            onclick="quickMessage('My computer is very slow')">
            🐌 Slow Computer
        </button>

        <button
            class="btn btn-sm btn-outline-primary"
            onclick="quickMessage('My printer is not working')">
            🖨️ Printer
        </button>

        <button
            class="btn btn-sm btn-outline-primary"
            onclick="quickMessage('My software is not working')">
            💻 Software
        </button>

    </div>

</section>


<!-- SEARCH -->

<section id="searchPage" style="display:none;">

    <div class="card-custom">

        <h3>🔍 Search</h3>

        <p class="text-muted">
            Search your previous AI Buddy conversations.
        </p>

        <div class="input-group mb-3">

            <input
                type="text"
                id="searchInput"
                class="form-control"
                placeholder="Search your chats..."
                onkeyup="searchHistory()">

            <button
                class="btn btn-primary"
                onclick="searchHistory()">
                Search
            </button>

        </div>

        <div id="searchResults"></div>

    </div>

</section>


<!-- HISTORY -->

<section id="historyPage" style="display:none;">

    <div class="card-custom">

        <h3>🕘 Chat History</h3>

        <p class="text-muted">
            Your previous conversations are stored
            in this browser.
        </p>

        <div id="historyList" class="history-list"></div>

    </div>

</section>


<!-- SETTINGS -->

<section id="settingsPage" style="display:none;">

    <div class="card-custom settings-card">

        <div class="profile-icon">
            👤
        </div>

        <h3 class="text-center">
            Profile & Settings
        </h3>

        <p class="text-center text-muted">
            Manage your AI IT Buddy account.
        </p>

        <hr>

        <p>
            <strong>Name:</strong>
            <span id="profileName"></span>
        </p>

        <p>
            <strong>Email:</strong>
            <span id="profileEmail"></span>
        </p>

        <hr>

        <button
            class="btn btn-outline-primary w-100 mb-2"
            onclick="toggleTheme()">
            🌙 / ☀️ Change Theme
        </button>

        <button
            class="btn btn-danger w-100"
            onclick="logout()">
            🚪 Log Out
        </button>

    </div>

</section>


<!-- TROUBLESHOOTING -->

<section id="troubleshootingPage" style="display:none;">

    <div class="card-custom">

        <h3>🛠️ Troubleshooting Guides</h3>

        <hr>

        <h5>📶 Wi-Fi Not Working</h5>

        <ol>
            <li>Check if Wi-Fi is turned on.</li>
            <li>Restart your router.</li>
            <li>Reconnect to the Wi-Fi network.</li>
            <li>Restart your device.</li>
        </ol>

        <h5>🐌 Computer Is Slow</h5>

        <ol>
            <li>Close unnecessary programs.</li>
            <li>Restart the computer.</li>
            <li>Check available storage.</li>
            <li>Scan for malware.</li>
        </ol>

        <h5>🖨️ Printer Not Working</h5>

        <ol>
            <li>Check the printer power.</li>
            <li>Check the cable or Wi-Fi connection.</li>
            <li>Check the paper and ink.</li>
            <li>Restart the printer.</li>
        </ol>

    </div>

</section>


<!-- CONTACT -->

<section id="contactPage" style="display:none;">

    <div class="card-custom">

        <h3>🎫 Contact IT</h3>

        <p class="text-muted">
            Submit a support request.
        </p>

        <input
            id="issueName"
            class="form-control mb-2"
            placeholder="Your name">

        <input
            id="issueEmail"
            class="form-control mb-2"
            placeholder="Email">

        <textarea
            id="issueDescription"
            class="form-control mb-3"
            rows="5"
            placeholder="Describe your IT problem..."></textarea>

        <button
            class="btn btn-primary"
            onclick="submitTicket()">
            Submit Support Request
        </button>

    </div>

</section>

</main>


<footer>
    AI IT Buddy © 2026 | Student IT Help Desk Prototype
</footer>

</div>


<script>

/* =========================================
   ACCOUNT / LOGIN
========================================= */

function showCreateAccount() {
    document.getElementById("loginForm").style.display = "none";
    document.getElementById("createAccountForm").style.display = "block";
}

function showLogin() {
    document.getElementById("loginForm").style.display = "block";
    document.getElementById("createAccountForm").style.display = "none";
}

function createAccount() {

    let name = document.getElementById("registerName").value.trim();
    let email = document.getElementById("registerEmail").value.trim();
    let password = document.getElementById("registerPassword").value;

    if (!name || !email || !password) {
        alert("Please complete all fields.");
        return;
    }

    let account = {
        name: name,
        email: email,
        password: password
    };

    localStorage.setItem(
        "itBuddyAccount",
        JSON.stringify(account)
    );

    alert("Account created successfully!");

    showLogin();

    document.getElementById("loginEmail").value = email;
}

function login() {

    let email = document.getElementById("loginEmail").value.trim();
    let password = document.getElementById("loginPassword").value;

    let savedAccount =
        JSON.parse(localStorage.getItem("itBuddyAccount"));

    if (!savedAccount) {
        alert("No account found. Please create an account first.");
        return;
    }

    if (
        email === savedAccount.email &&
        password === savedAccount.password
    ) {

        localStorage.setItem("itBuddyLoggedIn", "true");

        showApp();

    } else {

        alert("Incorrect email or password.");

    }
}

function showApp() {

    document.getElementById("loginPage").style.display = "none";
    document.getElementById("app").style.display = "block";

    let account =
        JSON.parse(localStorage.getItem("itBuddyAccount"));

    if (account) {

        document.getElementById("welcomeText").textContent =
            "Welcome, " + account.name + "!";

        document.getElementById("sidebarName").textContent =
            account.name;

        document.getElementById("sidebarEmail").textContent =
            account.email;

        document.getElementById("profileName").textContent =
            account.name;

        document.getElementById("profileEmail").textContent =
            account.email;
    }

    loadTheme();
}

function logout() {

    localStorage.removeItem("itBuddyLoggedIn");

    location.reload();
}


/* =========================================
   AUTO LOGIN
========================================= */

window.onload = function () {

    if (localStorage.getItem("itBuddyLoggedIn") === "true") {
        showApp();
    }

};


/* =========================================
   SIDEBAR
========================================= */

function openSidebar() {

    document.getElementById("sidebar")
        .classList.add("open");

    document.getElementById("sidebarOverlay")
        .classList.add("show");
}

function closeSidebar() {

    document.getElementById("sidebar")
        .classList.remove("open");

    document.getElementById("sidebarOverlay")
        .classList.remove("show");
}


/* =========================================
   PAGE NAVIGATION
========================================= */

function hidePages() {

    document.getElementById("homePage").style.display = "none";
    document.getElementById("assistantPage").style.display = "none";
    document.getElementById("searchPage").style.display = "none";
    document.getElementById("historyPage").style.display = "none";
    document.getElementById("settingsPage").style.display = "none";
    document.getElementById("troubleshootingPage").style.display = "none";
    document.getElementById("contactPage").style.display = "none";
}

function openAssistant() {

    hidePages();

    document.getElementById("assistantPage")
        .style.display = "block";

    closeSidebar();
}

function showSearch() {

    hidePages();

    document.getElementById("searchPage")
        .style.display = "block";

    closeSidebar();

    document.getElementById("searchInput").focus();
}

function showHistory() {

    hidePages();

    document.getElementById("historyPage")
        .style.display = "block";

    displayHistory();

    closeSidebar();
}

function showSettings() {

    hidePages();

    document.getElementById("settingsPage")
        .style.display = "block";

    closeSidebar();
}

function showTroubleshooting() {

    hidePages();

    document.getElementById("troubleshootingPage")
        .style.display = "block";
}

function showContact() {

    hidePages();

    document.getElementById("contactPage")
        .style.display = "block";
}


/* =========================================
   NEW CHAT
========================================= */

function newChat() {

    hidePages();

    document.getElementById("assistantPage")
        .style.display = "block";

    document.getElementById("chatBox").innerHTML = `
        <div class="message bot">
            <div class="bubble">

                <strong>IT Buddy 🤖</strong><br>

                New chat started! 👋<br>

                How can I help you today?

                <div class="reactions">

                    <button onclick="react('👍')">👍</button>
                    <button onclick="react('❤️')">❤️</button>
                    <button onclick="react('😂')">😂</button>
                    <button onclick="react('😕')">😕</button>
                    <button onclick="react('👎')">👎</button>

                </div>

            </div>
        </div>
    `;

    document.getElementById("userInput").value = "";

    closeSidebar();
}


/* =========================================
   THEME
========================================= */

function toggleTheme() {

    document.body.classList.toggle("dark");

    let theme =
        document.body.classList.contains("dark")
        ? "dark"
        : "light";

    localStorage.setItem("itBuddyTheme", theme);
}

function loadTheme() {

    let theme =
        localStorage.getItem("itBuddyTheme");

    if (theme === "dark") {
        document.body.classList.add("dark");
    }
}


/* =========================================
   CHAT
========================================= */

function handleEnter(event) {

    if (event.key === "Enter") {
        sendMessage();
    }
}

function quickMessage(text) {

    document.getElementById("userInput").value = text;

    sendMessage();
}

function sendMessage() {

    let input =
        document.getElementById("userInput");

    let text = input.value.trim();

    if (!text) {
        return;
    }

    addMessage(text, "user");

    input.value = "";

    saveHistory(text);

    showTyping();

    setTimeout(function () {

        removeTyping();

        let response =
            generateResponse(text);

        addMessage(response, "bot");

    }, 800);
}


function addMessage(text, type) {

    let chatBox =
        document.getElementById("chatBox");

    let message =
        document.createElement("div");

    message.className =
        "message " + type;

    let bubble =
        document.createElement("div");

    bubble.className = "bubble";

    if (type === "bot") {

        bubble.innerHTML =
            `<strong>IT Buddy 🤖</strong><br>` +
            formatText(text) +

            `<div class="reactions">

                <button onclick="react('👍')">👍</button>
                <button onclick="react('❤️')">❤️</button>
                <button onclick="react('😂')">😂</button>
                <button onclick="react('😕')">😕</button>
                <button onclick="react('👎')">👎</button>

            </div>`;

    } else {

        bubble.textContent = text;

    }

    message.appendChild(bubble);

    chatBox.appendChild(message);

    chatBox.scrollTop =
        chatBox.scrollHeight;
}


/* =========================================
   BOT RESPONSE
========================================= */

function generateResponse(text) {

    let msg =
        text.toLowerCase();

    if (
        msg.includes("wifi") ||
        msg.includes("wi-fi") ||
        msg.includes("internet")
    ) {

        return `
        Let's troubleshoot your Wi-Fi connection.<br><br>

        1. Make sure Wi-Fi is turned on.<br>
        2. Check if other devices can connect.<br>
        3. Restart your router.<br>
        4. Disconnect and reconnect to the network.<br>
        5. Restart your computer.<br><br>

        If it still doesn't work, you can contact IT support.
        `;

    }

    if (
        msg.includes("slow") ||
        msg.includes("lag")
    ) {

        return `
        If your computer is running slowly, try these steps:<br><br>

        1. Close unnecessary programs.<br>
        2. Restart your computer.<br>
        3. Check your available storage.<br>
        4. Disable unnecessary startup applications.<br>
        5. Run a security scan.
        `;

    }

    if (
        msg.includes("printer") ||
        msg.includes("print")
    ) {

        return `
        Let's check your printer.<br><br>

        1. Make sure the printer is turned on.<br>
        2. Check the USB or Wi-Fi connection.<br>
        3. Check the paper and ink.<br>
        4. Make sure the correct printer is selected.<br>
        5. Restart the printer.
        `;

    }

    if (
        msg.includes("hello") ||
        msg.includes("hi") ||
        msg.includes("hey")
    ) {

        return `
        Hey! 👋 I'm AI IT Buddy.

        I'm ready to help with your IT problems,
        school technology questions, or general questions.
        `;

    }

    if (
        msg.includes("thank")
    ) {

        return `
        You're welcome! 😄

        If you have another IT problem,
        just ask me anytime.
        `;

    }

    if (
        msg.includes("tired") ||
        msg.includes("stress") ||
        msg.includes("stressed")
    ) {

        return `
        Sounds like you've had a lot going on.

        Take a short break if you can. 😌
        When you're ready, I'm here to help with
        your school or IT questions.
        `;

    }

    return `
    I understand your question.

    For this prototype, I can help mainly with
    common IT problems such as Wi-Fi, computers,
    printers, software, and basic troubleshooting.

    Try asking something like:

    "My Wi-Fi is not working."

    or

    "Why is my computer so slow?"
    `;
}


/* =========================================
   FORMAT TEXT
========================================= */

function formatText(text) {

    return text
        .replace(/\n/g, "<br>");
}


/* =========================================
   TYPING
========================================= */

function showTyping() {

    let chatBox =
        document.getElementById("chatBox");

    let typing =
        document.createElement("div");

    typing.id = "typing";
    typing.className = "typing";

    typing.textContent =
        "🤖 IT Buddy is typing...";

    chatBox.appendChild(typing);

    chatBox.scrollTop =
        chatBox.scrollHeight;
}

function removeTyping() {

    let typing =
        document.getElementById("typing");

    if (typing) {
        typing.remove();
    }
}


/* =========================================
   REACTIONS
========================================= */

function react(reaction) {

    alert("You reacted " + reaction);
}


/* =========================================
   CHAT HISTORY
========================================= */

function saveHistory(message) {

    let history =
        JSON.parse(
            localStorage.getItem("itBuddyHistory") || "[]"
        );

    history.unshift({

        message: message,

        date: new Date().toLocaleString()

    });

    /*
       Keep only the latest 30 searches/chats
    */

    history =
        history.slice(0, 30);

    localStorage.setItem(
        "itBuddyHistory",
        JSON.stringify(history)
    );
}


function displayHistory() {

    let list =
        document.getElementById("historyList");

    let history =
        JSON.parse(
            localStorage.getItem("itBuddyHistory") || "[]"
        );

    list.innerHTML = "";

    if (history.length === 0) {

        list.innerHTML = `
            <p class="text-muted">
                No chat history yet.
            </p>
        `;

        return;
    }

    history.forEach(function(item) {

        let div =
            document.createElement("div");

        div.className =
            "history-item";

        div.onclick = function () {

            document.getElementById("userInput").value =
                item.message;

            openAssistant();

        };

        div.innerHTML = `

            <div class="history-title">
                💬 ${escapeHTML(item.message)}
            </div>

            <div class="history-date">
                ${item.date}
            </div>

        `;

        list.appendChild(div);

    });
}


/* =========================================
   SEARCH HISTORY
========================================= */

function searchHistory() {

    let keyword =
        document.getElementById("searchInput")
        .value
        .toLowerCase();

    let history =
        JSON.parse(
            localStorage.getItem("itBuddyHistory") || "[]"
        );

    let results =
        document.getElementById("searchResults");

    results.innerHTML = "";

    let filtered =
        history.filter(function(item) {

            return item.message
                .toLowerCase()
                .includes(keyword);

        });

    if (filtered.length === 0) {

        results.innerHTML = `
            <p class="text-muted">
                No matching conversations found.
            </p>
        `;

        return;
    }

    filtered.forEach(function(item) {

        let div =
            document.createElement("div");

        div.className =
            "history-item";

        div.onclick = function () {

            document.getElementById("userInput").value =
                item.message;

            openAssistant();

        };

        div.innerHTML = `

            <div class="history-title">
                💬 ${escapeHTML(item.message)}
            </div>

            <div class="history-date">
                ${item.date}
            </div>

        `;

        results.appendChild(div);

    });
}


function escapeHTML(text) {

    return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}


/* =========================================
   VOICE SEARCH
========================================= */

function startVoiceSearch() {

    let SpeechRecognition =
        window.SpeechRecognition ||
        window.webkitSpeechRecognition;

    if (!SpeechRecognition) {

        alert(
            "Voice search is not supported in this browser. Try Google Chrome."
        );

        return;
    }

    let recognition =
        new SpeechRecognition();

    recognition.lang = "en-US";

    recognition.interimResults = false;

    recognition.continuous = false;


    recognition.onstart = function () {

        document.getElementById("userInput")
            .placeholder =
            "🎤 Listening...";

    };


    recognition.onresult =
        function(event) {

            let speech =
                event.results[0][0].transcript;

            document.getElementById("userInput")
                .value = speech;

        };


    recognition.onerror =
        function() {

            alert(
                "I couldn't hear you clearly. Please try again."
            );

        };


    recognition.onend =
        function() {

            document.getElementById("userInput")
                .placeholder =
                "Type your IT question...";

        };


    recognition.start();
}


/* =========================================
   SUPPORT TICKET
========================================= */

function submitTicket() {

    let name =
        document.getElementById("issueName")
        .value.trim();

    let email =
        document.getElementById("issueEmail")
        .value.trim();

    let description =
        document.getElementById("issueDescription")
        .value.trim();

    if (!name || !email || !description) {

        alert("Please complete all fields.");

        return;
    }

    let ticket =
        "IT-" +
        Math.floor(
            100000 + Math.random() * 900000
        );

    alert(
        "Support request submitted successfully!\n\n" +
        "Ticket ID: " + ticket
    );

    document.getElementById("issueName").value = "";
    document.getElementById("issueEmail").value = "";
    document.getElementById("issueDescription").value = "";
}

