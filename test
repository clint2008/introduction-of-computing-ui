    <style>

        :root {
            --bg: #f5f7fb;
            --card: #ffffff;
            --text: #212529;
            --muted: #6c757d;
            --primary: #0d6efd;
            --chat: #eef4ff;
        }

        body.dark {
            --bg: #101318;
            --card: #181c23;
            --text: #f1f3f5;
            --muted: #adb5bd;
            --primary: #6ea8fe;
            --chat: #202632;
        }

        body {
            background: var(--bg);
            color: var(--text);
            transition: 0.3s;
        }

        .navbar {
            transition: 0.3s;
        }

        .hero {
            padding: 80px 20px;
            text-align: center;
        }

        .hero h1 {
            font-weight: 800;
        }

        .hero p {
            color: var(--muted);
            max-width: 700px;
            margin: auto;
        }

        .card {
            background: var(--card);
            color: var(--text);
            border: 1px solid rgba(128, 128, 128, 0.2);
        }

        .feature-card {
            height: 100%;
            transition: 0.2s;
        }

        .feature-card:hover {
            transform: translateY(-5px);
        }

        .feature-icon {
            font-size: 35px;
            color: var(--primary);
        }

        /* CHAT */

        .chat-container {
            max-width: 850px;
            margin: auto;
            background: var(--card);
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 10px 35px rgba(0,0,0,0.12);
        }

        .chat-header {
            padding: 18px;
            background: var(--primary);
            color: white;
        }

        #chatBody {
            height: 430px;
            overflow-y: auto;
            padding: 20px;
        }

        .message {
            display: flex;
            margin-bottom: 15px;
        }

        .message.user {
            justify-content: flex-end;
        }

        .bubble {
            max-width: 80%;
            padding: 12px 16px;
            border-radius: 15px;
            line-height: 1.5;
        }

        .message.bot .bubble {
            background: var(--chat);
            color: var(--text);
            border-bottom-left-radius: 4px;
        }

        .message.user .bubble {
            background: var(--primary);
            color: white;
            border-bottom-right-radius: 4px;
        }

        .chat-input-area {
            padding: 15px;
            border-top: 1px solid rgba(128,128,128,0.2);
        }

        /* REACTIONS */

        .reactions {
            margin-top: 10px;
        }

        .reactions button {
            border: 1px solid rgba(128,128,128,0.3);
            background: transparent;
            border-radius: 20px;
            padding: 3px 8px;
            margin-right: 4px;
            cursor: pointer;
            transition: 0.15s;
        }

        .reactions button:hover {
            transform: scale(1.12);
            background: rgba(128,128,128,0.15);
        }

        .reaction-message {
            font-size: 12px;
            margin-top: 5px;
            color: var(--muted);
        }

        .quick-btn {
            margin: 3px;
        }

        .typing {
            font-size: 13px;
            color: var(--muted);
            padding: 8px 15px;
        }

        .mode-badge {
            font-size: 11px;
        }

        .preview-image {
            max-width: 180px;
            max-height: 180px;
            border-radius: 10px;
            margin-top: 10px;
        }

        footer {
            margin-top: 60px;
            padding: 30px;
            text-align: center;
            color: var(--muted);
        }

    </style>
</head>

