/* =========================================================
   QUESTION TYPE
========================================================= */

function detectQuestionType(text) {

    const lower =
        text.toLowerCase();

    if (
        /^(hi|hello|hey|yo|sup|kumusta|kamusta|musta|oy)\b/
        .test(lower)
    ) {

        return "greeting";

    }


    if (
        lower.includes("thank you") ||
        lower.includes("thanks") ||
        lower.includes("salamat")
    ) {

        return "thanks";

    }


    if (
        lower.includes("what is") ||
        lower.includes("what are") ||
        lower.includes("unsa ang") ||
        lower.includes("ano ang")
    ) {

        return "definition";

    }


    if (
        lower.includes("how to") ||
        lower.includes("how do i") ||
        lower.includes("unsaon") ||
        lower.includes("paano")
    ) {

        return "howto";

    }

    return "general";

}


