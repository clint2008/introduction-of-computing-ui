<script>

/* =========================================================
   ACCOUNT
========================================================= */

function showRegister() {

    document.getElementById("loginForm")
        .classList.add("hidden");

    document.getElementById("registerForm")
        .classList.remove("hidden");

}

function showLogin() {

    document.getElementById("registerForm")
        .classList.add("hidden");

    document.getElementById("loginForm")
        .classList.remove("hidden");

}


function createAccount() {

    const username =
        document.getElementById("registerUsername")
        .value.trim();

    const password =
        document.getElementById("registerPassword")
        .value.trim();

    if (!username || !password) {

        alert("Please enter username and password.");
        return;

    }

    localStorage.setItem(
        "aiBuddyUser",
        JSON.stringify({
            username: username,
            password: password
        })
    );

    alert("Account created successfully!");

    showLogin();

}


function loginAccount() {

    const username =
        document.getElementById("loginUsername")
        .value.trim();

    const password =
        document.getElementById("loginPassword")
        .value.trim();

    const saved =
        JSON.parse(
            localStorage.getItem("aiBuddyUser")
        );

    if (
        saved &&
        saved.username === username &&
        saved.password === password
    ) {

        localStorage.setItem(
            "loggedIn",
            "true"
        );

        showDashboard();

    } else {

        alert("Incorrect username or password.");

    }

}


function logout() {

    localStorage.removeItem("loggedIn");

    location.reload();

}


function showDashboard() {

    document.getElementById("authPage")
        .style.display = "none";

    document.getElementById("dashboard")
        .classList.remove("hidden");

    const saved =
        JSON.parse(
            localStorage.getItem("aiBuddyUser")
        );

    if (saved) {

        document.getElementById("profileUsername")
            .textContent = saved.username;

    }

    initializeChat();

}


/* =========================================================
   STARTUP
========================================================= */

window.onload = function () {

    loadTheme();

    if (
        localStorage.getItem("loggedIn")
        === "true"
    ) {

        showDashboard();

    }

};


/* =========================================================
   SIDEBAR
========================================================= */

function toggleSidebar() {

    document.getElementById("sidebar")
        .classList.toggle("active");

    document.getElementById("overlay")
        .classList.toggle("active");

}


function closeSidebar() {

    document.getElementById("sidebar")
        .classList.remove("active");

    document.getElementById("overlay")
        .classList.remove("active");

}


/* =========================================================
   THEME
========================================================= */

function toggleTheme() {

    document.body.classList.toggle("dark");

    const isDark =
        document.body.classList.contains("dark");

    localStorage.setItem(
        "darkMode",
        isDark
    );

    updateThemeText();

}


function updateThemeText() {

    const text =
        document.getElementById("themeText");

    if (!text) return;

    if (
        document.body.classList.contains("dark")
    ) {

        text.textContent = "Light Mode";

    } else {

        text.textContent = "Dark Mode";

    }

}


function loadTheme() {

    if (
        localStorage.getItem("darkMode")
        === "true"
    ) {

        document.body.classList.add("dark");

    }

    updateThemeText();

}


/* =========================================================
   MAIN BOX CONTROL
========================================================= */

function hideMainBoxes() {

    document.getElementById("searchArea")
        .classList.add("hidden");

    document.getElementById("settingsBox")
        .classList.add("hidden");

    document.getElementById("historyBox")
        .classList.add("hidden");

    document.getElementById("supportBox")
        .classList.add("hidden");

    document.getElementById("guideBox")
        .classList.add("hidden");

    document.getElementById("chatContainer")
        .classList.remove("hidden");

}


/* =========================================================
   SEARCH
========================================================= */

function focusSearch() {

    hideMainBoxes();

    document.getElementById("searchArea")
        .classList.remove("hidden");

    document.getElementById("chatContainer")
        .classList.add("hidden");

    closeSidebar();

    document.getElementById("searchInput")
        .focus();

}


function searchChatHistory() {

    const query =
        document.getElementById("searchInput")
        .value
        .toLowerCase()
        .trim();

    const resultBox =
        document.getElementById("searchResults");

    const history =
        JSON.parse(
            localStorage.getItem("chatHistory")
            || "[]"
        );

    if (!query) {

        resultBox.innerHTML =
            "<p class='text-muted'>Type something to search.</p>";

        return;

    }

    const matches =
        history.filter(item =>
            item.user.toLowerCase().includes(query) ||
            item.bot.toLowerCase().includes(query)
        );

    if (matches.length === 0) {

        resultBox.innerHTML =
            "<p class='text-muted'>No matching conversations found.</p>";

        return;

    }

    resultBox.innerHTML =
        matches.map(item => `

        <div class="ticket-box">

            <strong>You:</strong>
            ${formatText(item.user)}

            <br><br>

            <strong>AI IT Buddy:</strong>
            ${formatText(item.bot)}

            <br><br>

            <small class="text-muted">
            ${item.date}
            </small>

        </div>

    `).join("");

}


/* =========================================================
   HISTORY
========================================================= */

function showHistory() {

    hideMainBoxes();

    document.getElementById("historyBox")
        .classList.remove("hidden");

    document.getElementById("chatContainer")
        .classList.add("hidden");

    closeSidebar();

    const history =
        JSON.parse(
            localStorage.getItem("chatHistory")
            || "[]"
        );

    const list =
        document.getElementById("historyList");

    if (history.length === 0) {

        list.innerHTML =
            "No previous conversations yet.";

        return;

    }

    list.innerHTML =
        history.map(item => `

        <div class="ticket-box">

            <strong>You:</strong>
            ${formatText(item.user)}

            <br><br>

            <strong>AI IT Buddy:</strong>
            ${formatText(item.bot)}

            <br><br>

            <small>
            ${item.date}
            </small>

        </div>

    `).join("");

}


/* =========================================================
   NEW CHAT
========================================================= */

function newChat() {

    hideMainBoxes();

    document.getElementById("chatContainer")
        .classList.remove("hidden");

    document.getElementById("chatMessages")
        .innerHTML = "";

    closeSidebar();

    initializeChat();

}


/* =========================================================
   SETTINGS
========================================================= */

function showSettings() {

    hideMainBoxes();

    document.getElementById("settingsBox")
        .classList.remove("hidden");

    document.getElementById("chatContainer")
        .classList.add("hidden");

    closeSidebar();

}


/* =========================================================
   SUPPORT TICKET
========================================================= */

function showSupport() {

    hideMainBoxes();

    document.getElementById("supportBox")
        .classList.remove("hidden");

    document.getElementById("chatContainer")
        .classList.add("hidden");

    closeSidebar();

    displayTickets();

}


function submitTicket() {

    const name =
        document.getElementById("ticketName")
        .value.trim();

    const category =
        document.getElementById("ticketCategory")
        .value;

    const problem =
        document.getElementById("ticketProblem")
        .value.trim();

