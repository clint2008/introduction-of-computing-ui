}


/* =========================================================
   GENERATE RESPONSE
========================================================= */

function generateResponse(text) {

    const topic =
        detectITTopic(text);

    const lower =
        text.toLowerCase();


    /*
       IT questions have priority.
    */

    if (topic) {

        document.getElementById("modeBadge").textContent =
            "IT Support Mode";

        return itResponse(topic, text);

    }


    /*
       Professional / academic AI questions.
    */

    const professional =
        professionalResponse(text);

    if (professional) {

        document.getElementById("modeBadge").textContent =
            "Professional Mode";

        return professional;

    }


    /*
       Detect serious wording.
    */

    if (
        lower.includes("problem") ||
        lower.includes("important") ||
        lower.includes("serious") ||
        lower.includes("help me")
    ) {

        document.getElementById("modeBadge").textContent =
            "Support Mode";

        return seriousResponse(text);

    }


    /*
       Otherwise use general conversation.
    */

    document.getElementById("modeBadge").textContent =
        "General Mode";

    return generalConversation(text);

}


/* =========================================================
   IMAGE PREVIEW
========================================================= */

function previewImage(event) {

    const file =
        event.target.files[0];

    const preview =
        document.getElementById("imagePreview");


    preview.innerHTML = "";


    if (!file) {
        return;
    }


    const image =
        document.createElement("img");

    image.src =
        URL.createObjectURL(file);

    image.className =
        "preview-image";

    preview.appendChild(image);


    addMessage(
        "I received an image. 🖼️ In this prototype, I can display the image, but I cannot actually analyze its contents yet.",
        "bot"
    );

}


