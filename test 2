    /* =========================
       GENERAL
    ========================= */

    body {
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      color: #212529;
      scroll-behavior: smooth;
    }

    section {
      scroll-margin-top: 80px;
    }

    /* =========================
       NAVBAR
    ========================= */

    .navbar {
      background: #0d6efd;
    }

    .navbar-brand {
      font-weight: bold;
    }

    .nav-link {
      color: white !important;
      margin-left: 10px;
    }

    .nav-link:hover {
      color: #dbeafe !important;
    }

    /* =========================
       HERO
    ========================= */

    .hero {
      min-height: 520px;
      display: flex;
      align-items: center;
      background:
        linear-gradient(135deg, #0d6efd 0%, #6610f2 100%);
      color: white;
      padding: 70px 0;
    }

    .hero h1 {
      font-size: 48px;
      font-weight: bold;
    }

    .hero p {
      font-size: 18px;
      max-width: 650px;
    }

    .hero-buttons {
      margin-top: 25px;
    }

    .hero-buttons .btn {
      margin-right: 10px;
      margin-bottom: 10px;
    }

    .hero-icon {
      font-size: 170px;
      text-align: center;
      opacity: 0.9;
    }

    /* =========================
       SECTIONS
    ========================= */

    .section-title {
      text-align: center;
      font-weight: bold;
      margin-bottom: 15px;
    }

    .section-description {
      text-align: center;
      color: #6c757d;
      max-width: 700px;
      margin: auto;
      margin-bottom: 40px;
    }

    /* =========================
       FEATURE CARDS
    ========================= */

    .feature-card {
      background: white;
      border: none;
      border-radius: 18px;
      padding: 30px;
      height: 100%;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.07);
      transition: 0.3s;
    }

    .feature-card:hover {
      transform: translateY(-7px);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    }

    .feature-icon {
      width: 65px;
      height: 65px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #e7f0ff;
      color: #0d6efd;
      font-size: 28px;
      margin-bottom: 20px;
    }

    /* =========================
       AI ASSISTANT
    ========================= */

    .assistant-section {
      background: #eef4ff;
    }

    .chat-container {
      max-width: 900px;
      margin: auto;
      background: white;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 10px 35px rgba(0, 0, 0, 0.1);
    }

    .chat-header {
      background: #0d6efd;
      color: white;
      padding: 20px;
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .bot-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: white;
      color: #0d6efd;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
    }

    .bot-name {
      font-size: 18px;
      font-weight: bold;
    }

    .bot-status {
      font-size: 13px;
      opacity: 0.9;
    }

    .chat-body {
      height: 430px;
      overflow-y: auto;
      padding: 25px;
      background: #f8f9fa;
    }

    .message {
      display: flex;
      margin-bottom: 18px;
    }

    .message.user {
      justify-content: flex-end;
    }

    .message-bubble {
      max-width: 75%;
      padding: 13px 17px;
      border-radius: 18px;
      line-height: 1.5;
    }

    .message.bot .message-bubble {
      background: white;
      border: 1px solid #e9ecef;
      border-bottom-left-radius: 5px;
    }

    .message.user .message-bubble {
      background: #0d6efd;
      color: white;
      border-bottom-right-radius: 5px;
    }

    .message-time {
      display: block;
      font-size: 10px;
      opacity: 0.6;
      margin-top: 5px;
    }

    .chat-input-area {
      padding: 15px;
      background: white;
      border-top: 1px solid #dee2e6;
    }

    .chat-input-area textarea {
      resize: none;
      height: 50px;
    }

    .quick-buttons {
      padding: 12px 15px 0;
      background: white;
    }

    .quick-buttons button {
      margin: 4px;
    }

    /* =========================
       IMAGE PREVIEW
    ========================= */

    .image-preview {
      display: none;
      max-width: 250px;
      max-height: 200px;
      margin-top: 10px;
      border-radius: 10px;
      border: 2px solid #dee2e6;
    }

    /* =========================
       PERSONALITY BADGE
    ========================= */

    .personality-badge {
      display: inline-block;
      background: #e7f0ff;
      color: #0d6efd;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: bold;
      margin-top: 5px;
    }

    /* =========================
       TROUBLESHOOTING
    ========================= */

    .guide-card {
      background: white;
      border-radius: 15px;
      padding: 25px;
      margin-bottom: 20px;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.06);
