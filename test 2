================================================== */

function submitTicket() {

    const problem =
        document.getElementById(
            "ticketProblem"
        ).value.trim();


    const priority =
        document.getElementById(
            "ticketPriority"
        ).value;


    if (!problem) {

        alert(
            "Please describe your problem."
        );

        return;

    }


    const ticketID =
        "IT-" +
        Math.floor(
            100000 + Math.random() * 900000
        );


    document.getElementById(
        "ticketResult"
    ).innerHTML = `

        <div class="alert alert-success">

            <strong>Support request submitted!</strong><br><br>

            Ticket ID:
            <strong>${ticketID}</strong><br>

            Priority:
            <strong>${priority}</strong><br><br>

            Your request has been recorded in this prototype.

        </div>

    `;

}


