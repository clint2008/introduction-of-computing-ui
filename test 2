                 id="profileName">
            </div>

            <div class="profile-email"
                 id="profileEmail">
            </div>

        </div>

    </aside>


    <!-- TOPBAR -->

    <div class="topbar">

        <button
            class="menu-btn"
            onclick="toggleSidebar()">
            ☰
        </button>

        <div class="brand">
            AI <span>IT Buddy</span> 🤖
        </div>

    </div>


    <!-- MAIN CONTENT -->

    <main class="main">

        <!-- HERO -->

        <section class="hero">

            <h1>
                Hello, <span id="welcomeName"></span> 👋
            </h1>

            <p>
                Your student-friendly AI companion for IT support,
                school concerns, everyday questions, and friendly
                conversations.
            </p>

        </section>


        <!-- FEATURES -->

        <section class="row g-3">

            <div class="col-md-4">

                <div class="card-custom">

                    <div class="icon">🤖</div>

                    <h4>AI Assistant</h4>

                    <p>
                        Ask IT questions, school questions,
                        or simply talk with your AI Buddy.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card-custom">

                    <div class="icon">🛠️</div>

                    <h4>IT Troubleshooting</h4>

                    <p>
                        Get step-by-step guidance for common
