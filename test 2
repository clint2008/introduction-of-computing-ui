<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AI IT Buddy | Student IT Help Desk</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<style>
:root {
    --bg: #f5f7fb;
    --card: #ffffff;
    --text: #172033;
    --muted: #6b7280;
    --primary: #4f46e5;
    --secondary: #eef2ff;
    --border: #e5e7eb;
    --sidebar: #ffffff;
    --bot: #eef2ff;
    --user: #4f46e5;
}

body.dark {
    --bg: #10131a;
    --card: #181d27;
    --text: #f3f4f6;
    --muted: #9ca3af;
    --primary: #6366f1;
    --secondary: #252b38;
    --border: #303746;
    --sidebar: #151922;
    --bot: #252b38;
    --user: #4f46e5;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: var(--bg);
    color: var(--text);
    transition: 0.3s;
}

/* =========================
   LOGIN
========================= */

.auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.auth-card {
    width: 100%;
    max-width: 430px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.08);
}

.logo {
    width: 60px;
    height: 60px;
    border-radius: 16px;
    background: var(--primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 25px;
    margin: auto;
}

.auth-card h2 {
    text-align: center;
    margin-top: 15px;
}

.auth-card p {
    text-align: center;
    color: var(--muted);
}

.form-control {
    background: var(--card);
    color: var(--text);
    border-color: var(--border);
}

.form-control:focus {
    background: var(--card);
    color: var(--text);
}

/* =========================
   DASHBOARD
========================= */

#dashboard {
    display: none;
}

.topbar {
    height: 65px;
    display: flex;
    align-items: center;
    padding: 0 20px;
    background: var(--card);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 1000;
}

.menu-btn {
    border: 0;
    background: transparent;
    color: var(--text);
    font-size: 25px;
    cursor: pointer;
}

.brand {
    margin-left: 15px;
    font-weight: bold;
    color: var(--text);
}

.brand span {
    color: var(--primary);
}

.sidebar {
    position: fixed;
    left: -270px;
    top: 0;
    width: 260px;
    height: 100vh;
    background: var(--sidebar);
    border-right: 1px solid var(--border);
    padding: 20px;
    z-index: 2000;
    transition: 0.3s;
    overflow-y: auto;
}

.sidebar.open {
    left: 0;
}

.sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 25px;
}

.sidebar-header h4 {
    margin: 0;
}

.close-sidebar {
    background: transparent;
    border: 0;
    color: var(--text);
    font-size: 24px;
}

.menu-item {
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--text);
    padding: 12px;
    margin-bottom: 6px;
    border-radius: 10px;
    text-align: left;
    cursor: pointer;
}

.menu-item:hover {
    background: var(--secondary);
}

.menu-item span {
    margin-right: 10px;
}

.profile-box {
    margin-top: 25px;
    padding: 15px;
    background: var(--secondary);
    border-radius: 14px;
}

.profile-name {
    font-weight: bold;
}

.profile-email {
    font-size: 12px;
    color: var(--muted);
    word-break: break-word;
}

/* =========================
   MAIN
========================= */

.main {
    padding: 35px 20px;
    max-width: 1200px;
    margin: auto;
}

.hero {
    padding: 35px 10px;
}

.hero h1 {
    font-size: clamp(30px, 5vw, 50px);
    font-weight: 800;
}

.hero h1 span {
    color: var(--primary);
}

.hero p {
    color: var(--muted);
    max-width: 750px;
}

/* =========================
   CARDS
========================= */

.card-custom {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 22px;
    height: 100%;
    transition: 0.2s;
}

.card-custom:hover {
    transform: translateY(-3px);
}

.icon {
    font-size: 30px;
    margin-bottom: 10px;
}

.card-custom p {
    color: var(--muted);
}

/* =========================
   CHAT
========================= */

.chat-container {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    overflow: hidden;
    margin-top: 25px;
}

.chat-header {
    padding: 18px;
    border-bottom: 1px solid var(--border);
}

.chat-header h4 {
    margin: 0;
}

.chat-header small {
    color: var(--muted);
}

.chat-box {
    height: 450px;
    overflow-y: auto;
    padding: 20px;
}

.message-row {
    display: flex;
    margin-bottom: 15px;
}

.message-row.user {
    justify-content: flex-end;
}

.bubble {
    max-width: 80%;
    padding: 12px 15px;
    border-radius: 15px;
    line-height: 1.5;
}

.bot .bubble {
    background: var(--bot);
    color: var(--text);
    border-bottom-left-radius: 4px;
}

.user .bubble {
    background: var(--user);
    color: white;
    border-bottom-right-radius: 4px;
}

.chat-input {
    border-top: 1px solid var(--border);
    padding: 15px;
}

.input-area {
    display: flex;
    gap: 8px;
}

.input-area input {
    flex: 1;
}

.input-area button {
    border-radius: 10px;
}

.quick-buttons {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 10px;
}

.quick-buttons button {
    border: 1px solid var(--border);
    background: var(--secondary);
    color: var(--text);
    border-radius: 20px;
    padding: 6px 12px;
}

/* =========================
   REACTIONS
========================= */

.reactions {
    margin-top: 10px;
}

.reactions button {
    border: 1px solid rgba(128,128,128,0.3);
    background: transparent;
    color: var(--text);
    border-radius: 20px;
    padding: 3px 8px;
    margin-right: 4px;
    cursor: pointer;
    transition: 0.15s;
}

.reactions button:hover {
    transform: scale(1.12);
    background: rgba(128,128,128,0.15);
}

.reaction-message {
    font-size: 12px;
    margin-top: 5px;
    color: var(--muted);
}

/* =========================
   TYPING
========================= */

.typing {
    display: flex;
    gap: 4px;
    padding: 8px;
}

.typing span {
    width: 7px;
    height: 7px;
    background: var(--muted);
    border-radius: 50%;
    animation: blink 1.2s infinite;
}

.typing span:nth-child(2) {
    animation-delay: 0.2s;
}

.typing span:nth-child(3) {
    animation-delay: 0.4s;
}

@keyframes blink {
    0%, 80%, 100% {
        opacity: 0.3;
    }
    40% {
        opacity: 1;
    }
}

/* =========================
   IMAGE
========================= */

.image-preview {
    display: none;
    margin-top: 10px;
}

.image-preview img {
    max-width: 250px;
    max-height: 200px;
    border-radius: 12px;
    border: 1px solid var(--border);
}

/* =========================
   SECTIONS
========================= */

.section {
    margin-top: 70px;
}

.section-title {
    margin-bottom: 25px;
}

.section-title p {
    color: var(--muted);
}

/* =========================
   FOOTER
========================= */

footer {
    margin-top: 80px;
    padding: 30px 20px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    text-align: center;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 600px) {

    .main {
        padding: 20px 12px;
    }

    .chat-box {
        height: 400px;
    }

    .bubble {
        max-width: 90%;
    }

    .hero {
        padding-top: 20px;
    }
}
</style>
</head>

<body>

<!-- ==================================================
     LOGIN PAGE
================================================== -->

<div id="authPage" class="auth-page">

    <div class="auth-card">

        <div class="logo">
            🤖
        </div>

        <h2>AI IT Buddy</h2>

        <p>
            Student-Friendly AI IT Help Desk
        </p>

        <!-- LOGIN -->

        <div id="loginForm">

            <h5 class="mb-3">Login</h5>

            <div class="mb-3">
                <label>Email</label>
                <input
                    type="email"
