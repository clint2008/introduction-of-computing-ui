/* ==================================================
   GENERAL RESPONSE
================================================== */

function generalResponse(text,language){

let t=
text.toLowerCase();


if(
t.includes("thank") ||
t.includes("salamat")
)
return thanksResponse(language);


if(
t.match(/\b(hi|hello|hey|good morning|good afternoon|good evening)\b/)
)
return greetingResponse(language);


if(
t.includes("how are you") ||
t.includes("kumusta ka") ||
t.includes("kumusta")
){

if(language==="bisaya")
return "Okay ra ko! 😄 Ready ko maminaw or motabang. Ikaw, kumusta man imong adlaw?";

if(language==="tagalog")
return "Okay naman ako! 😄 Handa akong makinig o tumulong. Ikaw, kumusta ang araw mo?";

return "I'm doing well! 😄 I'm ready to listen or help. How has your day been?";

}


if(
t.includes("school") ||
t.includes("assignment") ||
t.includes("homework") ||
t.includes("exam") ||
t.includes("quiz") ||
t.includes("project")
){

if(language==="bisaya")
return "Sure, makatabang ko sa school concerns. Unsay subject or assignment? Pwede nimo i-send ang instructions.";

if(language==="tagalog")
return "Sure, makakatulong ako sa school concerns. Anong subject o assignment? Puwede mong i-send ang instructions.";

return "Sure, I can help with school concerns. What subject or assignment are you working on? You can send the instructions.";

}


if(
t.includes("what can you do") ||
t.includes("unsa imong mahimo") ||
t.includes("ano ang kaya mo")
){

return "I can help with common IT troubleshooting, school-related questions, basic technical guidance, support requests, and general conversation. You can also rant about your day if you just need someone to listen.";

}


if(
t.includes("good night") ||
t.includes("goodbye") ||
t.includes("bye")
){

if(language==="bisaya")
return "Goodbye! 👋 Amping, and good luck sa imong school work!";

if(language==="tagalog")
return "Goodbye! 👋 Ingat, at good luck sa school work mo!";

return "Goodbye! 👋 Take care, and good luck with your school work!";

}


return null;

}


