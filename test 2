========================================================= */

function getRecentUserMessages() {

    return conversation
        .filter(item => item.sender === "user")
        .slice(-3)
        .map(item => item.text)
        .join(" ");
}

function hasRecentTopic(topic) {

    return getRecentUserMessages()
        .toLowerCase()
        .includes(topic);
}


