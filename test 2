<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AI IT Help Desk</title>

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet"
    >

    <style>
        body {
            background-color: #f4f7fb;
            font-family: Arial, sans-serif;
        }

        /* NAVBAR */
        .navbar {
            background: #0d6efd;
        }

        .navbar-brand,
        .nav-link {
            color: white !important;
        }

        /* HERO */
        .hero {
            min-height: 430px;
            display: flex;
            align-items: center;
            background: linear-gradient(135deg, #0d6efd, #6f42c1);
            color: white;
        }

        .hero h1 {
            font-size: 45px;
            font-weight: bold;
        }

        .hero p {
            font-size: 18px;
        }

        /* FEATURE CARDS */
        .feature-card {
            transition: 0.3s;
            height: 100%;
        }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.12);
        }

        .feature-icon {
            font-size: 40px;
            color: #0d6efd;
        }

        /* CHAT */
        #chatBox {
            height: 350px;
            overflow-y: auto;
            background: #f8f9fa;
        }

        .message {
            margin-bottom: 12px;
            padding: 10px 14px;
            border-radius: 12px;
            max-width: 80%;
        }

        .user-message {
            background: #0d6efd;
            color: white;
            margin-left: auto;
        }

        .ai-message {
            background: #e9ecef;
            color: #212529;
        }

        /* UPLOADED IMAGE */
        .uploaded-image {
            max-width: 250px;
            max-height: 200px;
            border-radius: 10px;
            margin-top: 5px;
            display: block;
        }

        /* SECTION */
        section {
            padding: 70px 0;
        }

        /* FOOTER */
        footer {
            background: #212529;
            color: white;
            padding: 25px 0;
        }

        /* STATUS */
        .status {
            font-size: 13px;
            color: #198754;
        }
    </style>
</head>

<body>

<!-- =========================
     NAVBAR
========================= -->
<nav class="navbar navbar-expand-lg">
    <div class="container">

        <a class="navbar-brand fw-bold" href="#">
            <i class="bi bi-headset"></i>
            AI IT Help Desk
        </a>

        <button
            class="navbar-toggler bg-light"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">

            <ul class="navbar-nav ms-auto">

                <li class="nav-item">
                    <a class="nav-link" href="#home">Home</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#features">Features</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#assistant">AI Assistant</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#troubleshooting">
                        Troubleshooting
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#contact">
                        IT Support
                    </a>
                </li>

            </ul>

        </div>
    </div>
</nav>


<!-- =========================
     HOME
========================= -->
<section id="home" class="hero">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-md-7">

                <h1>
                    Your Smart IT Help Desk
                </h1>

                <p class="mt-3">
                    Get quick technical assistance using our
                    AI-powered IT Help Desk system.
                </p>

                <a href="#assistant"
                   class="btn btn-light btn-lg mt-3">

                    <i class="bi bi-chat-dots"></i>
                    Ask the AI Assistant

                </a>

            </div>

            <div class="col-md-5 text-center">

                <i class="bi bi-robot"
                   style="font-size: 180px;">
                </i>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     FEATURES
========================= -->
<section id="features">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                IT Help Desk Features
            </h2>

            <p class="text-muted">
                Get assistance with common technical problems.
            </p>

        </div>

        <div class="row g-4">

            <!-- Internet -->
            <div class="col-md-3">

                <div class="card feature-card shadow-sm p-3 text-center">

                    <div class="feature-icon">
                        <i class="bi bi-wifi"></i>
                    </div>

                    <h5 class="mt-3">
                        Internet Problems
                    </h5>

                    <p>
                        Get help with Wi-Fi and internet
                        connection problems.
                    </p>

                    <button
                        class="btn btn-outline-primary"
                        onclick="askProblem('internet')">

                        Get Help

                    </button>

                </div>

            </div>


            <!-- Computer -->
            <div class="col-md-3">

                <div class="card feature-card shadow-sm p-3 text-center">

                    <div class="feature-icon">
                        <i class="bi bi-laptop"></i>
                    </div>

                    <h5 class="mt-3">
                        Computer Problems
                    </h5>

                    <p>
                        Find solutions for slow or
                        unresponsive computers.
                    </p>

                    <button
                        class="btn btn-outline-primary"
                        onclick="askProblem('computer')">

                        Get Help

                    </button>

                </div>

            </div>


            <!-- Software -->
            <div class="col-md-3">

                <div class="card feature-card shadow-sm p-3 text-center">

                    <div class="feature-icon">
                        <i class="bi bi-window"></i>
                    </div>

                    <h5 class="mt-3">
                        Software Errors
                    </h5>

                    <p>
                        Get assistance with application
                        and software errors.
                    </p>

                    <button
                        class="btn btn-outline-primary"
                        onclick="askProblem('software')">

                        Get Help

                    </button>

                </div>

            </div>


            <!-- Printer -->
            <div class="col-md-3">

                <div class="card feature-card shadow-sm p-3 text-center">

                    <div class="feature-icon">
                        <i class="bi bi-printer"></i>
                    </div>

                    <h5 class="mt-3">
                        Printer Problems
                    </h5>

                    <p>
                        Troubleshoot printer and
                        printing problems.
                    </p>

                    <button
                        class="btn btn-outline-primary"
                        onclick="askProblem('printer')">

                        Get Help

                    </button>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     AI ASSISTANT
========================= -->
<section id="assistant" class="bg-light">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card shadow">

                    <div class="card-header bg-primary text-white">

                        <h5 class="mb-0">

                            <i class="bi bi-robot"></i>
                            AI IT Assistant

                        </h5>

                    </div>


                    <!-- CHAT BOX -->
                    <div id="chatBox" class="card-body">

                        <div class="message ai-message">

                            <strong>AI Assistant:</strong><br>

                            Hello! 👋 I'm your IT Help Desk
                            assistant.

                            <br><br>

                            You can ask me about:

                            <ul>
                                <li>Internet problems</li>
                                <li>Computer problems</li>
                                <li>Software errors</li>
                                <li>Printer problems</li>
                                <li>Login problems</li>
                            </ul>

                            You can also upload a screenshot
                            of your technical problem.

                        </div>

                    </div>


                    <!-- INPUT AREA -->
                    <div class="card-footer">

                        <div class="input-group">

                            <!-- TEXT INPUT -->
                            <input
                                type="text"
                                id="userInput"
                                class="form-control"
                                placeholder="Describe your technical problem..."
                                onkeypress="handleEnter(event)"
                            >


                            <!-- IMAGE BUTTON -->
                            <button
                                type="button"
                                class="btn btn-secondary"
                                onclick="document.getElementById('imageInput').click()"
                                title="Upload a picture">

                                <i class="bi bi-image"></i>

                            </button>


                            <!-- SEND BUTTON -->
                            <button
                                type="button"
                                class="btn btn-primary"
                                onclick="sendMessage()">

                                <i class="bi bi-send"></i>
                                Send

                            </button>

                        </div>


                        <!-- HIDDEN FILE INPUT -->
                        <input
                            type="file"
                            id="imageInput"
                            accept="image/*"
                            style="display:none;"
                            onchange="previewImage(event)"
                        >


                        <!-- IMAGE PREVIEW -->
                        <div id="imagePreview" class="mt-3"></div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     TROUBLESHOOTING
========================= -->
<section id="troubleshooting">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                Troubleshooting Guide
            </h2>

            <p class="text-muted">
                Follow these basic steps to solve common IT problems.
            </p>

        </div>


        <div class="accordion" id="troubleshootingAccordion">

            <!-- INTERNET -->
            <div class="accordion-item">

                <h2 class="accordion-header">

                    <button
                        class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#internetGuide">

                        🌐 Internet / Wi-Fi Problem

                    </button>

                </h2>

                <div
                    id="internetGuide"
                    class="accordion-collapse collapse show">

                    <div class="accordion-body">

                        <ol>

                            <li>
                                Check if Wi-Fi is turned on.
                            </li>

                            <li>
                                Make sure you are connected
                                to the correct network.
                            </li>

                            <li>
                                Restart your Wi-Fi connection.
                            </li>

                            <li>
                                Try opening another website.
                            </li>

                            <li>
                                If the problem continues,
                                contact IT Support.
                            </li>

                        </ol>

                    </div>

                </div>

            </div>


            <!-- COMPUTER -->
            <div class="accordion-item">

                <h2 class="accordion-header">

                    <button
                        class="accordion-button collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#computerGuide">

                        💻 Computer Problem

                    </button>

                </h2>

                <div
                    id="computerGuide"
                    class="accordion-collapse collapse">

                    <div class="accordion-body">

                        <ol>

                            <li>
                                Close unnecessary applications.
                            </li>

                            <li>
                                Restart your computer.
                            </li>

                            <li>
                                Check available storage.
                            </li>

                            <li>
                                Update your operating system.
                            </li>

                            <li>
                                Contact IT Support if the
                                problem continues.
                            </li>

                        </ol>

                    </div>

                </div>

            </div>


            <!-- PRINTER -->
            <div class="accordion-item">

                <h2 class="accordion-header">

                    <button
                        class="accordion-button collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#printerGuide">

                        🖨️ Printer Problem

                    </button>

                </h2>

                <div
                    id="printerGuide"
                    class="accordion-collapse collapse">

                    <div class="accordion-body">

                        <ol>

                            <li>
                                Check if the printer is turned on.
                            </li>

                            <li>
                                Check the paper supply.
                            </li>

                            <li>
                                Check the printer connection.
                            </li>

                            <li>
                                Check if the correct printer
                                is selected.
                            </li>

                            <li>
                                Restart the printer.
                            </li>

                        </ol>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     FAQ
========================= -->
