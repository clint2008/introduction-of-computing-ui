    `;
}


/* =========================================================
   SUPPORT TICKET
========================================================= */

function showSupport() {

    document.getElementById("chatArea").innerHTML = `

        <div class="content-card">

            <h3>🎫 Contact IT / Support Ticket</h3>

            <p>
                Submit a basic support request.
            </p>

            <input id="ticketName"
                   class="form-control mb-2"
                   placeholder="Your name">

            <select id="ticketCategory"
                    class="form-select mb-2">

                <option>WiFi / Internet</option>
                <option>Computer</option>
                <option>Printer</option>
                <option>Software</option>
                <option>Account</option>
                <option>Other</option>

            </select>

            <textarea id="ticketProblem"
                      class="form-control mb-2"
                      placeholder="Describe your problem"></textarea>

            <button class="btn btn-primary"
                    onclick="submitTicket()">
                Submit Ticket
            </button>

            <div id="ticketResult" class="mt-3"></div>

        </div>
    `;
}

function submitTicket() {

    const name =
        document.getElementById("ticketName").value.trim();

    const category =
        document.getElementById("ticketCategory").value;

    const problem =
        document.getElementById("ticketProblem").value.trim();

    if (!name || !problem) {

        alert("Please complete the required fields.");

        return;
    }

    const tickets =
        JSON.parse(localStorage.getItem("tickets") || "[]");

    const ticket = {

        id: "IT-" + Date.now(),

        user: currentUser,

        name,

        category,

        problem,

        status: "Submitted",

        date: new Date().toLocaleString()

    };

    tickets.push(ticket);

    localStorage.setItem(
        "tickets",
        JSON.stringify(tickets)
    );

    document.getElementById("ticketResult").innerHTML = `

        <div class="alert alert-success">

            <strong>Ticket submitted!</strong><br>

            Ticket ID: ${ticket.id}<br>

            Status: ${ticket.status}

        </div>
    `;
}


/* =========================================================
   SETTINGS
========================================================= */

function showSettings() {

    const users =
        JSON.parse(localStorage.getItem("users") || "{}");

    const user =
        users[currentUser] || {};

    document.getElementById("chatArea").innerHTML = `

        <div class="content-card">

            <h3>⚙ Settings / Profile</h3>

            <hr>

            <p>
                <strong>Name:</strong>
                ${user.name || "Student"}
            </p>

            <p>
                <strong>Username:</strong>
                ${currentUser}
            </p>

            <p>
                <strong>System:</strong>
                AI IT Buddy
            </p>

            <p>
                <strong>Mode:</strong>
                Student-friendly AI Help Desk
            </p>

            <button class="btn btn-outline-primary"
                    onclick="toggleTheme()">
                Toggle Theme
            </button>

        </div>
    `;
}


/* =========================================================
   DARK / LIGHT MODE
========================================================= */

function toggleTheme() {

    document.body.classList.toggle("dark");

    localStorage.setItem(
        "theme",
        document.body.classList.contains("dark")
            ? "dark"
            : "light"
    );
}

function loadTheme() {

    const theme =
        localStorage.getItem("theme");

    if (theme === "dark") {

        document.body.classList.add("dark");

    } else {

        document.body.classList.remove("dark");
    }
}

</script>

