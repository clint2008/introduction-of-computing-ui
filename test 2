                </button>
            </p>

        </div>

    </div>
</div>


<!-- ==================================================
     DASHBOARD
================================================== -->

<div id="dashboard">

    <!-- SIDEBAR -->

    <aside id="sidebar" class="sidebar">

        <div class="sidebar-header">

            <h4>🤖 AI IT Buddy</h4>

            <button
                class="close-sidebar"
                onclick="toggleSidebar()">
                ×
            </button>

        </div>


        <button
            class="menu-item"
            onclick="focusSearch()">
            <span>🔍</span>
            Search
        </button>


        <button
            class="menu-item"
            onclick="newChat()">
            <span>➕</span>
            New Chat
        </button>


        <button
            class="menu-item"
            onclick="showHistory()">
            <span>🕘</span>
            Search History
        </button>


        <button
            class="menu-item"
            onclick="toggleTheme()">
            <span id="themeIcon">🌙</span>
            <span id="themeText">Dark Mode</span>
        </button>


        <button
            class="menu-item"
            onclick="showSettings()">
            <span>⚙️</span>
            Settings
        </button>


        <button
            class="menu-item"
            onclick="logout()">
            <span>🚪</span>
