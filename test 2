<!-- =====================================================
     TROUBLESHOOTING GUIDE
===================================================== -->

<section id="guide" class="py-5">

  <div class="container">

    <h2 class="section-title">
      Troubleshooting Guide
    </h2>

    <p class="section-description">
      Follow these basic steps for common technical problems.
    </p>


    <!-- INTERNET -->

    <div class="guide-card">

      <h5>
        <i class="bi bi-wifi"></i>
        Internet / Wi-Fi
      </h5>

      <ol>

        <li>
          Check if Wi-Fi is turned on.
        </li>

        <li>
          Check if other devices can connect.
        </li>

        <li>
          Disconnect and reconnect to the Wi-Fi.
        </li>

        <li>
          Restart your router if you are allowed to do so.
        </li>

        <li>
          If the problem continues, contact IT support.
        </li>

      </ol>

    </div>


    <!-- COMPUTER -->

    <div class="guide-card">

      <h5>
        <i class="bi bi-pc-display"></i>
        Slow Computer
      </h5>

      <ol>

        <li>
          Close applications that you are not using.
        </li>

        <li>
          Restart the computer.
        </li>

        <li>
          Check if there are too many programs running.
        </li>

        <li>
          Check available storage space.
        </li>

        <li>
          If the problem continues, ask IT support for assistance.
        </li>

      </ol>

    </div>


    <!-- PRINTER -->

    <div class="guide-card">

      <h5>
        <i class="bi bi-printer"></i>
        Printer Not Printing
      </h5>

      <ol>

        <li>
          Check if the printer is powered on.
        </li>

        <li>
          Check the paper.
        </li>

        <li>
          Check the printer connection.
        </li>

        <li>
          Check whether the correct printer is selected.
        </li>

        <li>
          Try printing again.
        </li>

      </ol>

    </div>


    <!-- SOFTWARE -->

    <div class="guide-card">

      <h5>
        <i class="bi bi-window"></i>
        Software Error
      </h5>

      <ol>

        <li>
          Read the error message carefully.
        </li>

        <li>
          Close and reopen the application.
        </li>

        <li>
          Restart the computer.
        </li>

        <li>
          Check whether the application needs an update.
        </li>

        <li>
          If the error continues, contact IT support.
        </li>

      </ol>

    </div>

  </div>

</section>


