<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI IT Buddy | Student Help Desk</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

:root{
    --bg:#f4f7fb;
    --card:#ffffff;
    --text:#172033;
    --muted:#6b7280;
    --primary:#2563eb;
    --primary2:#4f46e5;
    --border:#e5e7eb;
    --sidebar:#ffffff;
    --user:#2563eb;
    --bot:#eef3f9;
}

body.dark{
    --bg:#0f172a;
    --card:#172033;
    --text:#f1f5f9;
    --muted:#94a3b8;
    --border:#293548;
    --sidebar:#111827;
    --bot:#202c40;
}

*{
    box-sizing:border-box;
}

body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:Arial, Helvetica, sans-serif;
    min-height:100vh;
}

/* =========================
   LOGIN
========================= */

#authPage{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:20px;
    background:linear-gradient(135deg,#2563eb,#4f46e5);
}

.auth-card{
    width:100%;
    max-width:420px;
    background:var(--card);
    padding:30px;
    border-radius:20px;
    box-shadow:0 15px 45px rgba(0,0,0,.2);
}

.auth-logo{
    text-align:center;
    font-size:55px;
    margin-bottom:10px;
}

.auth-title{
    text-align:center;
    font-weight:800;
    margin-bottom:5px;
}

.auth-subtitle{
    text-align:center;
    color:var(--muted);
    margin-bottom:25px;
}

.auth-tabs{
    display:flex;
    margin-bottom:20px;
    border-bottom:1px solid var(--border);
}

.auth-tabs button{
    flex:1;
    border:0;
    background:transparent;
    color:var(--muted);
    padding:10px;
    font-weight:bold;
}

.auth-tabs button.active{
    color:var(--primary);
    border-bottom:3px solid var(--primary);
}

.form-control,
.form-select,
textarea{
    background:var(--card)!important;
    color:var(--text)!important;
    border-color:var(--border)!important;
}

.form-control::placeholder,
textarea::placeholder{
    color:var(--muted);
}

.btn-main{
    background:linear-gradient(135deg,var(--primary),var(--primary2));
    border:0;
    color:white;
    font-weight:bold;
    border-radius:10px;
    padding:11px 18px;
}

.btn-main:hover{
    color:white;
    opacity:.9;
}

/* =========================
   APP
========================= */

#app{
    display:none;
    min-height:100vh;
}

.topbar{
    height:65px;
    background:var(--card);
    border-bottom:1px solid var(--border);
    display:flex;
    align-items:center;
    padding:0 18px;
    position:fixed;
    top:0;
    left:0;
    right:0;
    z-index:1000;
}

.menu-btn{
    border:0;
    background:transparent;
    color:var(--text);
    font-size:27px;
    width:45px;
    height:45px;
    border-radius:10px;
}

.menu-btn:hover{
    background:var(--bot);
}

.brand{
    display:flex;
    align-items:center;
    gap:10px;
    margin-left:5px;
    font-weight:800;
    font-size:18px;
}

.brand-icon{
    width:38px;
    height:38px;
    border-radius:11px;
    background:linear-gradient(135deg,#2563eb,#4f46e5);
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:20px;
}

.online{
    margin-left:auto;
    color:#16a34a;
    font-size:13px;
    font-weight:bold;
}

.main-area{
    padding-top:65px;
    min-height:100vh;
}

.page{
    display:none;
    min-height:calc(100vh - 65px);
    padding:30px;
}

.page.active{
    display:block;
}

/* =========================
   SIDEBAR
========================= */

.sidebar{
    position:fixed;
    top:0;
    left:-320px;
    width:300px;
    height:100vh;
    background:var(--sidebar);
    border-right:1px solid var(--border);
    z-index:2000;
    transition:.25s ease;
    overflow-y:auto;
    box-shadow:10px 0 30px rgba(0,0,0,.12);
}

.sidebar.open{
    left:0;
}

.menu-header{
    height:65px;
    padding:0 20px;
    display:flex;
    align-items:center;
    gap:10px;
    border-bottom:1px solid var(--border);
}

.menu-header-title{
    font-weight:800;
}

.close-menu{
    margin-left:auto;
    border:0;
    background:transparent;
    color:var(--text);
    font-size:25px;
}

.menu-section{
    padding:18px 12px 5px;
    color:var(--muted);
    font-size:11px;
    font-weight:800;
    letter-spacing:1px;
}

.menu-item{
    width:calc(100% - 20px);
    margin:3px 10px;
    padding:12px 14px;
    border:0;
    border-radius:10px;
    background:transparent;
    color:var(--text);
    text-align:left;
    display:flex;
    align-items:center;
    gap:12px;
    font-size:14px;
}

.menu-item:hover{
    background:var(--bot);
}

.menu-item.active{
    background:#e8efff;
    color:var(--primary);
    font-weight:bold;
}

body.dark .menu-item.active{
    background:#202d48;
}

.menu-icon{
    width:25px;
    text-align:center;
    font-size:17px;
}

.menu-profile{
    margin:15px;
    padding:15px;
    border:1px solid var(--border);
    border-radius:14px;
    display:flex;
    align-items:center;
    gap:10px;
}

.avatar-small{
    width:40px;
    height:40px;
    border-radius:50%;
    background:linear-gradient(135deg,#2563eb,#4f46e5);
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:bold;
}

.profile-name{
    font-size:14px;
    font-weight:bold;
}

.profile-role{
    font-size:11px;
    color:var(--muted);
}

.overlay{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.35);
    z-index:1500;
}

.overlay.show{
    display:block;
}

/* =========================
   DASHBOARD
========================= */

.dashboard-wrap{
    max-width:1200px;
    margin:auto;
}

.welcome{
    background:linear-gradient(135deg,#2563eb,#4f46e5);
    color:white;
    padding:30px;
    border-radius:20px;
    margin-bottom:25px;
}

.welcome h1{
    font-size:30px;
    font-weight:800;
}

.welcome p{
    margin:0;
    opacity:.92;
}

.status-pill{
    display:inline-block;
    margin-top:15px;
    background:rgba(255,255,255,.18);
    padding:7px 12px;
    border-radius:20px;
    font-size:12px;
}

.dashboard-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.info-card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:16px;
    padding:22px;
}

.info-card h4{
    font-size:17px;
    font-weight:800;
}

.info-card p{
    color:var(--muted);
    font-size:13px;
}

.big-icon{
    font-size:30px;
    margin-bottom:12px;
}

.quick-actions{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
    margin-top:20px;
}

.quick-action{
    border:1px solid var(--border);
    background:var(--card);
    color:var(--text);
    border-radius:14px;
    padding:18px;
    cursor:pointer;
    text-align:left;
}

.quick-action:hover{
    transform:translateY(-2px);
    border-color:var(--primary);
}

/* =========================
   CHAT
========================= */

.chat-page{
    padding:0!important;
}

.chat-container{
    max-width:950px;
    margin:auto;
    height:calc(100vh - 65px);
    display:flex;
    flex-direction:column;
}

.chat-header{
    padding:18px 20px;
    border-bottom:1px solid var(--border);
    background:var(--card);
}

.chat-header h2{
    font-size:18px;
    margin:0;
    font-weight:800;
}

.chat-header small{
    color:var(--muted);
}

.chat-messages{
    flex:1;
    overflow-y:auto;
    padding:25px 15px 120px;
}

.message-row{
    display:flex;
    margin-bottom:18px;
}

.message-row.user{
    justify-content:flex-end;
}

.message{
    max-width:75%;
    padding:13px 16px;
    border-radius:16px;
    line-height:1.5;
    font-size:14px;
    white-space:pre-wrap;
}

.bot .message{
    background:var(--bot);
    border-bottom-left-radius:5px;
}

.user .message{
    background:var(--user);
    color:white;
    border-bottom-right-radius:5px;
}

/* IMAGE INSIDE CHAT */

.chat-image{
    display:block;
    max-width:280px;
    max-height:280px;
    width:auto;
    height:auto;
    object-fit:contain;
    border-radius:12px;
    margin-bottom:8px;
    cursor:pointer;
}

.user .message:has(.chat-image){
    padding:8px;
}

.image-caption{
    margin-top:6px;
    font-size:13px;
    word-break:break-word;
}

.message-time{
    font-size:10px;
    color:var(--muted);
    margin-top:5px;
}

.reactions{
    margin-top:7px;
    display:flex;
    gap:4px;
}

.reaction-btn{
    border:1px solid var(--border);
    background:var(--card);
    border-radius:20px;
    font-size:12px;
    padding:3px 7px;
    cursor:pointer;
}

.chat-input-area{
    position:fixed;
    bottom:0;
    left:0;
    right:0;
    background:var(--card);
    border-top:1px solid var(--border);
    padding:12px 18px;
    z-index:500;
}

.chat-input-wrap{
    max-width:950px;
    margin:auto;
    display:flex;
    align-items:center;
    gap:8px;
}

.chat-input{
    flex:1;
    min-height:48px;
    max-height:130px;
    resize:none;
    border:1px solid var(--border);
    border-radius:25px;
    padding:13px 17px;
    outline:none;
}

.icon-btn{
    width:45px;
    height:45px;
    border-radius:50%;
    border:1px solid var(--border);
    background:var(--card);
    color:var(--text);
    cursor:pointer;
}

.icon-btn:hover{
    border-color:var(--primary);
    color:var(--primary);
}

.send-btn{
    background:var(--primary);
    color:white;
    border:0;
}

.send-btn:hover{
    color:white;
    opacity:.9;
}

.quick-question-bar{
    max-width:950px;
    margin:0 auto 8px;
    display:flex;
    gap:7px;
    overflow-x:auto;
}

.quick-question{
    white-space:nowrap;
    border:1px solid var(--border);
    background:var(--card);
    color:var(--text);
    border-radius:20px;
    padding:7px 12px;
    font-size:11px;
    cursor:pointer;
}

.typing{
    display:none;
    color:var(--muted);
    font-size:12px;
    padding:5px 15px;
}

/* =========================
   OTHER PAGES
========================= */

.content-container{
    max-width:1050px;
    margin:auto;
}

.page-title{
    font-size:27px;
    font-weight:800;
    margin-bottom:6px;
}

.page-subtitle{
    color:var(--muted);
    margin-bottom:25px;
}

.feature-card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:16px;
    padding:22px;
    margin-bottom:15px;
}

.feature-card h4{
    font-size:18px;
    font-weight:800;
}

.feature-card p{
    color:var(--muted);
}

.search-box{
    position:relative;
    margin-bottom:20px;
}

.search-box input{
    width:100%;
    padding:14px 16px 14px 45px;
    border:1px solid var(--border);
    border-radius:12px;
    background:var(--card);
    color:var(--text);
}

.search-icon{
    position:absolute;
    left:16px;
    top:12px;
}

.history-item{
    background:var(--card);
    border:1px solid var(--border);
    padding:17px;
    border-radius:14px;
    margin-bottom:10px;
    cursor:pointer;
}

.history-item:hover{
    border-color:var(--primary);
}

.history-title{
    font-weight:bold;
}

.history-preview{
    color:var(--muted);
    font-size:13px;
    margin-top:5px;
}

.guide-step{
    display:flex;
    gap:15px;
    padding:16px 0;
    border-bottom:1px solid var(--border);
}

.step-number{
    width:35px;
    height:35px;
    min-width:35px;
    border-radius:50%;
    background:var(--primary);
    color:white;
    display:flex;
    justify-content:center;
    align-items:center;
    font-weight:bold;
}

.ticket-form{
    max-width:700px;
}

.settings-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:18px 0;
    border-bottom:1px solid var(--border);
}

.settings-label{
    font-weight:bold;
}

.settings-description{
    color:var(--muted);
    font-size:12px;
}

.profile-box{
    display:flex;
    align-items:center;
    gap:18px;
    margin-bottom:25px;
}

.avatar-large{
    width:75px;
    height:75px;
    border-radius:50%;
    background:linear-gradient(135deg,#2563eb,#4f46e5);
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:25px;
    font-weight:bold;
}

.image-preview{
    display:none;
    max-width:250px;
    max-height:180px;
    border-radius:12px;
    border:1px solid var(--border);
    margin:10px auto 5px;
    object-fit:contain;
}

.toast-message{
    position:fixed;
    bottom:90px;
    right:20px;
    background:#111827;
    color:white;
    padding:12px 17px;
    border-radius:10px;
    display:none;
    z-index:3000;
    font-size:13px;
}

@media(max-width:800px){

    .dashboard-grid{
        grid-template-columns:1fr;
    }

    .quick-actions{
        grid-template-columns:repeat(2,1fr);
    }

    .page{
        padding:20px 15px;
    }

    .message{
        max-width:88%;
    }

}

@media(max-width:500px){

    .quick-actions{
        grid-template-columns:1fr 1fr;
    }

    .welcome h1{
        font-size:24px;
    }

    .brand span:last-child{
        display:none;
    }

    .chat-input-area{
        padding:8px;
    }

    .chat-image{
        max-width:230px;
        max-height:230px;
    }

}

</style>
</head>

