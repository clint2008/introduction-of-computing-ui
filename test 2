      color: #0d6efd;
      font-weight: bold;
    }

    /* =========================
       FAQ
    ========================= */

    .accordion-button:not(.collapsed) {
      background: #e7f0ff;
      color: #0d6efd;
    }

    /* =========================
       CONTACT
    ========================= */

    .contact-card {
      background: white;
      border-radius: 18px;
      padding: 30px;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.07);
