/* ==================================================
   MAIN RESPONSE ENGINE
================================================== */

function generateResponse(text) {

    const language =
        detectLanguage(text);


    // IMPORTANT:
    // IT detection comes first.

    const itTopic =
        detectITTopic(text);


    if (itTopic) {

        return itResponse(
            itTopic,
            language
        );

    }


    // Then conversational/advice detection.

    const conversational =
        conversationalResponse(
            text,
            language
        );


    if (conversational) {

        return conversational;

    }


    // Existing question detection.

    const questionType =
        detectQuestionType(text);


    if (questionType === "greeting") {

        return greetingResponse(language);

    }


    if (questionType === "thanks") {

        return thanksResponse(language);

    }


    if (
        questionType === "definition" ||
        questionType === "howto"
    ) {

        return `
<strong>AI Buddy 🤖</strong><br>

That's a good question. I can help explain it in a simple way. 😊<br><br>

For a more accurate answer, you can give me a little more context about what you're asking.
`;

    }


    return clarificationResponse(
        language
    );

}


/* ==================================================
   VOICE INPUT
================================================== */

function startVoiceInput() {

    const SpeechRecognition =
        window.SpeechRecognition ||
        window.webkitSpeechRecognition;


    if (!SpeechRecognition) {

        alert(
            "Voice input is not supported by this browser."
        );

        return;

    }


    const recognition =
        new SpeechRecognition();


    recognition.lang = "en-US";

    recognition.interimResults = false;

    recognition.maxAlternatives = 1;


    recognition.onstart = function() {

        alert(
            "Voice input started. Speak now."
        );

    };


    recognition.onresult = function(event) {

        const speech =
            event.results[0][0].transcript;


        document.getElementById(
            "messageInput"
        ).value = speech;

    };


    recognition.onerror = function() {

        alert(
            "Voice input could not be completed."
        );

    };


    recognition.start();

}


/* ==================================================
   IMAGE UPLOAD
================================================== */

function previewImage(event) {

    const file =
        event.target.files[0];


    if (!file) {

        return;

    }


    const reader =
        new FileReader();


    reader.onload = function(e) {

        document.getElementById(
            "previewImage"
        ).src = e.target.result;


        document.getElementById(
            "imagePreview"
        ).style.display = "block";

    };


    reader.readAsDataURL(file);

}


function removeImage() {

    document.getElementById(
        "imageInput"
    ).value = "";


    document.getElementById(
        "imagePreview"
    ).style.display = "none";

}


/* ==================================================
   IMAGE ANALYSIS
================================================== */

function analyzeImage() {

    const image =
        document.getElementById(
            "imageInput"
        ).files[0];


    if (!image) {

        alert("Please upload an image first.");

        return;

    }


    addMessage(
        "I uploaded an image. Can you check it?",
        "user"
    );


    showTyping();


    setTimeout(function() {

        removeTyping();


        addMessage(
            `
I received your image 📷.<br><br>

In this current prototype, I can preview the uploaded image, but true visual understanding requires a vision-capable AI model connected through a backend/API.<br><br>

For the research prototype, this feature demonstrates where image-based IT diagnosis can be integrated.
`,
            "bot"
        );

    }, 800);

}


