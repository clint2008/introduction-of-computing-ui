/* ==================================================
   LANGUAGE DETECTION
================================================== */

function detectLanguage(text){

let t=
text.toLowerCase();


let bisayaWords=[
"ako","ikaw","siya","nako","nimo","niya",
"kapoy","kaayo","unsa","ngano","kay",
"pero","wala","naa","dili","ganahan",
"gusto","tabang","sakit","adlaw",
"problema","lisod","mao","bitaw",
"pirme","gani","gyud","jud","murag"
];


let tagalogWords=[
"ako","ikaw","siya","ko","mo","niya",
"pagod","bakit","ano","hindi","wala",
"gusto","tulong","problema","mahirap",
"araw","salamat","paano","kasi","pero",
"school","aral","nakakainis"
];


let bisayaScore=0;
let tagalogScore=0;


bisayaWords.forEach(word=>{

if(
new RegExp("\\b"+word+"\\b","i")
.test(t)
){

bisayaScore++;

}

});


tagalogWords.forEach(word=>{

if(
new RegExp("\\b"+word+"\\b","i")
.test(t)
){

tagalogScore++;

}

});


let englishScore=
(
t.match(
/\b(the|is|are|my|you|I|it|this|that|can|how|what|why|please|help|problem|school|today|feel)\b/gi
)||[]
).length;


if(
bisayaScore>0 &&
englishScore>0
)
return "mixed-bisaya";


if(
tagalogScore>0 &&
englishScore>0
)
return "mixed-tagalog";


if(
bisayaScore>0 &&
bisayaScore>=tagalogScore
)
return "bisaya";


if(
tagalogScore>0 &&
tagalogScore>bisayaScore
)
return "tagalog";


return "english";

}


