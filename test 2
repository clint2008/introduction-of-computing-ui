            </div>

            <button
                class="btn btn-primary w-100"
                onclick="loginAccount()">
                Login
            </button>

            <p class="mt-3">
                No account?
                <button
                    class="btn btn-link p-0"
                    onclick="showRegister()">
                    Create Account
                </button>
            </p>

        </div>


        <!-- REGISTER -->

        <div id="registerForm" style="display:none;">

            <h5 class="mb-3">Create Account</h5>

            <div class="mb-3">
                <label>Full Name</label>

                <input
                    type="text"
                    id="registerName"
                    class="form-control"
                    placeholder="Enter your name">
            </div>

            <div class="mb-3">
                <label>Email</label>

                <input
                    type="email"
                    id="registerEmail"
                    class="form-control"
                    placeholder="Enter your email">
            </div>

            <div class="mb-3">
                <label>Password</label>

                <input
                    type="password"
                    id="registerPassword"
                    class="form-control"
                    placeholder="Create a password">
            </div>

            <button
                class="btn btn-primary w-100"
                onclick="createAccount()">
                Create Account
            </button>

            <p class="mt-3">
