<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI IT Buddy</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f5f7fb;
    color: #20242b;
}

button {
    cursor: pointer;
}

.hidden {
    display: none !important;
}

/* =========================
   LOGIN
========================= */

#authScreen {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #eef5ff, #f8fbff);
    padding: 20px;
}

.auth-card {
    width: 100%;
    max-width: 420px;
    background: white;
    border-radius: 18px;
    padding: 30px;
    box-shadow: 0 15px 45px rgba(0,0,0,.12);
}

.logo {
    font-size: 30px;
    font-weight: 800;
    color: #0d6efd;
    text-align: center;
}

.subtitle {
    text-align: center;
    color: #777;
    margin-bottom: 25px;
}

.auth-card input {
    margin-bottom: 12px;
}

/* =========================
   APP
========================= */

#app {
    display: none;
    min-height: 100vh;
}

.topbar {
    height: 64px;
    background: white;
    border-bottom: 1px solid #ddd;
    display: flex;
    align-items: center;
    padding: 0 18px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
}

.menu-btn {
    border: none;
    background: transparent;
    font-size: 25px;
    margin-right: 15px;
}

.brand {
    font-weight: bold;
    font-size: 20px;
}

.status {
    color: #198754;
    font-size: 13px;
    margin-left: 10px;
}

.sidebar {
    position: fixed;
    top: 64px;
    left: 0;
    bottom: 0;
    width: 250px;
    background: white;
    border-right: 1px solid #ddd;
    padding: 18px;
    overflow-y: auto;
    z-index: 10;
}

.sidebar button {
    width: 100%;
    border: none;
    background: transparent;
    padding: 11px 13px;
    text-align: left;
    border-radius: 10px;
    margin-bottom: 5px;
}

.sidebar button:hover {
    background: #eef4ff;
}

.sidebar .section-title {
    font-size: 12px;
    color: #888;
    margin: 20px 10px 8px;
    text-transform: uppercase;
    font-weight: bold;
}

.main {
    margin-left: 250px;
    padding-top: 64px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

.chat-area {
    flex: 1;
    max-width: 1000px;
    width: 100%;
    margin: auto;
    padding: 30px 25px 150px;
}

.message {
    display: flex;
    margin-bottom: 18px;
}

.message.user {
    justify-content: flex-end;
}

.bubble {
    max-width: 78%;
    padding: 12px 16px;
    border-radius: 16px;
    line-height: 1.55;
    white-space: pre-wrap;
}

.user .bubble {
    background: #0d6efd;
    color: white;
    border-bottom-right-radius: 5px;
}

.bot .bubble {
    background: white;
    border: 1px solid #e4e7ec;
    border-bottom-left-radius: 5px;
}

.bot-label {
    font-size: 12px;
    color: #777;
    margin-bottom: 5px;
}

.input-area {
    position: fixed;
    left: 250px;
    right: 0;
    bottom: 0;
    background: rgba(255,255,255,.96);
    border-top: 1px solid #ddd;
    padding: 15px 20px;
    z-index: 15;
}

.input-box {
    max-width: 1000px;
    margin: auto;
}

.input-row {
    display: flex;
    gap: 8px;
    align-items: center;
}

#messageInput {
    flex: 1;
    min-height: 46px;
    max-height: 130px;
    resize: none;
}

.icon-btn {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    border: 1px solid #ddd;
    background: white;
}

.send-btn {
    width: 50px;
    height: 45px;
    border: none;
    border-radius: 12px;
    background: #0d6efd;
    color: white;
}

.preview {
    max-width: 180px;
    max-height: 150px;
    border-radius: 10px;
    margin: 8px 0;
    display: none;
}

.quick-actions {
    display: flex;
    gap: 7px;
    overflow-x: auto;
    margin-top: 10px;
}

.quick-actions button {
    white-space: nowrap;
    border: 1px solid #dce2ea;
    background: white;
    border-radius: 20px;
    padding: 7px 13px;
    font-size: 13px;
}

/* typing */

.typing {
    display: flex;
    gap: 5px;
    padding: 12px;
}

.dot {
    width: 7px;
    height: 7px;
    background: #999;
    border-radius: 50%;
    animation: bounce 1s infinite;
}

.dot:nth-child(2) {
    animation-delay: .15s;
}

.dot:nth-child(3) {
    animation-delay: .3s;
}

@keyframes bounce {
    0%,100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
}

/* reactions */

.reactions {
    display: flex;
    gap: 8px;
    margin-top: 5px;
}

.reactions button {
    border: none;
    background: transparent;
    opacity: .65;
}

/* cards */

.content-card {
    background: white;
    border: 1px solid #ddd;
    border-radius: 15px;
    padding: 22px;
    margin-bottom: 15px;
}

/* dark */

body.dark {
    background: #15171c;
    color: #eee;
}

body.dark .topbar,
body.dark .sidebar,
body.dark .input-area,
body.dark .bot .bubble,
body.dark .content-card,
body.dark .quick-actions button,
body.dark .icon-btn {
    background: #202329;
    color: #eee;
    border-color: #353941;
}

body.dark .sidebar button:hover {
    background: #30343b;
}

body.dark .bot .bubble {
    color: #eee;
}

body.dark .bot-label,
body.dark .sidebar .section-title {
    color: #aaa;
}

body.dark #messageInput {
    background: #17191d;
    color: white;
    border-color: #444;
}

/* mobile */

@media(max-width: 768px) {
    .sidebar {
        transform: translateX(-100%);
        transition: .25s;
    }

    .sidebar.open {
        transform: translateX(0);
    }

    .main {
        margin-left: 0;
    }

    .input-area {
        left: 0;
    }

    .bubble {
        max-width: 90%;
    }
}
</style>
</head>

<body>

<!-- =========================
     LOGIN
========================= -->

<div id="authScreen">
    <div class="auth-card">

        <div class="logo">🤖 AI IT Buddy</div>
        <div class="subtitle">
            Your student-friendly AI support buddy
        </div>

        <div id="loginBox">
            <input id="loginUsername" class="form-control" placeholder="Username">
            <input id="loginPassword" type="password" class="form-control" placeholder="Password">

            <button class="btn btn-primary w-100 mt-2" onclick="login()">
                Login
            </button>

            <p class="text-center mt-3 mb-0">
                No account?
                <a href="#" onclick="showRegister()">Create one</a>
            </p>
        </div>

        <div id="registerBox" class="hidden">
            <input id="regName" class="form-control" placeholder="Full name">
            <input id="regUsername" class="form-control" placeholder="Username">
            <input id="regPassword" type="password" class="form-control" placeholder="Password">

            <button class="btn btn-success w-100 mt-2" onclick="register()">
                Create Account
            </button>

            <p class="text-center mt-3 mb-0">
                Already have an account?
                <a href="#" onclick="showLogin()">Login</a>
            </p>
        </div>

    </div>
</div>


<!-- =========================
     APP
========================= -->

<div id="app">

    <!-- TOPBAR -->

    <div class="topbar">
        <button class="menu-btn" onclick="toggleSidebar()">☰</button>

        <div class="brand">
            AI IT Buddy 🤖
        </div>

        <div class="status">
            ● Online
        </div>
    </div>


    <!-- SIDEBAR -->

    <aside id="sidebar" class="sidebar">

        <button onclick="newChat()">➕ New Chat</button>

        <button onclick="focusSearch()">🔎 Search</button>

        <button onclick="showHistory()">🕘 Chat History</button>

        <div class="section-title">Support</div>

        <button onclick="showGuide()">🛠 Troubleshooting Guide</button>

        <button onclick="showSupport()">🎫 Contact IT / Support Ticket</button>

        <div class="section-title">Account</div>

        <button onclick="showSettings()">⚙ Settings</button>

        <button onclick="toggleTheme()">🌙 / ☀ Theme</button>

        <button onclick="logout()">🚪 Logout</button>

    </aside>


    <!-- MAIN -->

    <main class="main">

        <section id="chatArea" class="chat-area"></section>

    </main>


    <!-- INPUT -->

    <div class="input-area">

        <div class="input-box">

            <img id="imagePreview" class="preview">

            <div class="input-row">

                <button class="icon-btn"
                        title="Upload image"
                        onclick="document.getElementById('imageInput').click()">
                    📷
                </button>

                <input type="file"
                       id="imageInput"
                       accept="image/*"
                       hidden
                       onchange="previewImage(event)">

                <textarea
                    id="messageInput"
                    class="form-control"
                    placeholder="Message AI IT Buddy..."
                    rows="1"></textarea>

                <button class="icon-btn"
                        title="Voice input"
                        onclick="startVoiceInput()">
                    🎤
                </button>

                <button class="send-btn"
                        onclick="sendMessage()">
                    ➤
                </button>

            </div>

            <div class="quick-actions">

                <button onclick="quickMessage('My WiFi is not working.')">
                    📶 WiFi Help
                </button>

                <button onclick="quickMessage('My computer is slow.')">
                    💻 Computer
                </button>

                <button onclick="quickMessage('I need help with school.')">
                    🎓 School
                </button>

                <button onclick="quickMessage('I just want to rant.')">
                    💬 Just Rant
                </button>

                <button onclick="quickMessage('I need some advice.')">
                    💡 Advice
                </button>

            </div>

        </div>
    </div>

</div>


<script>

/* =========================================================
   USER / ACCOUNT
========================================================= */

let currentUser = localStorage.getItem("currentUser") || null;

function showRegister() {
    document.getElementById("loginBox").classList.add("hidden");
    document.getElementById("registerBox").classList.remove("hidden");
}

function showLogin() {
    document.getElementById("registerBox").classList.add("hidden");
    document.getElementById("loginBox").classList.remove("hidden");
}

function register() {

    const name = document.getElementById("regName").value.trim();
    const username = document.getElementById("regUsername").value.trim();
    const password = document.getElementById("regPassword").value;

    if (!name || !username || !password) {
        alert("Please complete all fields.");
        return;
    }

    const users = JSON.parse(localStorage.getItem("users") || "{}");

    if (users[username]) {
        alert("Username already exists.");
        return;
    }

    users[username] = {
        name,
        password
    };

    localStorage.setItem("users", JSON.stringify(users));

    alert("Account created successfully.");

    showLogin();
}

function login() {

    const username = document.getElementById("loginUsername").value.trim();
    const password = document.getElementById("loginPassword").value;

    const users = JSON.parse(localStorage.getItem("users") || "{}");

    if (!users[username] || users[username].password !== password) {
        alert("Invalid username or password.");
        return;
    }

    currentUser = username;
    localStorage.setItem("currentUser", username);

    startApp();
}

function logout() {

    localStorage.removeItem("currentUser");

    currentUser = null;

    document.getElementById("app").style.display = "none";
    document.getElementById("authScreen").style.display = "flex";
}

function startApp() {

    document.getElementById("authScreen").style.display = "none";
    document.getElementById("app").style.display = "block";

    loadTheme();
    loadCurrentChat();

    /*
       Important:
       We intentionally DO NOT add the old long
       "You can ask me about..." starter guide.
       The chat starts clean.
    */

}

if (currentUser) {
    startApp();
}


/* =========================================================
   CHAT STATE / MEMORY
========================================================= */

let conversation = [];

let currentImage = null;

let lastIntent = "";
let lastTopic = "";
let lastLanguage = "English";

function loadCurrentChat() {

    conversation = JSON.parse(
        localStorage.getItem("currentChat_" + currentUser) || "[]"
    );

    const chatArea = document.getElementById("chatArea");

    chatArea.innerHTML = "";

    if (conversation.length === 0) {

        addMessage(
            "Hi! I'm AI IT Buddy 🤖\nHow can I help you today?",
            "bot",
            false
        );

    } else {

        conversation.forEach(item => {

            addMessage(
                item.text,
                item.sender,
                false
            );

        });

    }
}

function saveConversation() {

    localStorage.setItem(
        "currentChat_" + currentUser,
        JSON.stringify(conversation)
    );
}

function addMessage(text, sender, save = true) {

    const chatArea = document.getElementById("chatArea");

    const message = document.createElement("div");

    message.className =
        "message " + sender;

    const bubble = document.createElement("div");

    bubble.className = "bubble";

    if (sender === "bot") {

        const label = document.createElement("div");

        label.className = "bot-label";

        label.textContent = "AI IT Buddy";

        bubble.appendChild(label);
    }

    const content = document.createElement("div");

    content.textContent = text;

    bubble.appendChild(content);

    message.appendChild(bubble);

    chatArea.appendChild(message);

    chatArea.scrollTop = chatArea.scrollHeight;

    if (save) {

        conversation.push({
            sender,
            text,
            time: new Date().toISOString()
        });

        saveConversation();
    }

    if (sender === "bot") {
        addReactions(message);
    }
}

function addReactions(message) {

    const reactions = document.createElement("div");

    reactions.className = "reactions";

    ["👍","❤️","😂","😕","👎"].forEach(icon => {

        const button = document.createElement("button");

        button.textContent = icon;

        button.onclick = () => {
            button.style.opacity = "1";
        };

        reactions.appendChild(button);
    });

    message.appendChild(reactions);
}


/* =========================================================
   SEND MESSAGE
========================================================= */

function sendMessage() {

    const input = document.getElementById("messageInput");

    const text = input.value.trim();

    if (!text && !currentImage) return;

    if (text) {
        addMessage(text, "user");
    }

    input.value = "";

    if (currentImage) {

        addMessage(
            "📷 Image received. I'll check what I can determine from the uploaded image.",
            "bot"
        );

        currentImage = null;

        document.getElementById("imagePreview").style.display = "none";

        setTimeout(() => {
            analyzeImage();
        }, 500);

        return;
    }

    showTyping();

    setTimeout(() => {

        removeTyping();

        const response = generateResponse(text);

        addMessage(response, "bot");

    }, 500 + Math.random() * 700);
}

function quickMessage(text) {

    document.getElementById("messageInput").value = text;

    sendMessage();
}


/* =========================================================
   ENTER TO SEND
========================================================= */

document.getElementById("messageInput")
.addEventListener("keydown", function(event) {

    if (event.key === "Enter" && !event.shiftKey) {

        event.preventDefault();

        sendMessage();
    }

});


/* =========================================================
   TYPING INDICATOR
========================================================= */

function showTyping() {

    const chatArea = document.getElementById("chatArea");

    const typing = document.createElement("div");

    typing.id = "typingIndicator";

    typing.className = "message bot";

    typing.innerHTML = `
        <div class="bubble">
            <div class="bot-label">AI IT Buddy</div>
            <div class="typing">
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
            </div>
        </div>
    `;

    chatArea.appendChild(typing);

    chatArea.scrollTop = chatArea.scrollHeight;
}

function removeTyping() {

    const typing = document.getElementById("typingIndicator");

    if (typing) {
        typing.remove();
    }
}


/* =========================================================
   LANGUAGE DETECTION
========================================================= */

function detectLanguage(text) {

    const t = text.toLowerCase();

    const bisayaWords = [
        "ako",
        "ko",
        "nako",
        "nimo",
        "mo",
        "kaayo",
        "kay",
        "unya",
        "wala",
        "naa",
        "dili",
        "di",
        "unsa",
        "ngano",
        "kanang",
        "gani",
        "gyud",
        "jud",
        "buhaton",
        "kapoy",
        "ganahan",
        "gusto",
        "tabang",
        "pwede",
        "sige",
        "lang",
        "karon",
        "adto",
        "diri",
        "sakit",
        "lisod",
        "murag",
        "bitaw",
        "ka",
        "nako",
        "pud"
    ];

    const tagalogWords = [
        "ako",
        "ko",
        "mo",
        "ikaw",
        "hindi",
        "wala",
        "may",
        "mga",
        "ang",
        "ng",
        "na",
        "ito",
        "iyan",
        "bakit",
        "paano",
        "saan",
        "gusto",
        "kailangan",
        "tulong",
        "pagod",
        "masaya",
        "malungkot",
        "problema",
        "araw",
        "ngayon",
        "mamaya",
        "salamat",
        "kasi"
    ];

    let bisayaScore = 0;
    let tagalogScore = 0;

    bisayaWords.forEach(word => {

        if (new RegExp("\\b" + word + "\\b").test(t)) {
            bisayaScore++;
        }

    });

    tagalogWords.forEach(word => {

        if (new RegExp("\\b" + word + "\\b").test(t)) {
            tagalogScore++;
        }

    });

    const englishScore =
        (t.match(/\b(the|is|are|am|my|you|your|what|why|how|help|need|want|feel|school|today|problem|please|can|just)\b/g) || []).length;

    if (
        bisayaScore > 0 &&
        tagalogScore > 0 &&
        englishScore > 0
    ) {
        return "Mixed";
    }

    if (bisayaScore > tagalogScore && bisayaScore > englishScore) {
        return "Bisaya";
    }

    if (tagalogScore > bisayaScore && tagalogScore > englishScore) {
        return "Tagalog";
    }

    if (englishScore > 0) {
        return "English";
    }

    if (bisayaScore > 0) {
        return "Bisaya";
    }

    if (tagalogScore > 0) {
        return "Tagalog";
    }

    return "English";
}


/* =========================================================
   INTENT DETECTION
========================================================= */

function detectQuestionType(text) {

    const t = text.toLowerCase();

    if (
        t.includes("rant") ||
        t.includes("just want to talk") ||
        t.includes("just want to vent") ||
        t.includes("gusto lang ko mag rant") ||
        t.includes("mag rant lang")
    ) {
        return "rant";
    }

    if (
        t.includes("advice") ||
        t.includes("what should i do") ||
        t.includes("unsay buhaton") ||
        t.includes("unsa akong buhaton") ||
        t.includes("anong gagawin ko") ||
        t.includes("ano ang dapat kong gawin")
    ) {
        return "advice";
    }

    if (
        t.includes("thank") ||
        t.includes("salamat") ||
        t.includes("thanks")
    ) {
        return "thanks";
    }

    if (
        /^(hi|hello|hey|yo|good morning|good afternoon|good evening)\b/i.test(t)
    ) {
        return "greeting";
    }

    if (
        t.includes("?") ||
        t.startsWith("how ") ||
        t.startsWith("what ") ||
        t.startsWith("why ") ||
        t.startsWith("can you") ||
        t.startsWith("pwede") ||
        t.startsWith("unsa")
    ) {
        return "question";
    }

    return "conversation";
}


/* =========================================================
   IT TOPIC DETECTION
========================================================= */

function detectITTopic(text) {

    const t = text.toLowerCase();

    if (
        t.includes("wifi") ||
        t.includes("internet") ||
        t.includes("connection") ||
        t.includes("connect")
    ) {
        return "wifi";
    }

    if (
        t.includes("printer") ||
        t.includes("print") ||
        t.includes("printing")
    ) {
        return "printer";
    }

    if (
        t.includes("computer") ||
        t.includes("pc") ||
        t.includes("laptop") ||
        t.includes("slow")
    ) {
        return "computer";
    }

    if (
        t.includes("keyboard") ||
        t.includes("mouse") ||
        t.includes("monitor") ||
        t.includes("screen")
    ) {
        return "hardware";
    }

    if (
        t.includes("virus") ||
        t.includes("malware") ||
        t.includes("hack") ||
        t.includes("security") ||
        t.includes("password")
    ) {
        return "security";
    }

    if (
        t.includes("code") ||
        t.includes("coding") ||
        t.includes("html") ||
        t.includes("css") ||
        t.includes("javascript") ||
        t.includes("programming")
    ) {
        return "programming";
    }

    if (
        t.includes("app") ||
        t.includes("software") ||
        t.includes("install") ||
        t.includes("error")
    ) {
        return "software";
    }

    return "";
}


/* =========================================================
   CONVERSATION TOPIC DETECTION
========================================================= */

function detectConversationTopic(text) {

    const t = text.toLowerCase();

    if (
        t.includes("kapoy") ||
        t.includes("tired") ||
        t.includes("exhausted") ||
        t.includes("pagod") ||
        t.includes("drained")
    ) {
        return "tired";
    }

    if (
        t.includes("sad") ||
        t.includes("malungkot") ||
        t.includes("mingaw") ||
        t.includes("lonely") ||
        t.includes("alone")
    ) {
        return "sad";
    }

    if (
        t.includes("frustrated") ||
        t.includes("frustrated ko") ||
        t.includes("inis") ||
        t.includes("annoyed") ||
        t.includes("irita") ||
        t.includes("fed up")
    ) {
        return "frustrated";
    }

    if (
        t.includes("nervous") ||
        t.includes("nerbyos") ||
        t.includes("kabado") ||
        t.includes("scared") ||
        t.includes("worried") ||
        t.includes("anxious")
    ) {
        return "nervous";
    }

    if (
        t.includes("assignment") ||
        t.includes("exam") ||
        t.includes("quiz") ||
        t.includes("presentation") ||
        t.includes("teacher") ||
        t.includes("school") ||
        t.includes("class") ||
        t.includes("subject")
    ) {
        return "school";
    }

    if (
        t.includes("friend") ||
        t.includes("friendship") ||
        t.includes("kaibigan") ||
        t.includes("barkada")
    ) {
        return "friendship";
    }

    if (
        t.includes("motivation") ||
        t.includes("motivated") ||
        t.includes("give up") ||
        t.includes("walay gana") ||
        t.includes("wala koy gana")
    ) {
        return "motivation";
    }

    if (
        t.includes("overwhelmed") ||
        t.includes("overwhelm") ||
        t.includes("too much") ||
        t.includes("daghan kaayo") ||
        t.includes("sobrang dami")
    ) {
        return "overwhelmed";
    }

    return "general";
}


/* =========================================================
