      "Hello! 😄 Ready when you are. Tell me what IT problem you're dealing with.",

      "Hi there! 🤖 What seems to be the trouble? Hopefully your computer isn't choosing violence today. 😂",

      "Hey! 👋 I'm ready to help. Wi-Fi problems, printer drama, software errors, or something else?"
    ],


    internet: [
      "Got it — looks like we're dealing with an internet problem. 📶 Let's narrow it down first.",

      "Ah, the Wi-Fi is acting suspicious again. 😅 Let's troubleshoot it step by step.",

      "Okay, let's investigate the connection. Is your device connected to Wi-Fi but showing **No Internet**, or can it not connect to the Wi-Fi at all?"
    ],


    computer: [
      "Okay, let's take a look at your computer problem. 💻 What exactly is happening?",

      "Got it. Your computer is giving us trouble. 😅 Tell me what you see on the screen.",

      "Alright, computer troubleshooting mode activated. 🤖 What happened before the problem started?"
    ],


    printer: [
      "Printer problems? Classic. 🖨️😅 Let's get that printer cooperating again.",

      "Okay, let's troubleshoot the printer. Is it powered on and connected?",

      "I see we're having a printer situation. 😭🖨️ Tell me what happens when you try to print."
    ],


    software: [
      "Let's investigate that software problem. 💻 What application are you using?",

      "Got it. Please tell me the exact error message if one appears.",

      "Okay, software troubleshooting time. What were you trying to do when the error appeared?"
    ],


    password: [
      "Let's handle the login problem carefully. 🔐 Are you getting an incorrect-password message, or is the account refusing to let you sign in?",

      "No worries. Login problems happen. 🔐 Tell me exactly what message appears when you try to sign in.",

      "Okay, let's figure out the account issue. Please don't send me your actual password. Just tell me the error message."
    ]

  };


  /* =====================================================
     RANDOM RESPONSE
  ===================================================== */

  function randomResponse(list) {

    let available = list.filter(item => item !== lastResponse);

    if (available.length === 0) {
      available = list;
    }

    let result =
      available[Math.floor(Math.random() * available.length)];

    lastResponse = result;

    return result;
  }


  /* =====================================================
     ADD MESSAGE
  ===================================================== */

  function addMessage(sender, text) {

    const chatBody =
      document.getElementById("chatBody");

    const message =
      document.createElement("div");

    message.classList.add("message");

    if (sender === "user") {

      message.classList.add("user");

    } else {

      message.classList.add("bot");

    }


    const bubble =
      document.createElement("div");

    bubble.classList.add("message-bubble");


    bubble.innerHTML =
      formatText(text);


    const time =
      document.createElement("span");

    time.classList.add("message-time");

    time.textContent =
      sender === "user"
        ? "You"
        : "IT Buddy";


    bubble.appendChild(time);

    message.appendChild(bubble);

    chatBody.appendChild(message);

    chatBody.scrollTop =
      chatBody.scrollHeight;


    chatHistory.push({

      sender: sender,
      message: text

    });

  }


  /* =====================================================
     FORMAT TEXT
  ===================================================== */

  function formatText(text) {

    return text
      .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")
      .replace(/\n/g, "<br>");

  }


  /* =====================================================
     DETECT MODE
  ===================================================== */

  function detectMode(text) {

    const lower =
      text.toLowerCase();


    const seriousWords = [
      "urgent",
      "emergency",
      "deadline",
      "cannot access",
      "can't access",
      "university system",
      "exam",
      "important",
      "critical"
    ];


    const professionalWords = [
      "explain",
      "definition",
      "research",
      "what is",
      "meaning",
      "difference",
      "formal",
      "professional"
    ];


    for (let word of seriousWords) {

      if (lower.includes(word)) {

        return "serious";

      }

    }


    for (let word of professionalWords) {

      if (lower.includes(word)) {

        return "professional";

      }

    }


    return "casual";

  }


  /* =====================================================
     DETECT PROBLEM
  ===================================================== */

  function detectProblem(text) {

    const lower =
      text.toLowerCase();


    if (
      lower.includes("wifi") ||
      lower.includes("wi-fi") ||
      lower.includes("internet") ||
      lower.includes("no connection") ||
      lower.includes("no internet")
    ) {

      return "internet";

    }


    if (
      lower.includes("printer") ||
      lower.includes("printing") ||
      lower.includes("print")
    ) {

      return "printer";

    }


    if (
      lower.includes("software") ||
      lower.includes("application") ||
      lower.includes("app") ||
      lower.includes("error")
    ) {

      return "software";

    }


    if (
      lower.includes("password") ||
      lower.includes("login") ||
      lower.includes("log in") ||
      lower.includes("account")
    ) {

      return "password";

    }


    if (
      lower.includes("computer") ||
      lower.includes("laptop") ||
      lower.includes("pc") ||
      lower.includes("slow") ||
      lower.includes("freeze") ||
      lower.includes("freezing")
    ) {

      return "computer";

    }


    return currentProblem;

  }


  /* =====================================================
     PROFESSIONAL QUESTIONS
  ===================================================== */

  function professionalAnswer(text) {

    const lower =
      text.toLowerCase();


    if (
      lower.includes("dns")
    ) {

      return `
        <strong>DNS</strong> stands for
        <strong>Domain Name System</strong>.

        <br><br>

        DNS translates human-readable domain names,
        such as <strong>google.com</strong>, into IP
        addresses that computers use to communicate.

        <br><br>

        In simple terms, DNS works like an
        <strong>internet contact list</strong>. You remember
        the website name, while DNS helps your device
        find its network address.
      `;

    }


    if (
      lower.includes("nlp") ||
      lower.includes("natural language processing")
    ) {

      return `
        <strong>Natural Language Processing (NLP)</strong>
        is a branch of Artificial Intelligence that
        allows computers to process and understand
        human language.

        <br><br>

        In this research project, NLP can be used to
        help the IT Help Desk understand questions
        written naturally by students.
      `;

    }


    if (
      lower.includes("ai") ||
      lower.includes("artificial intelligence")
    ) {

      return `
        <strong>Artificial Intelligence (AI)</strong>
        refers to computer systems designed to perform
        tasks that normally require human intelligence,
        such as understanding language, recognizing
        patterns, and generating responses.

        <br><br>

        In this project, AI is intended to assist
        students with common technical support questions.
      `;

    }


    if (
      lower.includes("what is") ||
      lower.includes("meaning") ||
      lower.includes("definition")
    ) {

      return `
        I can explain that concept clearly.

        <br><br>

        However, I need the specific IT term or concept
        you want to understand. For example:

        <br><br>

        • DNS<br>
        • NLP<br>
        • IP address<br>
        • Router<br>
        • Firewall<br>
        • Artificial Intelligence
      `;

    }


    return null;

  }


  /* =====================================================
     SERIOUS RESPONSE
  ===================================================== */

  function seriousAnswer(text) {

    return `
      I understand. Since this appears to be important,
      let's handle it carefully.

      <br><br>

      Please provide the <strong>exact error message</strong>
      you are seeing.

      <br><br>

      If possible, you may also upload a screenshot using
      the image button below. Please make sure the screenshot
      does not contain sensitive information such as passwords.
    `;

  }


  /* =====================================================
     INTERNET FOLLOW-UP
  ===================================================== */

  function internetAnswer(text) {

    const lower =
      text.toLowerCase();


    if (
      lower.includes("connected") &&
      (
        lower.includes("no internet") ||
        lower.includes("no internet access")
      )
    ) {

      return `
        Got it. 📶 Your device is connected to Wi-Fi,
        but the internet itself isn't reaching your device.

        <br><br>

        Let's try this:

        <br><br>

        <strong>Step 1:</strong> Turn Wi-Fi off.
        <br>
        <strong>Step 2:</strong> Wait about 10 seconds.
        <br>
        <strong>Step 3:</strong> Turn Wi-Fi back on.
        <br>
        <strong>Step 4:</strong> Try opening a website again.

        <br><br>

        Did that fix it?
      `;

    }


    if (
      lower.includes("can't connect") ||
      lower.includes("cannot connect") ||
      lower.includes("not connecting")
    ) {

      return `
        Okay, so the device can't connect to the Wi-Fi itself.

        <br><br>

        First, check whether the correct Wi-Fi network
        is selected and whether you are entering the
        correct password.

        <br><br>

        If you still can't connect, tell me:

        <br>

        <strong>Does another device connect to the same Wi-Fi?</strong>
      `;

    }


    return randomResponse(responses.internet);

  }


  /* =====================================================
     COMPUTER FOLLOW-UP
  ===================================================== */

  function computerAnswer(text) {

    const lower =
      text.toLowerCase();


    if (
      lower.includes("slow")
    ) {

      return `
        Ah, a slow computer. 🐌💻

        <br><br>

        Let's start with the easy stuff:

        <br><br>

        1. Close programs you're not currently using.
        <br>
        2. Restart the computer.
        <br>
        3. Check whether you have enough storage space.
        <br>
        4. Check if many programs are running at the same time.

        <br><br>

        If it's <strong>still slow after restarting</strong>,
        tell me and we'll move to the next step.
      `;

    }


    if (
      lower.includes("freeze") ||
      lower.includes("freezing") ||
      lower.includes("hang")
    ) {

      return `
        If the computer keeps freezing, let's not panic. 😄

        <br><br>

        First, wait a moment to see whether it responds.
        If it becomes responsive again, save your work.

        <br><br>

        Then tell me whether the freezing happens:

        <br>

        • When opening a specific program
        <br>
        • When browsing the internet
        <br>
        • During startup
        <br>
        • Randomly
      `;

    }


    return randomResponse(responses.computer);

  }


  /* =====================================================
     PRINTER FOLLOW-UP
  ===================================================== */

  function printerAnswer(text) {

    const lower =
      text.toLowerCase();


    if (
      lower.includes("not printing") ||
      lower.includes("won't print") ||
      lower.includes("doesn't print")
    ) {

      return `
        Okay, the printer has decided to ignore our request. 😅🖨️

        <br><br>

        Let's check the basics:

        <br><br>

        1. Is the printer powered on?
        <br>
        2. Is there paper?
        <br>
        3. Is there an error message?
        <br>
        4. Is the correct printer selected?
        <br>
        5. Is the printer connected?

        <br><br>

        Tell me which one seems to be the problem.
      `;

    }


    if (
      lower.includes("offline")
    ) {

      return `
        If the printer says <strong>Offline</strong>,
        check whether the printer is powered on and
        connected to the same network or computer.

        <br><br>

        If it still shows Offline, tell me what device
        you are printing from: <strong>Windows PC,
        laptop, or phone?</strong>
      `;

    }


    return randomResponse(responses.printer);

  }


  /* =====================================================
     SOFTWARE FOLLOW-UP
  ===================================================== */

  function softwareAnswer(text) {

    return `
      Okay, let's troubleshoot the software problem.

      <br><br>

      First, please tell me the <strong>name of the application</strong>
      and the <strong>exact error message</strong> you see.

      <br><br>

      If the application suddenly stopped working,
      you can also try closing it and opening it again.

      <br><br>

      What application is showing the problem?
    `;

  }


  /* =====================================================
     PASSWORD
  ===================================================== */

  function passwordAnswer(text) {

    return `
      For a login or password problem, please don't send
      me your actual password. 🔐

      <br><br>

      Tell me what happens when you try to sign in.

      <br><br>

      For example:

      <br>

      • "Incorrect password"
      <br>
      • "Account locked"
      <br>
      • "Cannot connect to server"
      <br>
      • "Page won't load"

      <br><br>

      The exact error message will help me identify
      the next troubleshooting step.
    `;

  }


  /* =====================================================
     MAIN RESPONSE GENERATOR
  ===================================================== */

  function generateResponse(text) {

    const mode =
      detectMode(text);


    /* PROFESSIONAL */

    if (mode === "professional") {

      const answer =
        professionalAnswer(text);

      if (answer) {

        return answer;

      }

    }


    /* SERIOUS */

    if (mode === "serious") {

      return seriousAnswer(text);

    }


    /* DETECT PROBLEM */

    const detected =
      detectProblem(text);


    if (detected) {

      currentProblem =
        detected;

    }


    /* CONTEXT-BASED ANSWERS */

    if (currentProblem === "internet") {

      return internetAnswer(text);

    }


    if (currentProblem === "computer") {

      return computerAnswer(text);

    }


    if (currentProblem === "printer") {

      return printerAnswer(text);

    }


    if (currentProblem === "software") {

      return softwareAnswer(text);

    }


    if (currentProblem === "password") {

      return passwordAnswer(text);

    }


    /* GREETING */

    const lower =
      text.toLowerCase();


    if (
      lower === "hi" ||
      lower === "hello" ||
      lower === "hey" ||
      lower.includes("good morning") ||
      lower.includes("good afternoon") ||
      lower.includes("good evening")
    ) {

      return randomResponse(responses.greeting);

    }


    /* THANK YOU */

    if (
      lower.includes("thank you") ||
      lower.includes("thanks")
    ) {

      return `
        You're welcome! 😄

        <br><br>

        That's what I'm here for.

        <br><br>

        If another IT problem appears later,
        just call me. I'll be here. 🤖
      `;

    }


    /* YES */

    if (
      lower === "yes" ||
      lower === "yeah" ||
      lower === "yep" ||
      lower === "it worked"
    ) {

      return `
        Nice! 🎉 Glad we got it working.

        <br><br>

        One less IT problem to worry about. 😎

        <br><br>

        Anything else you need help with?
      `;

    }


    /* NO */

    if (
      lower === "no" ||
      lower === "nope" ||
      lower.includes("still not working") ||
      lower.includes("didn't work")
    ) {

      return `
        Okay, no worries. 😅 We haven't defeated
        the problem yet.

        <br><br>

        Tell me what happened after you tried the
        previous step, and I'll guide you to the
        next troubleshooting step.
      `;

    }


    /* HELP */

    if (
      lower.includes("help") ||
      lower.includes("problem")
    ) {

      return `
        Absolutely. 👍 Tell me what's happening.

        <br><br>

        You can say something like:

        <br>

        • "My Wi-Fi is not working"
        <br>
        • "My computer is slow"
        <br>
        • "My printer is offline"
        <br>
        • "I can't log in"
        <br>
        • "What is DNS?"

        <br><br>

        Just explain it in your own words.
        You don't need to use technical terms.
      `;

    }


    /* DEFAULT */

    return `
      Hmm, I don't want to guess and give you the
      wrong troubleshooting step. 🤔

      <br><br>

      Try explaining the problem in your own words.

      <br><br>

      For example:

      <br>

      <em>"My laptop suddenly became very slow."</em>

      <br><br>

      or

      <br>

      <em>"I can connect to Wi-Fi but websites won't open."</em>

      <br><br>

      Tell me what you're seeing and we'll figure it out together. 🤖
    `;

  }


  /* =====================================================
     SEND MESSAGE
  ===================================================== */

  function sendMessage() {

    const input =
      document.getElementById("userInput");

    const text =
      input.value.trim();


    if (text === "") {

      return;

    }


    addMessage("user", text);

    input.value = "";


    /* TYPING MESSAGE */

    const chatBody =
      document.getElementById("chatBody");

    const typing =
      document.createElement("div");

    typing.classList.add("message", "bot");

    typing.id = "typingMessage";


    typing.innerHTML = `

      <div class="message-bubble">

        <span class="typing">
          IT Buddy is thinking... 🤔
        </span>

      </div>

    `;


    chatBody.appendChild(typing);

    chatBody.scrollTop =
      chatBody.scrollHeight;


    /* DELAY MAKES IT FEEL MORE NATURAL */

    setTimeout(function() {

      const typingMessage =
        document.getElementById("typingMessage");

      if (typingMessage) {

        typingMessage.remove();

      }


      const response =
        generateResponse(text);

      addMessage("bot", response);

    }, 700);

  }


  /* =====================================================
     QUICK QUESTION
  ===================================================== */

  function quickQuestion(question) {

    document.getElementById("userInput").value =
      question;

    sendMessage();

    document.getElementById("assistant")
      .scrollIntoView({
        behavior: "smooth"
      });

  }


  /* =====================================================
     FEATURE BUTTON
  ===================================================== */

  function startProblem(problem) {

    let question = "";

    if (problem === "internet") {

      question =
        "My Wi-Fi is not working";

    }

    else if (problem === "computer") {

      question =
        "My computer is very slow";

    }

    else if (problem === "printer") {

      question =
        "My printer is not printing";

    }

    else if (problem === "software") {

      question =
        "I have a software error";

    }


    document.getElementById("userInput").value =
      question;


    document.getElementById("assistant")
      .scrollIntoView({
        behavior: "smooth"
      });


    setTimeout(function() {

      sendMessage();

    }, 400);

  }


  /* =====================================================
     ENTER KEY
  ===================================================== */

  document.getElementById("userInput")
    .addEventListener("keydown", function(event) {

      if (
        event.key === "Enter" &&
        !event.shiftKey
      ) {

        event.preventDefault();

        sendMessage();

      }

    });


  /* =====================================================
     IMAGE UPLOAD
  ===================================================== */

  document.getElementById("imageInput")
    .addEventListener("change", function(event) {

      const file =
        event.target.files[0];


      if (!file) {

        return;

      }


      const preview =
        document.getElementById("imagePreview");


      const reader =
        new FileReader();


      reader.onload =
        function(e) {

          preview.src =
            e.target.result;

          preview.style.display =
            "block";


          addMessage(
            "user",
            "📸 I uploaded a screenshot/image."
          );


          setTimeout(function() {

            addMessage(
              "bot",
              `
              Got it! 📸 I received your image.

              <br><br>

              I can display the screenshot in this
              prototype, but the current version is
              <strong>not connected to an AI vision model</strong>,
              so I can't actually inspect the image yet.

              <br><br>

              If the screenshot contains an error message,
              type the message here and I'll help you
              troubleshoot it.
              `
            );

          }, 700);

        };


      reader.readAsDataURL(file);

    });


  /* =====================================================
     CONTACT SUPPORT
  ===================================================== */

  document.getElementById("supportForm")
    .addEventListener("submit", function(event) {

      event.preventDefault();


      const name =
        document.getElementById("studentName").value;

      const category =
        document.getElementById("problemCategory").value;

      const priority =
        document.getElementById("priority").value;


      const ticketNumber =
        "IT-" +
        Math.floor(
          100000 + Math.random() * 900000
        );


      const result =
        document.getElementById("ticketResult");


      result.style.display =
        "block";


      result.innerHTML = `

        <strong>
          Support Request Submitted! ✅
        </strong>

        <br><br>

        Hello <strong>${name}</strong>.

        <br>

        Your support request has been recorded
        as a prototype ticket.

        <br><br>

        <strong>Ticket ID:</strong>
        ${ticketNumber}

        <br>

        <strong>Category:</strong>
        ${category}

        <br>

        <strong>Priority:</strong>
        ${priority}

        <br>

        <strong>Status:</strong>
        Pending

        <br><br>

        <small>
        Prototype note: this ticket is currently
        displayed only in this browser and is not
        connected to a real IT support database yet.
        </small>

      `;


      document.getElementById("supportForm")
        .reset();


      result.scrollIntoView({
        behavior: "smooth"
      });

    });

</script>


