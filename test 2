function focusSearch() {

    const query = prompt("Search your current chat:");

    if (!query) return;

    const results = conversation.filter(item =>
        item.text.toLowerCase().includes(query.toLowerCase())
    );

    if (results.length === 0) {

        alert("No matching messages found.");

        return;
    }

    alert(
        results
        .map(item => item.sender.toUpperCase() + ": " + item.text)
        .join("\n\n")
    );
}


