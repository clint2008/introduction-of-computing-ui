<script>

/* =====================================================
   AI IT BUDDY
===================================================== */

let chatHistory = [];
let currentProblem = "";
let lastTopic = "";


/* =====================================================
   THEME
===================================================== */

function toggleTheme() {

  document.body.classList.toggle("dark");

  const dark =
    document.body.classList.contains("dark");

  document.getElementById("themeText").textContent =
    dark ? "Light Mode" : "Dark Mode";

  localStorage.setItem("theme", dark ? "dark" : "light");
}


if (localStorage.getItem("theme") === "dark") {

  document.body.classList.add("dark");

  document.getElementById("themeText").textContent =
    "Light Mode";
}


/* =====================================================
   SEND MESSAGE
===================================================== */

function sendMessage() {

  const input =
    document.getElementById("userInput");

  const text =
    input.value.trim();

  if (text === "") return;

  addMessage(text, "user");

  input.value = "";

  chatHistory.push({
    user: text
  });

  showTyping();

  setTimeout(() => {

    removeTyping();

    const response =
      generateResponse(text);

    addMessage(response, "bot");

    chatHistory.push({
      bot: response
    });

  }, 500);

}


/* =====================================================
   ENTER KEY
===================================================== */

function handleEnter(event) {

  if (event.key === "Enter") {
    sendMessage();
  }

}


/* =====================================================
   QUICK MESSAGE
===================================================== */

function quickMessage(text) {

  document.getElementById("userInput").value =
    text;

  sendMessage();

}


/* =====================================================
   ADD MESSAGE
===================================================== */

function addMessage(text, type) {

  const body =
    document.getElementById("chatBody");

  const message =
    document.createElement("div");

  message.className =
    "message " + type;

  const bubble =
    document.createElement("div");

  bubble.className =
    "bubble";

  if (type === "bot") {

    bubble.innerHTML =
      "<strong>IT Buddy 🤖</strong><br>" +
      formatText(text);

  } else {

    bubble.textContent = text;

  }

  message.appendChild(bubble);

  body.appendChild(message);

  body.scrollTop =
    body.scrollHeight;

}


/* =====================================================
   FORMAT TEXT
===================================================== */

function formatText(text) {

  return text
    .replace(/\n/g, "<br>")
    .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");

}


/* =====================================================
   TYPING
===================================================== */

function showTyping() {

  const body =
    document.getElementById("chatBody");

  const typing =
    document.createElement("div");

  typing.id = "typing";

  typing.className =
    "message bot";

  typing.innerHTML = `
    <div class="bubble typing">
      IT Buddy is thinking... 🤔
    </div>
  `;

  body.appendChild(typing);

  body.scrollTop =
    body.scrollHeight;
}


function removeTyping() {

  const typing =
    document.getElementById("typing");

  if (typing) {
    typing.remove();
  }

}


/* =====================================================
   DETECT EMOTION
===================================================== */

function detectEmotion(text) {

  const t =
    text.toLowerCase();

  if (
    /happy|glad|excited|awesome|great|good day|yay|proud|celebrat/.test(t)
  ) {
    return "happy";
  }

  if (
    /sad|unhappy|down|cry|upset|heartbroken/.test(t)
  ) {
    return "sad";
  }

  if (
    /tired|sleepy|exhausted|drained/.test(t)
  ) {
    return "tired";
  }

  if (
    /nervous|anxious|scared|worried|afraid/.test(t)
  ) {
    return "nervous";
  }

  if (
    /stress|stressed|overwhelmed|pressure/.test(t)
  ) {
    return "stressed";
  }

  if (
    /angry|mad|annoyed|irritated/.test(t)
  ) {
    return "angry";
  }

  if (
    /bored|boring|nothing to do/.test(t)
  ) {
    return "bored";
  }

  if (
    /confused|don't understand|dont understand|what does.*mean/.test(t)
  ) {
    return "confused";
  }

  if (
    /thank you|thanks|salamat/.test(t)
  ) {
    return "grateful";
  }

  return null;
}


/* =====================================================
   DETECT CONVERSATION STYLE
===================================================== */

function detectStyle(text) {

  const t =
    text.toLowerCase();

  if (
    /define|definition|explain|research|system|nlp|natural language|algorithm|technical|documentation/.test(t)
  ) {
    return "professional";
  }

  if (
    /deadline|urgent|emergency|important|cannot access|can't access|submission today/.test(t)
  ) {
    return "serious";
  }

  return "friendly";
}


/* =====================================================
   DETECT IT PROBLEM
===================================================== */

function detectITTopic(text) {

  const t =
    text.toLowerCase();

  if (
    /wifi|wi-fi|internet|network|dns|router|connection|no internet/.test(t)
  ) {
    return "internet";
  }

  if (
    /laptop|computer|pc|slow|freezing|freeze|keyboard|mouse|monitor|startup|boot/.test(t)
  ) {
    return "computer";
  }

  if (
    /printer|printing|print|paper|ink/.test(t)
  ) {
    return "printer";
  }

  if (
    /software|application|app|program|error|crash|install|update/.test(t)
  ) {
    return "software";
  }

  if (
    /password|login|log in|account|username|forgot password/.test(t)
  ) {
    return "account";
  }

  return null;
}


/* =====================================================
   GENERAL CONVERSATION
===================================================== */

function generalConversation(text) {

  const t =
    text.toLowerCase();

  const emotion =
    detectEmotion(text);


  /* WHO ARE YOU */

  if (
    /who are you|what are you|your name/.test(t)
  ) {

    return `I'm **IT Buddy** 🤖 — your student-friendly AI Help Desk companion.

My main job is helping with IT problems like Wi-Fi, computers, printers, software, and accounts.

But I'm also designed for normal conversation. So you can talk to me about school, your day, stress, boredom, or random things too. 😄`;

  }


  /* WHAT CAN YOU DO */

  if (
    /what can you do|help me|how can you help/.test(t)
  ) {

    return `A lot, actually. 😎

💻 **IT Support** — Wi-Fi, computers, printers, software and accounts.

🧠 **Simple Explanations** — I can explain technical terms in easier language.

💬 **Conversation** — You can talk to me about normal student life.

😊 **Supportive Responses** — If you're tired, nervous, stressed, happy, or confused, I can respond accordingly.

📸 **Screenshot Upload** — You can send an image related to your IT problem.

🎫 **IT Support Request** — If the problem needs a real IT staff member, you can submit a support ticket.`;

  }


  /* JOKE */

  if (
    /tell me a joke|make me laugh|joke/.test(t)
  ) {

    const jokes = [

      "Why did the computer go to the doctor? Because it had a virus. 😂💻",

      "Why was the computer cold? It left its Windows open. 😭🪟",

      "I told my laptop I needed a break... now it won't stop showing me loading screens. 😂",

      "Why don't programmers like nature? It has too many bugs. 🐛😂"

    ];

    return jokes[
      Math.floor(Math.random() * jokes.length)
    ];

  }


  /* GREETING */

  if (
    /^(hi|hello|hey|hii|helo|good morning|good afternoon|good evening)/.test(t)
  ) {

    return `Heyyy! 👋😎

I'm IT Buddy.

What's up? Got an IT problem, need help with school stuff, or are we just here to talk for a while? 😂`;

  }


  /* HAPPY */

  if (emotion === "happy") {

    return `That's nice to hear! 😄🎉

You sound like you're having a pretty good day.

What's making you happy today?`;

  }


  /* SAD */

  if (emotion === "sad") {

    return `I'm sorry you're having a difficult moment. 😔

You don't have to explain everything if you don't want to.

If you feel like talking about what happened, I'm here to listen and help you think through it.`;

  }


  /* TIRED */

  if (emotion === "tired") {

    return `Sounds like you're running on low battery today. 🔋😴

If you can, give yourself a short break, drink some water, and rest for a bit.

Is it schoolwork that's making you tired, or just one of those exhausting days?`;

  }


  /* NERVOUS */

  if (emotion === "nervous") {

    return `It's understandable to feel nervous. 😌

Sometimes the best thing is to break the problem into smaller steps instead of thinking about everything at once.

What's making you nervous right now?`;

  }


  /* STRESSED */

  if (emotion === "stressed") {

    return `That sounds like a lot to handle. 😮‍💨

Let's slow it down and deal with one thing at a time.

What's the biggest thing bothering you right now?`;

  }


  /* ANGRY */

  if (emotion === "angry") {

    return `Yeah, that sounds frustrating. 😤

Before we try to solve it, take a moment to breathe.

Tell me what happened, and we can work through it step by step.`;

  }


  /* BORED */

  if (emotion === "bored") {

    return `Bored, huh? 😭

We could:

🎮 Talk about games  
😂 Exchange jokes  
💻 Do a quick IT challenge  
🧠 Try a programming question  
💬 Just have a random conversation

Pick one. 😎`;

  }


  /* CONFUSED */

  if (emotion === "confused") {

    return `No worries. We can make it simpler. 👍

Tell me what part is confusing you, and I'll explain it step by step without using complicated words.`;

  }


  /* GRATITUDE */

  if (emotion === "grateful") {

    return `You're welcome! 😄

That's what I'm here for.

And yes, I'll take that as one imaginary point for the IT Buddy team. 😂🤖`;

  }


  /* SCHOOL */

  if (
    /school|class|teacher|assignment|homework|exam|quiz|project/.test(t)
  ) {

    return `Ah, school mode. 🎓

Tell me what you're working on and I'll try to help.

If it's an IT-related assignment, we can also work through the technical part together.`;

  }


  /* DEFAULT GENERAL */

  return `I got you. 😄

Tell me a little more about what's going on.

It can be an IT problem, school problem, or just something you want to talk about.

No need to make it complicated. Just tell me what's on your mind.`;

}


/* =====================================================
   IT RESPONSES
===================================================== */

function itResponse(topic, text) {

  lastTopic =
    topic;

  currentProblem =
    text;


  if (topic === "internet") {

    return `Got it — we're dealing with an **internet/Wi-Fi problem**. 📶

Let's troubleshoot it step by step.

**First:** are other devices, such as your phone, able to connect to the same Wi-Fi?

👉 If **yes**, the problem may be with your computer.

👉 If **no**, the problem may be with the Wi-Fi/router or network itself.

Tell me what happens when you try to connect.`;

  }


  if (topic === "computer") {

    return `Okay, let's check your computer. 💻

You said:

**"${text}"**

First, tell me what you see:

1. Is the computer still responding?
2. Is it just slow?
3. Does it freeze?
4. Does it show an error?

Give me what you see on the screen and we'll go from there.`;

  }


  if (topic === "printer") {

    return `Alright, printer trouble. 🖨️😭

Let's check the basics first:

1. Is the printer powered on?
2. Is it connected to the computer or Wi-Fi?
3. Does the printer show any error message?
4. Is there something stuck in the print queue?

Tell me which one seems to be the problem.`;

  }


  if (topic === "software") {

    return `Okay, let's investigate the software problem. 🛠️

What application or program is causing the problem?

Also tell me what happens when you open it.

For example:

**"The app won't open."**

or

**"It opens but then crashes."**

That will help me narrow down the possible cause.`;

  }


  if (topic === "account") {

    return `Okay, let's handle the account/login problem. 🔐

What exactly is happening?

For example:

• Forgot password  
• Wrong password message  
• Account locked  
• Username not recognized  
• Login page won't open

Don't send me your actual password. Just tell me the error or problem you're seeing.`;

  }

}


/* =====================================================
   MAIN RESPONSE ENGINE
===================================================== */

function generateResponse(text) {

  const style =
    detectStyle(text);

  const topic =
    detectITTopic(text);


  /* IT HAS PRIORITY */

  if (topic) {

    document.getElementById("modeBadge").textContent =
      "IT Help Desk Mode 💻";

    return itResponse(topic, text);

  }


  /* PROFESSIONAL */

  if (style === "professional") {

    document.getElementById("modeBadge").textContent =
      "Professional Mode 🎓";

    return professionalResponse(text);

  }


  /* SERIOUS */

  if (style === "serious") {

    document.getElementById("modeBadge").textContent =
      "Priority Support Mode ⚠️";

    return seriousResponse(text);

  }


  /* GENERAL */

  document.getElementById("modeBadge").textContent =
    "Friendly Conversation Mode 😊";

  return generalConversation(text);

}


/* =====================================================
   PROFESSIONAL RESPONSE
===================================================== */

function professionalResponse(text) {

  const t =
    text.toLowerCase();

  if (
    /nlp|natural language/.test(t)
  ) {

    return `**Natural Language Processing (NLP)** is a branch of artificial intelligence that allows computers to understand, process, and respond to human language.

In this project, NLP is relevant because students can describe technical problems using ordinary language instead of following a strict command format.

For example:

**Student:** "My laptop cannot connect to Wi-Fi."

The system can identify that the message is related to an **internet connectivity problem** and provide appropriate troubleshooting steps.`;

  }


  if (
    /ai|artificial intelligence/.test(t)
  ) {

    return `**Artificial Intelligence (AI)** refers to computer systems designed to perform tasks that normally require human-like intelligence, such as understanding information, recognizing patterns, making decisions, and generating responses.

For this research project, AI is used as the foundation of the student IT Help Desk assistant.`;

  }


  return `That's a technical question. 🎓

I'll keep the explanation professional and simple.

Could you give me the specific term, concept, or problem you want me to explain?`;

}


