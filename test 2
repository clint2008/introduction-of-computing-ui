<!-- =========================
     AI HELP SECTION
========================= -->
<section id="help" class="py-5 bg-light">

    <div class="container">

        <div class="text-center mb-4">

            <h2 class="fw-bold">
                <i class="bi bi-robot"></i>
                AI IT Assistant
            </h2>

            <p class="text-muted">
                Describe your technical problem using your own words.
            </p>

        </div>


        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card shadow">

                    <div class="card-header bg-dark text-white">

                        <i class="bi bi-headset"></i>
                        IT Help Desk Assistant

                    </div>


                    <!-- CHAT AREA -->
                    <div id="chatBox"
                         class="card-body"
                         style="height: 350px; overflow-y: auto;">

                        <div class="alert alert-primary">

                            <strong>IT Assistant:</strong>

                            <br>

                            Hello! I'm your IT Help Desk Assistant.
                            What technical problem are you experiencing?

                        </div>

                    </div>


                    <!-- INPUT -->
                    <div class="card-footer">

                        <div class="input-group">

                            <input type="text"
                                   id="userInput"
                                   class="form-control"
                                   placeholder="Example: My internet is not working...">

                            <button class="btn btn-primary"
                                    onclick="sendMessage()">

                                <i class="bi bi-send"></i>
                                Send

                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     TROUBLESHOOTING GUIDE
========================= -->
<section class="py-5">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                Basic Troubleshooting Guide
            </h2>

            <p class="text-muted">
                Follow these basic steps before requesting additional IT support.
            </p>

        </div>


        <div class="accordion" id="troubleshootingAccordion">


            <!-- INTERNET -->
            <div class="accordion-item">

                <h2 class="accordion-header">

                    <button class="accordion-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#internetGuide">

                        <i class="bi bi-wifi me-2"></i>
                        Internet Connection

                    </button>

                </h2>

                <div id="internetGuide"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#troubleshootingAccordion">

                    <div class="accordion-body">

                        <ol>

                            <li>Check if Wi-Fi is turned on.</li>

                            <li>Check if other devices can connect.</li>

                            <li>Disconnect and reconnect to the network.</li>

                            <li>Restart the router if you have access to it.</li>

                            <li>Try opening another website.</li>

                        </ol>

                    </div>

                </div>

            </div>


            <!-- COMPUTER -->
            <div class="accordion-item">

                <h2 class="accordion-header">

                    <button class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#computerGuide">

                        <i class="bi bi-pc-display me-2"></i>
                        Computer Performance

                    </button>

                </h2>

                <div id="computerGuide"
                     class="accordion-collapse collapse"
                     data-bs-parent="#troubleshootingAccordion">

                    <div class="accordion-body">

                        <ol>

                            <li>Close applications you are not using.</li>

                            <li>Restart the computer.</li>

                            <li>Check available storage space.</li>

                            <li>Make sure your operating system is updated.</li>

                            <li>If the problem continues, contact IT support.</li>

                        </ol>

                    </div>

                </div>

            </div>


            <!-- SOFTWARE -->
            <div class="accordion-item">

                <h2 class="accordion-header">

                    <button class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#softwareGuide">

                        <i class="bi bi-window-stack me-2"></i>
                        Software Problems

                    </button>

                </h2>

                <div id="softwareGuide"
                     class="accordion-collapse collapse"
                     data-bs-parent="#troubleshootingAccordion">

                    <div class="accordion-body">

                        <ol>

                            <li>Close and reopen the application.</li>

                            <li>Restart your computer.</li>

                            <li>Check if the application needs an update.</li>

                            <li>Check your internet connection if required.</li>

                            <li>Contact IT support if the error continues.</li>

                        </ol>

                    </div>

                </div>

            </div>


            <!-- PRINTER -->
            <div class="accordion-item">

                <h2 class="accordion-header">

                    <button class="accordion-button collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#printerGuide">

                        <i class="bi bi-printer me-2"></i>
                        Printer Problems

                    </button>

                </h2>

                <div id="printerGuide"
                     class="accordion-collapse collapse"
                     data-bs-parent="#troubleshootingAccordion">

                    <div class="accordion-body">

                        <ol>

                            <li>Check if the printer is turned on.</li>

                            <li>Check the paper and ink.</li>

                            <li>Check the printer connection.</li>

                            <li>Make sure the correct printer is selected.</li>

                            <li>Try printing again.</li>

                        </ol>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


