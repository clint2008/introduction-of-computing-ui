  <style>
    :root {
      --bg: #f4f7fb;
      --card: #ffffff;
      --text: #1f2937;
      --muted: #6b7280;
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --chat-user: #2563eb;
      --chat-bot: #e9eef7;
      --border: #dbe3ef;
    }

    body.dark {
      --bg: #111827;
      --card: #1f2937;
      --text: #f3f4f6;
      --muted: #9ca3af;
      --primary: #60a5fa;
      --primary-dark: #3b82f6;
      --chat-user: #2563eb;
      --chat-bot: #374151;
      --border: #374151;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: Arial, sans-serif;
      transition: 0.3s;
    }

    .navbar {
      background: var(--card) !important;
      border-bottom: 1px solid var(--border);
    }

    .navbar-brand,
    .nav-link {
      color: var(--text) !important;
    }

    .hero {
      min-height: 500px;
      display: flex;
      align-items: center;
      background:
        linear-gradient(135deg, rgba(37,99,235,0.12), transparent),
        var(--bg);
    }

    .hero h1 {
      font-size: 3rem;
      font-weight: 800;
    }

    .hero span {
      color: var(--primary);
    }

    .section {
      padding: 70px 0;
    }

    .card-custom {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 25px;
      height: 100%;
      transition: 0.25s;
    }

    .card-custom:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 30px rgba(0,0,0,0.08);
    }

    .feature-icon {
      width: 55px;
      height: 55px;
      border-radius: 15px;
      background: rgba(37,99,235,0.12);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 25px;
      margin-bottom: 15px;
    }

    .chat-container {
      max-width: 900px;
      margin: auto;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 22px;
      overflow: hidden;
      box-shadow: 0 10px 35px rgba(0,0,0,0.08);
    }

    .chat-header {
      background: linear-gradient(135deg, #2563eb, #4f46e5);
      color: white;
      padding: 20px;
    }

    .bot-status {
      font-size: 13px;
      opacity: 0.9;
    }

    .chat-body {
      height: 450px;
      overflow-y: auto;
      padding: 20px;
      background: var(--bg);
    }

    .message {
      display: flex;
      margin-bottom: 15px;
    }

    .message.user {
      justify-content: flex-end;
    }

    .bubble {
      max-width: 75%;
      padding: 13px 16px;
      border-radius: 18px;
      line-height: 1.5;
    }

    .bot .bubble {
      background: var(--chat-bot);
      color: var(--text);
      border-bottom-left-radius: 5px;
    }

    .user .bubble {
      background: var(--chat-user);
      color: white;
      border-bottom-right-radius: 5px;
    }

    .chat-input-area {
      padding: 15px;
      border-top: 1px solid var(--border);
      background: var(--card);
    }

    .chat-input-area input {
      background: var(--bg);
      color: var(--text);
      border: 1px solid var(--border);
    }

    .chat-input-area input::placeholder {
      color: var(--muted);
    }

    .quick-buttons {
      padding: 10px 15px 0;
      background: var(--card);
    }

    .quick-buttons button {
      margin: 4px;
      border-radius: 20px;
    }

    .preview {
      max-width: 180px;
      max-height: 150px;
      border-radius: 12px;
      margin-top: 10px;
      display: none;
    }

    .ticket {
      display: none;
      margin-top: 20px;
      padding: 20px;
      border-radius: 15px;
      background: rgba(34,197,94,0.12);
      border: 1px solid rgba(34,197,94,0.4);
    }

    footer {
      background: #0f172a;
      color: white;
      padding: 30px 0;
    }

    body.dark .accordion-button {
      background: var(--card);
      color: var(--text);
    }

    body.dark .accordion-item {
      background: var(--card);
      color: var(--text);
      border-color: var(--border);
    }

    body.dark .form-control,
    body.dark .form-select {
      background: #111827;
      color: white;
      border-color: var(--border);
    }

    .mode-badge {
      display: inline-block;
      font-size: 12px;
      padding: 5px 10px;
      border-radius: 20px;
      background: rgba(255,255,255,0.2);
      margin-top: 5px;
