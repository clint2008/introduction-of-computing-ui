<!-- =========================
     CONTACT IT SUPPORT
========================= -->
<section id="contact">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-7">

                <div class="card shadow">

                    <div class="card-body p-4">

                        <div class="text-center mb-4">

                            <h2>
