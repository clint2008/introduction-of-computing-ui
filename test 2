function initializeChat() {

    const saved =
        JSON.parse(
            localStorage.getItem("itBuddyChat")
        ) || [];


    if (saved.length === 0) {

        addMessage(
            "Hello! 👋 I'm AI IT Buddy. You can ask me about IT problems, school concerns, or even just talk to me. Pwede English, Bisaya, Tagalog, or mix. 😊",
            "bot"
        );

    } else {

        saved.forEach(function(message) {

            addMessage(
                message.text,
                message.type,
                false
            );

        });

    }

}


function saveChat(text, type) {

    let chat =
        JSON.parse(
            localStorage.getItem("itBuddyChat")
        ) || [];


    chat.push({
        text: text,
        type: type
    });


    chat =
        chat.slice(-50);


    localStorage.setItem(
        "itBuddyChat",
        JSON.stringify(chat)
    );

}


function addMessage(text, type, save = true) {

    const chatBox =
        document.getElementById("chatBox");


    const row =
        document.createElement("div");


    row.className =
        "message-row " + type;


    const bubble =
        document.createElement("div");


    bubble.className =
        "bubble";


    if (type === "bot") {

        bubble.innerHTML =
            `<strong>IT Buddy 🤖</strong><br>` +
            formatText(text) +

            `<div class="reactions">

                <button onclick="react(this, '👍')">
                    👍
                </button>

                <button onclick="react(this, '❤️')">
                    ❤️
                </button>

                <button onclick="react(this, '😂')">
                    😂
                </button>

                <button onclick="react(this, '😕')">
                    😕
                </button>

                <button onclick="react(this, '👎')">
                    👎
                </button>

            </div>`;

    } else {

        bubble.textContent = text;

    }


    row.appendChild(bubble);

    chatBox.appendChild(row);

    chatBox.scrollTop =
        chatBox.scrollHeight;


    if (save) {

        saveChat(text, type);

    }

}


function formatText(text) {

    return text
        .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")
        .replace(/\n/g, "<br>");

}


