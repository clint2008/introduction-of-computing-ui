/* ==================================================
   HISTORY
================================================== */

function loadHistory(){

let list=
document.getElementById("historyList");


if(!list)
return;


list.innerHTML="";


if(conversations.length===0){

list.innerHTML=`

<div class="feature-card">

<p>
No conversations yet.
</p>

<button
class="btn btn-main"
onclick="startNewChat()">

Start New Chat

</button>

</div>

`;

return;

}


conversations.forEach(convo=>{

let div=
document.createElement("div");


div.className=
"history-item";


div.onclick=
()=>loadConversation(convo.id);


div.innerHTML=`

<div class="history-title">
${escapeHTML(convo.title)}
</div>

<div class="history-preview">
${escapeHTML(convo.preview)}
</div>

<div class="mt-2">

<small style="color:var(--muted)">

${new Date(convo.updated).toLocaleString()}

</small>

</div>

`;


list.appendChild(div);

});

}


/* ==================================================
   LOAD CONVERSATION
   IMAGE HISTORY FIX
================================================== */

function loadConversation(id){

let convo=
conversations.find(
c=>c.id===id
);


if(!convo)
return;


currentConversationId=id;


currentConversation=
[];


document.getElementById("chatMessages")
.innerHTML="";


convo.messages.forEach(message=>{

if(
message.type==="bot"
){

addBotMessageWithReaction(
message.text
);

}

/*
   If this message contains an image,
   display the actual saved image.
*/

else if(
message.image
){

addImageMessage(
message.image,
message.fileName || "uploaded image",
message.text &&
!message.text.startsWith("Image uploaded:")
? message.text
: ""
);

}

else{

addMessage(
message.text,
"user"
);

}

});


openPage("chatPage");

}


/* ==================================================
   SEARCH
================================================== */

function searchHistory(){

let input=
document.getElementById("searchInput");

let results=
document.getElementById("searchResults");


if(!input || !results)
return;


let query=
input.value.toLowerCase().trim();


results.innerHTML="";


let matches=
conversations.filter(c=>

c.title
.toLowerCase()
.includes(query)

||

c.preview
.toLowerCase()
.includes(query)

||

c.messages.some(m=>

m.text
.toLowerCase()
.includes(query)

)

);


if(matches.length===0){

results.innerHTML=`

<div class="feature-card">

<p>
No matching conversations found.
</p>

</div>

`;

return;

}


matches.forEach(convo=>{

let div=
document.createElement("div");


div.className=
"history-item";


div.onclick=
()=>loadConversation(convo.id);


div.innerHTML=`

<div class="history-title">

${escapeHTML(convo.title)}

</div>

<div class="history-preview">

${escapeHTML(convo.preview)}

</div>

`;


results.appendChild(div);

});

}


/* ==================================================
   SUPPORT TICKET
================================================== */

function submitTicket(){

let name=
document.getElementById("ticketName")
.value.trim();


let category=
document.getElementById("ticketCategory")
.value;


let problem=
document.getElementById("ticketProblem")
.value.trim();


if(!name || !problem){

showToast(
"Please complete the support form."
);

return;

}


let tickets=
JSON.parse(
localStorage.getItem("aiitbuddy_tickets")
) || [];


let ticketId=
"T-"+Date.now();


tickets.unshift({

id:ticketId,

name:name,

category:category,

problem:problem,

date:new Date().toISOString()

});


localStorage.setItem(
"aiitbuddy_tickets",
JSON.stringify(tickets)
);


document.getElementById("ticketProblem")
.value="";


document.getElementById("ticketResult")
.innerHTML=`

<div class="alert alert-success mt-3">

<strong>
Support request submitted!
</strong>

<br>

Ticket ID:
<strong>
${ticketId}
</strong>

<br>

Your concern has been recorded in this prototype.

</div>

`;

}


/* ==================================================
   CLEAR HISTORY
================================================== */

function clearHistory(){

if(
!confirm("Clear all saved chat history?")
)
return;


conversations=[];

localStorage.removeItem(
"aiitbuddy_conversations"
);


currentConversation=[];

currentConversationId=
Date.now().toString();


document.getElementById("chatMessages")
.innerHTML="";


loadHistory();


showToast(
"Chat history cleared."
);

}


