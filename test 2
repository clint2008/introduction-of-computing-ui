function detectLanguage(text) {

    const msg =
        text.toLowerCase();


    const bisayaWords = [
        "ako",
        "ikaw",
        "unsa",
        "ngano",
        "kanang",
        "kapoy",
        "kaayo",
        "dili",
        "wala",
        "naa",
        "gusto",
        "buhaton",
        "buhat",
        "pwede",
        "sige",
        "salamat",
        "tabang",
        "maka",
        "ko",
        "nako",
        "nimo",
        "imong",
        "murag",
        "gani",
        "lang",
        "man",
        "ba",
        "oi",
        "bitaw"
    ];


    const tagalogWords = [
        "ako",
        "ikaw",
        "ano",
        "bakit",
        "paano",
        "hindi",
        "wala",
        "may",
        "gusto",
        "salamat",
        "tulong",
        "pwede",
        "paano",
        "kailangan",
        "nakakapagod",
        "pagod",
        "saan",
        "bakit",
        "dapat"
    ];


    let bisayaCount = 0;
    let tagalogCount = 0;


    bisayaWords.forEach(function(word) {

        if (msg.includes(word)) {

            bisayaCount++;

        }

    });


    tagalogWords.forEach(function(word) {

        if (msg.includes(word)) {

            tagalogCount++;

        }

    });


    if (
        bisayaCount > 0 &&
        tagalogCount > 0
    ) {

        return "mixed";

    }


    if (bisayaCount > tagalogCount) {

        return "bisaya";

    }


    if (tagalogCount > bisayaCount) {

        return "tagalog";

    }


    return "english";

}


