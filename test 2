  return `Understood. Let's treat this as a priority. ⚠️

I'll keep the response focused and professional.

Please tell me the exact problem you're experiencing, including any error message you can safely share.

If this is an urgent school or university IT issue, you can also use the **Contact IT Support** section below to submit a support request.`;

}


/* =====================================================
   IMAGE PREVIEW
===================================================== */

function previewImage() {

  const input =
    document.getElementById("imageInput");

  const preview =
    document.getElementById("imagePreview");

  if (input.files && input.files[0]) {

    const reader =
      new FileReader();

    reader.onload =
      function(e) {

        preview.src =
          e.target.result;

        preview.style.display =
          "block";

        addMessage(
          "📸 I uploaded a screenshot/image related to my problem.",
          "user"
        );

        setTimeout(() => {

          addMessage(
            `I can see that you've uploaded an image. 👀

In this prototype, I can display the screenshot for you, but I don't have real image-analysis AI connected yet.

If you describe what you see in the screenshot, I can help you troubleshoot it.`,
            "bot"
          );

        }, 400);

      };

    reader.readAsDataURL(
      input.files[0]
    );

  }

}


