function getLastUserMessage(){

for(
let i=currentConversation.length-1;
i>=0;
i--
){

if(
currentConversation[i].type==="user"
)
return currentConversation[i].text;

}

return "";

}


/* ==================================================
   GENERATE RESPONSE
================================================== */

function generateResponse(text){

let language=
detectLanguage(text);

let itTopic=
detectITTopic(text);

let conversationTopic=
detectConversationTopic(text);

let lower=
text.toLowerCase();


if(
lower.includes("just want to rant") ||
lower.includes("i want to rant") ||
lower.includes("gusto ko mag-rant") ||
lower.includes("mag rant")
){

return rantResponse(language);

}


if(itTopic){

return itResponse(
itTopic,
language
);

}


if(conversationTopic){

return personalResponse(
conversationTopic,
language
);

}


let general=
generalResponse(
text,
language
);


if(general)
return general;


let previous=
getLastUserMessage();


if(previous){

let previousIT=
detectITTopic(previous);


if(
previousIT &&
(
lower.length<30 ||
lower.includes("yes") ||
lower.includes("mao") ||
lower.includes("school") ||
lower.includes("programming")
)
){

if(language==="bisaya")
return "Sige, padayon ta. Unsa exactly ang part sa problem nga gusto nimo i-focus?";

if(language==="tagalog")
return "Sige, ituloy natin. Anong specific na part ng problem ang gusto mong pag-focusan?";

return "Sure, let's continue. Which specific part of the problem do you want to focus on?";

}

}


if(language==="bisaya")
return "Sige, gets nako. 😊 Pwede nimo i-explain pa gamay unsay imong concern para mas makatabang ko.";

if(language==="tagalog")
return "Sige, gets ko. 😊 Puwede mo bang ipaliwanag nang kaunti pa kung ano ang concern mo para mas makatulong ako?";

if(language.startsWith("mixed"))
return "Gets nako. 😊 Tell me a little more about your concern para mas makatabang ko.";

return "I understand. 😊 Tell me a little more about your concern so I can give you a more useful response.";

}


/* ==================================================
   SEND MESSAGE
================================================== */

function sendMessage(){

let input=
document.getElementById("chatInput");

let text=
input.value.trim();


/*
   IMAGE SEND
*/

if(pendingImage){

let imageInfo={
data:pendingImage.data,
name:pendingImage.name
};


addImageMessage(
imageInfo.data,
imageInfo.name,
text
);


input.value="";

pendingImage=null;


document.getElementById("imagePreview")
.style.display="none";


document.getElementById("imageInput")
.value="";


saveConversation();


showTyping();


setTimeout(()=>{

hideTyping();


addBotMessageWithReaction(
"I received your image. 🖼️\n\n" +
"For this prototype, the image upload and display are working. " +
"The current version does not connect the image to a real AI vision model yet.\n\n" +
"If you describe what you want me to check in the image, I can still help based on your description."
);


saveConversation();

},900);


return;

}


/*
   NORMAL TEXT
*/

if(!text){

showToast("Type a message first.");

return;

}


addMessage(
text,
"user"
);


input.value="";


saveConversation();


showTyping();


setTimeout(()=>{

hideTyping();


let response=
generateResponse(text);


addBotMessageWithReaction(
response
);


saveConversation();

},700 + Math.random()*700);

}


