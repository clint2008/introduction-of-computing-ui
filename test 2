/* =========================================================
   MAIN RESPONSE ENGINE
========================================================= */

function generateResponse(text) {

    const language = detectLanguage(text);

    const questionType = detectQuestionType(text);

    const itTopic = detectITTopic(text);

    const conversationTopic = detectConversationTopic(text);

    lastLanguage = language;
    lastIntent = questionType;

    /*
       IT gets priority when the message clearly describes
       an IT problem.
    */

    if (itTopic) {

        lastTopic = itTopic;

        return itResponse(
            itTopic,
            language,
            text
        );
    }


    if (questionType === "greeting") {

        return greetingResponse(language);
    }


    if (questionType === "thanks") {

        return thanksResponse(language);
    }


    if (questionType === "rant") {

        lastTopic = "rant";

        return rantResponse(language);
    }


    /*
       Advice mode:
       don't force a solution immediately.
       First understand the situation.
    */

    if (questionType === "advice") {

        lastTopic = conversationTopic;

        if (language === "Bisaya") {

            return "Sige, tabangan tika. Pero para dili ko mag-assume, unsa gyud ang situation? I-share lang unsay nahitabo ug unsa imong gusto mahitabo.";
        }

        if (language === "Tagalog") {

            return "Sige, tutulungan kita. Pero ayokong mag-assume agad. Ano muna ang situation at ano ang gusto mong mangyari?";
        }

        return "Sure, I can help you think it through. Tell me what happened and what outcome you're hoping for, so I don't give you advice based on assumptions.";
    }


    /*
       Personal / school / casual conversation
    */

    lastTopic = conversationTopic;

    return conversationalResponse(
        text,
        language
    );
}


