                                <input
                                    type="email"
                                    id="studentEmail"
                                    class="form-control"
                                    placeholder="Enter your email"
                                    required
                                >

                            </div>


                            <!-- PROBLEM -->
                            <div class="mb-3">

                                <label class="form-label">
                                    Problem Type
                                </label>

                                <select
                                    id="problemType"
                                    class="form-select">

                                    <option>
                                        Internet / Wi-Fi
                                    </option>

                                    <option>
                                        Computer
                                    </option>

                                    <option>
                                        Software
                                    </option>

                                    <option>
                                        Printer
                                    </option>

